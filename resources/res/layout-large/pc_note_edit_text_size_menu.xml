<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="9dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/pc_note_pop_menu_bg"
            android:layout_width="136dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/pc_note_edit_textsize_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/size_normal"
                android:background="@drawable/pc_note_pop_menu_item_head_bg"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/pc_note_edit_text_format_body"
                android:paddingStart="24dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/pc_note_edit_textsize_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/size_h1"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pc_note_edit_text_format_title_level1"
                android:paddingStart="24dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/pc_note_edit_textsize_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/size_h2"
                android:background="@drawable/pc_note_pop_menu_item_foot_bg"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/pc_note_edit_text_format_title_level2"
                android:paddingStart="24dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

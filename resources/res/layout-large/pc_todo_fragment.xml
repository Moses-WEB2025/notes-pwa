<?xml version="1.0" encoding="utf-8"?>
<com.miui.pc.feature.todo.PcTodoListRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@drawable/pc_right_frame_bg"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/todo_search_result_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/pc_text_common_color"
                android:id="@+id/todo_search_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"/>
            <View
                android:background="#0d000000"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
        <TextView
            android:textSize="25dp"
            android:textColor="@color/pc_text_common_color"
            android:id="@+id/tv_category_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/todo_fast_create_group"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/todo_fast_create_bg"
                android:background="@drawable/pc_todo_editor_time_bg"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:paddingEnd="2dp"
                android:layout_alignParentStart="true">
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="16dp"
                    android:textColor="#000000"
                    android:textColorHint="#30000000"
                    android:id="@+id/todo_fast_editor"
                    android:background="@null"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/pc_todo_fast_create_hint"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/pc_todo_editor_cursor"
                    android:layout_marginStart="24dp"/>
                <ImageView
                    android:id="@+id/iv_remind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pc_ic_todo_edit_alert"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="28dp"/>
        <RelativeLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <miuix.nestedheader.widget.NestedHeaderLayout
                android:id="@+id/nhl_group"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:layout_alignParentStart="true"
                app:headerView="@+id/search_bar"
                app:rangeOffset="1dp"
                app:scrollableView="@+id/scrollable_view_drawer"
                app:triggerView="@+id/trigger_view">
                <View
                    android:id="@+id/trigger_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"/>
                <miuix.springback.view.SpringBackLayout
                    android:id="@+id/scrollable_view_drawer"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scrollOrientation="vertical"
                    app:scrollableView="@+id/recycler_view">
                    <com.miui.todo.base.ProTodoRecyclerView
                        android:id="@+id/recycler_view"
                        android:visibility="visible"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </miuix.springback.view.SpringBackLayout>
                <include
                    android:id="@+id/search_bar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    layout="@layout/miuix_appcompat_search_stub"/>
            </miuix.nestedheader.widget.NestedHeaderLayout>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/sv_blank"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:layout_gravity="center"
            android:id="@+id/blankview_container"
            android:layout_width="118dp"
            android:layout_height="118dp"
            layout="@layout/pc_blank_layout"/>
    </FrameLayout>
</com.miui.pc.feature.todo.PcTodoListRootLayout>

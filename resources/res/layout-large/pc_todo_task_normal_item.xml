<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_item_group"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.miui.todo.view.swipemenulayout.SwipeMenuLayout
        android:id="@+id/sl_item_group"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layerType="hardware"
        app:contentBg="@drawable/pc_todo_child_item_bg"
        app:contentViewId="@+id/item_content_root"
        app:defaultRadius="@dimen/pc_todo_item_bg_radius"
        app:rightViewId="@+id/right_view">
        <LinearLayout
            android:id="@+id/left_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="@dimen/todo_item_margin_start"
            android:layout_marginEnd="@dimen/todo_item_margin_start">
            <TextView
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:id="@+id/left_menu"
                android:background="@color/todo_item_menu_unfinish_color"
                android:visibility="gone"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:text="@string/todo_item_status_unfinished"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/right_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp"
            android:paddingStart="@dimen/todo_item_right_menu_padding"
            android:layout_marginStart="@dimen/todo_item_margin_start"
            android:layout_marginEnd="@dimen/todo_item_margin_start">
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/right_menu"
                android:background="@drawable/v12_todo_item_menu_delete_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/miuix_action_icon_delete_dark"
                android:scaleType="center"
                android:contentDescription="@string/menu_delete"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/item_content_root"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_content"
                android:background="@drawable/todo_child_item_bg_no_border"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginBottom="12dp"
                android:layerType="hardware">
                <View
                    android:id="@+id/v_bg"
                    android:background="@drawable/todo_child_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/placeholder"
                    android:layout_width="1dp"
                    android:layout_height="104dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <CheckBox
                    android:gravity="start|top"
                    android:id="@android:id/checkbox"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/content_group"
                    style="@style/Todo.Pc.CheckBox"/>
                <View
                    android:id="@+id/checkbox_mask"
                    android:layout_width="62dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/content_group"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/content_group"
                    android:paddingBottom="4dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="62dp"
                    android:layout_marginEnd="26dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/multi_checkbox"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.miui.common.view.StrikeTextView.StrikeTextView
                        android:textAppearance="@style/Todo.Pc.TextAppearance.List.Secondary"
                        android:textColor="@color/pc_todo_item_content_text_common_color"
                        android:ellipsize="end"
                        android:id="@+id/content"
                        android:paddingTop="1px"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ImageView
                            android:id="@+id/iv_clock"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_todo_item_clock_n"
                            android:layout_marginEnd="12dp"/>
                        <TextView
                            android:textAppearance="@style/Todo.Pc.TextAppearance.List.Tertiary"
                            android:gravity="start|center_vertical"
                            android:id="@+id/time"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4dp"
                            android:layout_marginEnd="12dp"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/iv_audio"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/pc_ic_item_audio"/>
                    </LinearLayout>
                </LinearLayout>
                <CheckBox
                    android:theme="@style/Note.MultiCheckBox"
                    android:layout_gravity="center"
                    android:id="@+id/multi_checkbox"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/iv_drag"
                    android:visibility="gone"
                    android:layout_width="@dimen/todo_item_drag_size"
                    android:layout_height="@dimen/todo_item_drag_size"
                    android:src="@drawable/pc_ic_todo_item_drag"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/content_group"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </com.miui.todo.view.swipemenulayout.SwipeMenuLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:layout_gravity="center"
        android:id="@+id/content"
        android:layout_width="416dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="13dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/pc_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/dialog_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:src="@drawable/pc_ic_doodle_lock"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/pc_text_common_color"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pc_note_edit_lock_dialog_doodle_by_phone"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@android:id/button2"
                android:background="@drawable/pc_todo_edit_btn_done_bg"
                android:nextFocusLeft="@+id/embedded_text_editor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="40dp"
                android:text="@string/dialog_button_cancel"
                android:contentDescription="@string/todo_edit_btn_done"
                android:layoutDirection="locale"
                android:layout_marginStart="76dp"
                android:layout_marginEnd="76dp"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

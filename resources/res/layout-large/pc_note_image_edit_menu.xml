<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="9dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/menu_view"
            android:background="@drawable/pc_note_pop_menu_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="180dp">
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/annotate_image"
                android:background="@drawable/pc_note_pop_menu_item_head_bg"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/image_annotation_edit_hint"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/edit_image"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/doodle_feature"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/scale_image"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/image_action_zoom_out"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@android:id/cut"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@android:string/cut"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@android:id/copy"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@android:string/copy"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/save_as"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/option_menu_save_as"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/delete"
                android:background="@drawable/pc_note_pop_menu_item_foot_bg"
                android:paddingBottom="18dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/menu_delete"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:layout_gravity="center"
        android:id="@+id/content"
        android:layout_width="416dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/pc_note_pop_menu_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20dp"
                android:textColor="@color/pc_text_common_color"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/todo_notify_alarm_title"/>
            <miuix.recyclerview.widget.RecyclerView
                android:id="@+id/rv_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@android:id/button2"
                android:background="@drawable/pc_todo_edit_btn_done_bg"
                android:nextFocusLeft="@+id/embedded_text_editor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="40dp"
                android:text="@string/todoalert_done"
                android:layoutDirection="locale"
                android:layout_marginStart="76dp"
                android:layout_marginEnd="76dp"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

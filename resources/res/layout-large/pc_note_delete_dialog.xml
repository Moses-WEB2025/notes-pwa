<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:layout_gravity="center"
        android:id="@+id/content"
        android:layout_width="416dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="13dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/pc_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20dp"
                android:textColor="@color/pc_text_common_color"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/alert_title_delete"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/pc_text_common_color"
                android:gravity="center"
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/alert_message_delete"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="40dp"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp">
                <Button
                    android:textSize="16dp"
                    android:textColor="@color/pc_text_common_color"
                    android:gravity="center"
                    android:id="@android:id/button2"
                    android:background="@drawable/pc_todo_edit_btn_cancel_bg"
                    android:nextFocusLeft="@+id/embedded_text_editor"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="@android:string/cancel"
                    android:layout_weight="1"
                    android:layoutDirection="locale"
                    android:layout_marginEnd="10dp"/>
                <Button
                    android:textSize="16dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@android:id/button1"
                    android:background="@drawable/pc_todo_edit_btn_done_bg"
                    android:nextFocusLeft="@+id/embedded_text_editor"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="@string/menu_delete"
                    android:layout_weight="1"
                    android:layoutDirection="locale"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

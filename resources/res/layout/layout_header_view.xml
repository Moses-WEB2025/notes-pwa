<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/creation_ll_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <miuix.androidbasewidget.widget.EditText
            android:textSize="@dimen/creation_title_edit_text_size"
            android:textColor="@color/creation_title_edit_text"
            android:textColorHint="@color/creation_title_edit_hint"
            android:ellipsize="end"
            android:id="@+id/creation_title"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/creation_header_view_margin_top"
            android:minHeight="@dimen/creation_title_edit_min_height"
            android:hint="@string/creation_note_title"
            android:maxLines="1"
            android:maxLength="100"
            android:inputType="text"
            android:textSelectHandleLeft="@drawable/text_select_handle_left_native"
            android:textSelectHandleRight="@drawable/text_select_handle_right_native"
            android:textSelectHandle="@drawable/text_select_handle_middle_native"
            android:textCursorDrawable="@drawable/miuix_appcompat_text_cursor_light"
            android:drawableStart="@drawable/creation_action_edit"
            android:fontFamily="MiSans"
            android:textAlignment="viewStart"
            android:paddingHorizontal="@dimen/creation_header_view_margin_left"
            android:textFontWeight="400"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/creation_title_edit_text_size"
            android:textColor="@color/creation_title_edit_time_color"
            android:id="@+id/creation_title_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/creation_header_view_margin_bottom"
            android:layout_below="@+id/creation_title"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/creation_header_view_icon_size"
            android:layout_alignStart="@+id/creation_title"
            android:paddingHorizontal="@dimen/creation_header_view_margin_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creation_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

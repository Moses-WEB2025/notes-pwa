<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/note_extra_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.helper.widget.Flow
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="date,time,text_count_divider,text_count         ,lock_divider,lock,alarm_divider,alarm"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="0dp"
        app:flow_horizontalStyle="packed"
        app:flow_verticalGap="0dp"
        app:flow_wrapMode="aligned"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/date"
        android:paddingBottom="1sp"
        style="@style/NoteInfoHeaderTextStyle"/>
    <TextView
        android:id="@+id/time"
        android:paddingBottom="1sp"
        style="@style/NoteInfoHeaderTextStyle"/>
    <ImageView
        android:id="@+id/text_count_divider"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintTop_toTopOf="@+id/time"
        style="@style/NoteInfoHeaderDividerStyle"/>
    <TextView
        android:id="@+id/text_count"
        android:paddingBottom="1sp"
        app:layout_constraintStart_toEndOf="@+id/text_count_divider"
        style="@style/NoteInfoHeaderTextStyle"/>
    <ImageView
        android:id="@+id/lock_divider"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintStart_toEndOf="@+id/text_count"
        app:layout_constraintTop_toTopOf="@+id/time"
        style="@style/NoteInfoHeaderDividerStyle"/>
    <ImageView
        android:id="@+id/lock"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_note_edit_info_lock"
        android:contentDescription="@string/edit_header_lock_description"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintStart_toEndOf="@+id/text_count"
        app:layout_constraintTop_toTopOf="@+id/time"/>
    <ImageView
        android:id="@+id/alarm_divider"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintStart_toEndOf="@+id/lock"
        app:layout_constraintTop_toTopOf="@+id/time"
        style="@style/NoteInfoHeaderDividerStyle"/>
    <TextView
        android:id="@+id/alarm"
        android:paddingBottom="1sp"
        android:visibility="gone"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/ic_note_edit_info_clock"
        app:layout_constraintStart_toEndOf="@+id/alarm_divider"
        app:layout_constraintTop_toTopOf="@+id/time"
        style="@style/NoteInfoHeaderTextStyle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="date,time,text_count_divider,text_count         ,lock_divider,lock,alarm_divider,alarm"/>
</androidx.constraintlayout.widget.ConstraintLayout>

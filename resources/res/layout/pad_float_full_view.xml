<?xml version="1.0" encoding="utf-8"?>
<miuix.smooth.SmoothFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_full_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/pad_global_window_margin_top"
    android:layout_marginBottom="@dimen/pad_global_window_margin_top"
    android:radius="@dimen/pad_global_window_bg_radius"
    android:layout_marginStart="@dimen/pad_global_window_margin_left">
    <com.miui.floatwindow.view.BlurFloatRootRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.miui.floatwindow.view.FwFullScrollView
            android:id="@+id/data_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/note_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/pad_note_float_full_view"/>
                <include
                    android:id="@+id/todo_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/pad_todo_float_full_view"/>
                <FrameLayout
                    android:id="@+id/rv_todo_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/float_todo_recycler_view_margin_top">
                    <com.miui.pad.feature.floatwindow.PadFwTodoRecyclerView
                        android:id="@+id/rv_todo"
                        android:paddingBottom="400dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </LinearLayout>
        </com.miui.floatwindow.view.FwFullScrollView>
        <include
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            layout="@layout/fw_toast_notification"/>
    </RelativeLayout>
</miuix.smooth.SmoothFrameLayout>

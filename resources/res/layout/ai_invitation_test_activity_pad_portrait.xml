<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/head_ll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ai_invitation_back_linear_height">
        <ImageView
            android:id="@+id/back_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ai_back_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ai_invitation_back_margin_left"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/log_iv"
        android:layout_width="@dimen/ai_invitation_icon_size"
        android:layout_height="@dimen/ai_invitation_icon_size"
        android:layout_marginTop="@dimen/ai_invitation_icon_margin_top_pad_portrait"
        android:src="@drawable/ai_invitation_log"
        android:scaleType="fitCenter"
        android:layout_below="@+id/head_ll"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/ai_invitation_text_title_size"
        android:textStyle="bold"
        android:textColor="@color/ai_invitation_title_text_color"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_invitation_title_icon_margin_top_pad_land"
        android:text="@string/ai_writing_invite_beta_testing_title"
        android:layout_below="@+id/log_iv"
        android:layout_centerHorizontal="true"
        style="@style/MisanDemiboldTextStyle"/>
    <TextView
        android:textSize="@dimen/ai_invitation_text_size"
        android:textColor="@color/ai_invitation_text_color"
        android:gravity="center"
        android:id="@+id/text_tv"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_invitation_text_title_margin_top_pad_land"
        android:text="@string/ai_writing_invite_beta_testing_content"
        android:layout_below="@+id/title_tv"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/ai_invitation_text_margin_horizontal"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/invitation_icon_container"
        android:layout_width="@dimen/ai_invitation_img_linear_width_pad"
        android:layout_height="@dimen/ai_invitation_img_linear_height_pad"
        android:layout_marginTop="@dimen/ai_invitation_img_margin_top_pad_land"
        android:layout_below="@+id/text_tv"
        android:layout_centerHorizontal="true">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ai_invitation_icon_pad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ai_invitation_button_margin_bottom_pad_portrait"
        android:minWidth="@dimen/ai_invitation_button_layout_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <Button
            android:textSize="@dimen/ai_invitation_button_size"
            android:textColor="@color/ai_invitation_disagree_text_color"
            android:layout_gravity="center"
            android:id="@+id/btn_reject"
            android:background="@drawable/ai_invitation_disagree_bt_bg"
            android:layout_width="@dimen/ai_invitation_button_width_pad"
            android:layout_height="@dimen/ai_invitation_button_height"
            android:text="@string/ai_invitation_text_disagree"
            android:layout_marginEnd="@dimen/ai_invitation_text_title_margin_top_pad"/>
        <Button
            android:textSize="@dimen/ai_invitation_button_size"
            android:textColor="@color/ai_invitation_agree_text_color"
            android:layout_gravity="center"
            android:id="@+id/btn_agress"
            android:background="@drawable/ai_invitation_agree_bt_bg"
            android:layout_width="@dimen/ai_invitation_button_width_pad"
            android:layout_height="@dimen/ai_invitation_button_height"
            android:text="@string/ai_invitation_text_agree"/>
    </LinearLayout>
</RelativeLayout>

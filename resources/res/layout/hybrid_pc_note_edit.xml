<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_pad"
    android:background="@drawable/pc_note_blankview_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/blank_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/pc_note_edit_blank_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sv_note_edit"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <include
            android:id="@+id/header"
            layout="@layout/pc_note_edit_header"/>
        <include
            android:id="@+id/reminder"
            android:visibility="gone"
            layout="@layout/pc_note_edit_trash_reminder"/>
        <com.miui.pc.view.PadEditRootLayout
            android:id="@+id/editor_container"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">
            <miuix.nestedheader.widget.NestedHeaderLayout
                android:id="@+id/nested_header_layout"
                android:background="@drawable/theme_pc_fg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scrollableView="@+id/content_container"
                app:triggerView="@+id/trigger_view">
                <View
                    android:id="@+id/trigger_view"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"/>
                <miuix.springback.view.SpringBackLayout
                    android:id="@+id/content_container"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scrollOrientation="vertical"
                    app:scrollableView="@+id/web_view">
                    <com.miui.hybirdeditor.RichEditorWebView
                        android:id="@+id/web_view"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </miuix.springback.view.SpringBackLayout>
            </miuix.nestedheader.widget.NestedHeaderLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/rich_editor_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/loading_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textColor="@color/edit_fragment_loading_color"
                    android:id="@+id/progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading_text"
                    android:layout_below="@+id/progress_bar"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </com.miui.pc.view.PadEditRootLayout>
    </LinearLayout>
</FrameLayout>

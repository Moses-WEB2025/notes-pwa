<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_content"
        android:background="@drawable/todo_child_item_bg_no_border"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/miuix_theme_margin_horizontal_common"
        android:minHeight="@dimen/todo_item_min_height"
        android:layerType="hardware"
        android:layout_marginStart="@dimen/miuix_theme_margin_horizontal_common"
        android:layout_marginEnd="@dimen/miuix_theme_margin_horizontal_common">
        <View
            android:id="@+id/v_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/placeholder"
            android:layout_width="1dp"
            android:layout_height="@dimen/todo_item_min_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <CheckBox
            android:theme="@style/NoteTheme.List"
            android:id="@android:id/checkbox"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Todo.CheckBox"/>
        <View
            android:id="@+id/checkbox_mask"
            android:layout_width="@dimen/todo_item_content_bg_margin_start"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/placeholder"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="16dp"/>
        <com.miui.common.view.StrikeTextView.StrikeTextView
            android:textAppearance="@style/Todo.TextAppearance.List.Secondary"
            android:textColor="@color/todo_item_content_text_common_color"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="4"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/label"
            app:layout_constraintEnd_toStartOf="@+id/multi_checkbox"
            app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="20dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/label"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintBottom_toTopOf="@+id/guide"
            app:layout_constraintEnd_toStartOf="@+id/multi_checkbox"
            app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toBottomOf="@+id/content"
            app:layout_goneMarginEnd="20dp">
            <TextView
                android:textAppearance="@style/Todo.TextAppearance.List.Tertiary"
                android:textSize="12sp"
                android:textColor="@color/action_bg_border_color"
                android:gravity="start|center_vertical"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="mipro-regular"/>
            <ImageView
                android:id="@+id/iv_clock"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_todo_item_clock_n"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_audio"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_data_item_audio"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <CheckBox
            android:theme="@style/Note.MultiCheckBox"
            android:layout_gravity="center"
            android:id="@+id/multi_checkbox"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/todo_item_multicheckbox_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_drag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_todo_item_drag"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/todo_drag_margin_start"
            app:layout_constraintBottom_toBottomOf="@+id/checkbox_mask"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/checkbox_mask"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>

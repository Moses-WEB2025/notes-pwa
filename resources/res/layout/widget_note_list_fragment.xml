<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/homepage_primary_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.nestedheader.widget.NestedHeaderLayout
        android:id="@+id/nested_header_layout"
        android:clipChildren="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:headerView="@+id/search_bar"
        app:rangeOffset="0px"
        app:scrollableView="@+id/scrollable_view_drawer">
        <com.miui.notes.ui.view.NoteSpringBackLayout
            android:id="@+id/scrollable_view_drawer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scrollOrientation="vertical"
            app:scrollableView="@+id/recycler_view">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/sv_blank"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/blankview_container"
                    layout="@layout/blank_layout"/>
            </androidx.core.widget.NestedScrollView>
            <com.miui.notes.ui.view.BaseNoteRecyclerView
                android:id="@+id/recycler_view"
                android:paddingTop="@dimen/data_list_padding_top"
                android:paddingBottom="58dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/common_single_column_recycler_horizontal_padding"
                android:paddingEnd="@dimen/common_single_column_recycler_horizontal_padding"/>
        </com.miui.notes.ui.view.NoteSpringBackLayout>
        <include
            android:id="@+id/search_bar"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/miuix_appcompat_search_stub"/>
    </miuix.nestedheader.widget.NestedHeaderLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/folder_name_group"
    android:background="@drawable/note_title_bg"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/note_dir_indicator_bg_height"
    android:layout_marginBottom="@dimen/notes_edit_header_margin_bottom"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/barrier">
    <ImageView
        android:id="@+id/folder_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_note_dir_indicator"
        android:layout_marginStart="@dimen/note_dir_indicator_content_margin_start"/>
    <TextView
        android:textSize="@dimen/secondary_text_size"
        android:textColor="@color/note_dir_indicator_text_color_default"
        android:ellipsize="end"
        android:id="@+id/folder_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unclassfied_folder_name"
        android:maxLines="1"
        android:fontFamily="mipro-medium"
        android:layout_marginStart="@dimen/note_dir_indicator_bg_margin"
        android:layout_marginEnd="@dimen/note_dir_indicator_content_margin_end"/>
</LinearLayout>

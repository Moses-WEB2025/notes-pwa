<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_note_edit"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <miuix.nestedheader.widget.NestedHeaderLayout
        android:id="@+id/nested_header_layout"
        android:clipChildren="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/toolbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scrollableView="@+id/sbl_editor"
        app:triggerContentMinHeight="22px"
        app:triggerView="@+id/note_folder_info">
        <include
            android:id="@+id/note_folder_info"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/note_dir_indicator_bg_height"
            android:layout_marginBottom="@dimen/notes_edit_header_margin_bottom"
            android:layout_marginStart="@dimen/note_edit_default_horizontal_padding"
            android:layout_marginEnd="@dimen/note_edit_default_horizontal_padding"
            layout="@layout/note_edit_folder_layout"/>
        <miuix.springback.view.SpringBackLayout
            android:id="@+id/sbl_editor"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            app:scrollOrientation="vertical"
            app:scrollableView="@+id/editor_scroll_view">
            <view
                android:scrollbarStyle="insideOverlay"
                android:gravity="center_horizontal"
                android:id="@+id/editor_scroll_view"
                android:focusable="true"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:isScrollContainer="true"
                android:importantForAccessibility="no"
                class="com.miui.richeditor.FullScreenRichEditScrollView">
                <FrameLayout
                    android:id="@+id/edit_content"
                    android:paddingBottom="120dp"
                    android:focusable="true"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_note_edit"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:textSize="@dimen/note_edit_title_font_size"
                            android:textColor="@color/editor_text"
                            android:textColorHint="@color/note_title_hint_color_default"
                            android:gravity="start|center_vertical"
                            android:id="@+id/note_title"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/note_edit_title_height"
                            android:inputType="textImeMultiLine"
                            android:textAlignment="textStart"
                            android:paddingStart="@dimen/note_editor_padding"
                            android:paddingEnd="@dimen/note_editor_padding"/>
                        <include
                            android:id="@+id/note_extra_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="28dp"
                            android:paddingStart="@dimen/note_editor_padding"
                            android:paddingEnd="@dimen/note_editor_padding"
                            layout="@layout/note_extra_info_layout"/>
                        <view
                            android:textAppearance="@style/TextAppearance.Editor"
                            android:textColorLink="@color/link_text"
                            android:gravity="start|top"
                            android:autoLink="all"
                            android:linksClickable="false"
                            android:id="@+id/rich_editor"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/note_edit_content_min_height"
                            android:singleLine="false"
                            android:inputType="textImeMultiLine"
                            android:imeOptions="flagNoFullscreen|actionDone"
                            android:textAlignment="textStart"
                            android:paddingStart="@dimen/note_editor_padding"
                            android:paddingEnd="@dimen/note_editor_padding"
                            class="com.miui.notes.editor.NoteRichEditor"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/guide_view_hover"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </view>
        </miuix.springback.view.SpringBackLayout>
    </miuix.nestedheader.widget.NestedHeaderLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rich_editor_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/toolbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/toolbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/edit_fragment_loading_color"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_text"
            android:layout_below="@+id/progress_bar"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nested_header_layout">
        <include layout="@layout/phone_lite_note_edit_tool_group"/>
        <View
            android:id="@+id/annotate_placeholder"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_annotation_panel_height"/>
    </FrameLayout>
    <ProgressBar
        android:id="@+id/frame_progress_bar"
        android:layout_width="1px"
        android:layout_height="1px"
        android:indeterminate="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

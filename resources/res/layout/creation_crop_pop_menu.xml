<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/creation_select_popupwindow_background"
    app:cardCornerRadius="@dimen/creation_actionmode_radius"
    app:cardElevation="@dimen/creation_actionmode_elevation"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:gravity="center"
            android:id="@+id/creation_crop_select_finish"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_crop_finish"
            android:maxLines="1"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:gravity="center"
            android:id="@+id/creation_crop_select_cancel"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_crop_cancel"
            android:maxLines="1"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

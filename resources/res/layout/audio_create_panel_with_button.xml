<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:recording_progress="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/audio_create_panel"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <View
        android:id="@+id/v_placeholder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/todo_edit_margin_top"/>
    <ScrollView
        android:theme="@style/NoteTheme.TodoEdit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/audio_create_panel_edit_margin_start"
        android:layout_marginEnd="@dimen/audio_create_panel_edit_margin_end">
        <EditText
            android:textSize="@dimen/text_font_size"
            android:textColor="@color/todo_item_content_text_common_color"
            android:textColorHint="@color/todo_item_content_text_hint_color"
            android:gravity="start"
            android:id="@+id/audio_content"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/todo_edit_audio_hint"
            android:minLines="2"
            android:singleLine="false"
            android:inputType="none"
            android:importantForAccessibility="no"/>
    </ScrollView>
    <com.miui.common.view.RecordingWaveView
        android:layout_gravity="center_horizontal"
        android:id="@+id/record_wave"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wave_max_height"
        android:layout_marginTop="@dimen/wave_margin_vertical"
        android:layout_marginBottom="@dimen/wave_margin_vertical"
        android:importantForAccessibility="no"
        recording_progress:defaultColor="@color/warn_color_red"
        recording_progress:indicatorColor="@color/theme_main_color"
        recording_progress:indicatorMaxHeight="@dimen/wave_max_height"
        recording_progress:indicatorNum="27"
        recording_progress:indicatorWidth="@dimen/wave_width"
        recording_progress:interval="@dimen/wave_interval"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/audio_wave"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="@dimen/todo_edit_margin_top"
        android:src="@drawable/audio_wave_anim_short"/>
    <TextView
        android:textSize="@dimen/audio_create_panel_tint_text_size"
        android:textColor="@color/todo_item_content_text_hint_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/audio_create_panel_tint_margin_bottom"
        android:importantForAccessibility="no"/>
    <Button
        android:textSize="@dimen/audio_panel_btn_text_size"
        android:textColor="@color/todo_audio_panel_btn_text_color"
        android:gravity="center"
        android:id="@+id/record"
        android:layout_width="match_parent"
        android:layout_height="@dimen/audio_panel_button_height"
        android:text="@string/done"
        android:layout_marginStart="@dimen/todo_item_view_margin_start"
        android:layout_marginEnd="@dimen/todo_item_view_margin_start"
        style="@style/NoteTheme.TodoAudioButton"/>
</LinearLayout>

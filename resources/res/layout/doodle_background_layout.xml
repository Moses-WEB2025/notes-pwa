<?xml version="1.0" encoding="utf-8"?>
<com.miui.support.cardview.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btn_pixel_eraser_container"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="10dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:minHeight="144dp">
            <FrameLayout
                android:id="@+id/fl_background_dot"
                android:background="@drawable/ic_background_selected"
                android:padding="1.45dp"
                android:layout_width="54dp"
                android:layout_height="76dp"
                android:contentDescription="@string/doodle_background_dot">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="54dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_background_dot"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@android:color/black"
                android:gravity="top|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/doodle_background_dot"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:minHeight="144dp"
            android:layout_marginStart="12dp">
            <FrameLayout
                android:id="@+id/fl_background_white"
                android:padding="1.5dp"
                android:layout_width="54dp"
                android:layout_height="76dp"
                android:contentDescription="@string/doodle_background_white">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="54dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_background_white"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@android:color/black"
                android:gravity="top|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/doodle_background_white"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </LinearLayout>
</com.miui.support.cardview.CardView>

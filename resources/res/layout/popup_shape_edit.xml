<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/creation_shape_edit_popupwindow_background"
    app:cardCornerRadius="@dimen/creation_actionmode_radius"
    app:cardElevation="@dimen/creation_actionmode_elevation"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/shape_edit_popup_padding_horizontal"
        android:paddingVertical="@dimen/shape_edit_popup_padding_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.miui.handwriting.common.view.popup.ShapeColorSelectView
            android:id="@+id/shape_edit_fill_color"
            android:layout_width="@dimen/shape_edit_popup_icon_width_height"
            android:layout_height="@dimen/shape_edit_popup_icon_width_height"
            android:contentDescription="@string/creation_tool_color_select"/>
        <com.miui.handwriting.common.view.popup.ShapeColorSelectView
            android:id="@+id/shape_edit_stroke_color"
            android:layout_width="@dimen/shape_edit_popup_icon_width_height"
            android:layout_height="@dimen/shape_edit_popup_icon_width_height"
            android:contentDescription="@string/creation_shape_edit_talkback"
            android:layout_marginStart="@dimen/shape_edit_popup_icon_margin_start"/>
        <ImageView
            android:background="@drawable/ic_shape_edit_divider"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginTop="3dp"
            android:layout_marginStart="@dimen/shape_edit_popup_icon_margin_start"/>
        <ImageView
            android:id="@+id/shape_edit_copy"
            android:background="@drawable/ic_shape_edit_copy"
            android:layout_width="@dimen/shape_edit_popup_icon_width_height"
            android:layout_height="@dimen/shape_edit_popup_icon_width_height"
            android:contentDescription="@string/creation_ppw_select_copy"
            android:layout_marginStart="@dimen/shape_edit_popup_icon_margin_start"/>
        <ImageView
            android:id="@+id/shape_edit_delete"
            android:background="@drawable/ic_shape_edit_delet"
            android:layout_width="@dimen/shape_edit_popup_icon_width_height"
            android:layout_height="@dimen/shape_edit_popup_icon_width_height"
            android:contentDescription="@string/creation_ppw_select_delete"
            android:layout_marginStart="@dimen/shape_edit_popup_icon_margin_start"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<com.miui.todo.feature.todolist.TodoListRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.nestedheader.widget.NestedHeaderLayout
        android:id="@+id/nhl_group"
        android:clipChildren="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:headerClose="true"
        app:headerView="@+id/search_bar"
        app:rangeOffset="1px"
        app:scrollableView="@+id/scrollable_view_linear_layout"
        app:triggerView="@+id/micloud_state_view">
        <include
            android:id="@+id/micloud_state_view"
            layout="@layout/miuix_appcompat_micloud_state_view"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scrollable_view_linear_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.miui.common.view.ShieldEventLayout
                android:orientation="horizontal"
                android:id="@+id/folder_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pad_folder_folder_layout_height"
                android:layout_marginBottom="@dimen/pad_folder_list_margin_bottom"
                android:layout_marginStart="@dimen/miuix_appcompat_search_mode_bg_padding"
                android:layout_marginEnd="@dimen/miuix_appcompat_search_mode_bg_padding">
                <com.miui.common.view.ShallowLayout
                    android:id="@+id/folder_tag_parent"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/pad_folder_list_height"
                    android:layout_marginTop="@dimen/pad_folder_list_content_margin_top"
                    android:layout_marginBottom="@dimen/pad_folder_list_content_margin_bottom"
                    android:layout_weight="1">
                    <miuix.recyclerview.widget.RecyclerView
                        android:id="@+id/folder_rv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.miui.common.view.ShallowLayout>
            </com.miui.common.view.ShieldEventLayout>
            <miuix.springback.view.SpringBackLayout
                android:id="@+id/scrollable_view_drawer"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scrollOrientation="vertical"
                app:scrollableView="@+id/recycler_view">
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/sv_blank"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include
                            android:id="@+id/blankview_container"
                            layout="@layout/blank_layout"/>
                    </FrameLayout>
                </androidx.core.widget.NestedScrollView>
                <com.miui.todo.view.TodoRecyclerView
                    android:id="@+id/recycler_view"
                    android:paddingTop="@dimen/data_list_padding_top"
                    android:visibility="visible"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </miuix.springback.view.SpringBackLayout>
        </LinearLayout>
        <include
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/miuix_appcompat_search_stub"/>
    </miuix.nestedheader.widget.NestedHeaderLayout>
    <com.miui.notes.ui.widget.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/content_add"
        android:visibility="gone"
        android:layout_width="@dimen/floating_action_button_size"
        android:layout_height="@dimen/floating_action_button_size"
        android:layout_marginBottom="@dimen/floating_action_bar_margin_bottom"
        android:src="@drawable/ic_content_add"
        android:contentDescription="@string/new_todo_create_talkback_des"
        android:alpha="0"
        android:layout_marginEnd="@dimen/floating_action_bar_margin_end"
        app:fabShadowEnabled="true"
        style="@style/Note.FloatingActionButton"/>
</com.miui.todo.feature.todolist.TodoListRootLayout>

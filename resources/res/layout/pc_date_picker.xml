<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/pc_window_shadow_bg"
        android:layout_width="394dp"
        android:layout_height="wrap_content">
        <com.miui.support.cardview.CardView
            android:layout_width="354dp"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_centerInParent="true"
            android:hardwareAccelerated="true"
            app:cardBackgroundColor="#ffffff"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <RelativeLayout
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/display_picked_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18dp"
                        android:textColor="#e6000000"
                        android:id="@+id/set_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_date_time_picker_set_date"
                        android:layout_weight="1"
                        android:layout_alignParentStart="true"/>
                    <RelativeLayout
                        android:background="@drawable/display_date_background"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <ImageView
                            android:id="@+id/date_picker_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_date_picker"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#66000000"
                            android:id="@+id/selected_date_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="5dp"
                            android:layout_toEndOf="@+id/date_picker_icon"/>
                    </RelativeLayout>
                </LinearLayout>
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/month_picker"
                    android:background="@drawable/display_date_background"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_below="@+id/display_picked_date"
                    android:paddingStart="20dp"
                    android:paddingEnd="10dp">
                    <TextView
                        android:textSize="18dp"
                        android:textColor="#99000000"
                        android:id="@+id/current_month_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:id="@+id/next_month_arrow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/pc_clickable_month_right_arrow"
                        android:layout_alignParentEnd="true"/>
                    <ImageView
                        android:id="@+id/front_month_arrow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/pc_clickable_month_left_arrow"
                        android:layout_toStartOf="@+id/next_month_arrow"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/date_grid_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_below="@+id/month_picker"/>
                <View
                    android:id="@+id/line"
                    android:background="#e0e0e0"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="28dp"
                    android:layout_below="@+id/date_grid_picker"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/set_time_region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/line">
                    <TextView
                        android:textSize="18dp"
                        android:textColor="#e6000000"
                        android:id="@+id/set_time_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_date_time_picker_set_time"
                        android:layout_weight="1"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/set_time"
                        android:background="@drawable/display_date_background"
                        android:layout_width="132dp"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@+id/set_time_title"
                        android:paddingVertical="12dp">
                        <EditText
                            android:textSize="16dp"
                            android:textColor="#66000000"
                            android:id="@+id/set_time_hour"
                            android:background="@null"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:maxLength="2"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:textCursorDrawable="@drawable/text_cursor_for_webview"
                            android:textAlignment="textEnd"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#66000000"
                            android:id="@+id/time_separator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textAlignment="textEnd"/>
                        <EditText
                            android:textSize="16dp"
                            android:textColor="#66000000"
                            android:id="@+id/set_time_min"
                            android:background="@null"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="30"
                            android:maxLength="2"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:textCursorDrawable="@drawable/text_cursor_for_webview"
                            android:textAlignment="textStart"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/set_reminder_region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_below="@+id/set_time_region">
                    <TextView
                        android:textSize="18dp"
                        android:textColor="#e6000000"
                        android:id="@+id/set_reminder_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/repeat_mode_set_title"
                        android:layout_weight="1"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@+id/set_reminder"
                        android:background="@drawable/display_date_background"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="132dp"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@+id/set_reminder_region"
                        android:paddingStart="22dp"
                        android:paddingEnd="12dp">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="#66000000"
                            android:id="@+id/reminder_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/repeat_mode_default"
                            android:layout_weight="1"/>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_reminder_selector"
                            android:layout_alignParentEnd="true"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_below="@+id/set_reminder_region">
                    <Button
                        android:textSize="16dp"
                        android:textColor="@color/pc_text_common_color"
                        android:id="@+id/cancel_button"
                        android:background="@drawable/cancel_button_background"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:text="@string/dialog_button_cancel"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="16dp"
                        android:textColor="@color/pc_text_common_color"
                        android:id="@+id/submit_button"
                        android:background="@drawable/submit_button_background"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:text="@string/dialog_button_confirm"
                        android:layout_weight="1"
                        android:layout_marginStart="34dp"/>
                </LinearLayout>
            </RelativeLayout>
        </com.miui.support.cardview.CardView>
    </RelativeLayout>
</LinearLayout>

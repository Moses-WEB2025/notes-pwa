<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/todo_fw_item_margin_top"
        android:layout_marginBottom="@dimen/todo_fw_item_margin_bottom"
        android:minHeight="@dimen/todo_fw_item_min_height"
        android:layerType="hardware"
        android:layout_marginStart="@dimen/todo_fw_item_margin_start"
        android:layout_marginEnd="@dimen/todo_fw_item_margin_start">
        <View
            android:id="@+id/placeholder"
            android:layout_width="1dp"
            android:layout_height="@dimen/todo_fw_item_min_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <CheckBox
            android:theme="@style/NoteTheme.List"
            android:id="@android:id/checkbox"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Todo.CheckBox"/>
        <View
            android:id="@+id/checkbox_mask"
            android:layout_width="@dimen/todo_item_content_bg_margin_start"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.miui.common.view.StrikeTextView.StrikeTextView
            android:textAppearance="@style/Todo.TextAppearance.List.Secondary"
            android:textColor="@color/todo_fw_item_content_text_common_color"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toTopOf="@+id/label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/label"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toBottomOf="@+id/content">
            <TextView
                android:textAppearance="@style/Todo.TextAppearance.List.Tertiary"
                android:textSize="12sp"
                android:textColor="@color/action_bg_border_color"
                android:gravity="start|center_vertical"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/iv_clock"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_todo_item_clock_n"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_audio"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_data_item_audio"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>

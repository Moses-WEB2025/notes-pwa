<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/creation_select_popupwindow_background"
    app:cardCornerRadius="@dimen/creation_actionmode_radius"
    app:cardElevation="@dimen/creation_actionmode_elevation"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ai_creation_select"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_svg_ai_create_recreate"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/creation_ai_recreate"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ai_creation_select_jubu"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_svg_ai_create_part_recreate"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_re_draw"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.miui.handwriting.common.view.colorpicker.BlurBackGroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_root"
        app:layout_constraintEnd_toEndOf="@+id/ll_root"
        app:layout_constraintStart_toStartOf="@+id/ll_root"
        app:layout_constraintTop_toTopOf="@+id/ll_root"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_root"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        android:layout_width="@dimen/creation_pen_set_popup_window_width"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/creation_pen_set_margin_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_pen_review"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creation_pen_set_preview_image_height"
            android:scaleType="centerCrop"/>
        <ScrollView
            android:id="@+id/sl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_pen_thickness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_pen_set_top">
                    <TextView
                        android:id="@+id/tv_pen_thickness"
                        android:text="@string/creation_pen_thickness"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <TextView
                        android:id="@+id/tv_pen_thickness_num"
                        android:text="100"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <com.miui.handwriting.common.view.popup.SelectPropertyView
                        android:id="@+id/seekbar_pen_thickness"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                        android:thumb="@drawable/color_picker_thumb"
                        android:contentDescription="@string/creation_pen_thickness"
                        android:splitTrack="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_pen_thickness"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_pen_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_pen_set_top">
                    <TextView
                        android:id="@+id/tv_pen_sensitivity"
                        android:text="@string/creation_pen_sensitivity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <TextView
                        android:id="@+id/tv_pen_sensitivity_num"
                        android:text="100"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <com.miui.handwriting.common.view.popup.SelectPropertyView
                        android:id="@+id/seekbar_pen_sensitivity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                        android:thumb="@drawable/color_picker_thumb"
                        android:contentDescription="@string/creation_pen_sensitivity"
                        android:splitTrack="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_pen_sensitivity"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_pen_tip_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_pen_set_image_top">
                    <TextView
                        android:id="@+id/tv_pen_tip_size"
                        android:text="@string/creation_pen_tip_size"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <TextView
                        android:id="@+id/tv_pen_tip_size_num"
                        android:text="100"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <com.miui.handwriting.common.view.popup.SelectPropertyView
                        android:id="@+id/seekbar_pen_tip_size"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                        android:thumb="@drawable/color_picker_thumb"
                        android:contentDescription="@string/creation_pen_tip_size"
                        android:splitTrack="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_pen_tip_size"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_pen_text_transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_pen_set_top">
                    <TextView
                        android:id="@+id/tv_pen_text_transparent"
                        android:text="@string/creation_pen_text_transparent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <TextView
                        android:id="@+id/tv_pen_text_transparent_num"
                        android:text="100"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/creation_pen_set"/>
                    <com.miui.handwriting.common.view.popup.SelectAlphaView
                        android:id="@+id/seekbar_pen_text_transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                        android:thumb="@drawable/color_picker_thumb"
                        android:contentDescription="@string/creation_pen_text_transparent"
                        android:splitTrack="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_pen_text_transparent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

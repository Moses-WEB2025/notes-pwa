<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:orientation="vertical"
    android:id="@+id/editor_container"
    android:addStatesFromChildren="true"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <com.miui.todo.feature.todoedit.TodoEditTitleContainerView
        android:id="@+id/todo_editor_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/todo_fw_edit_margin_bottom">
        <RelativeLayout
            android:id="@+id/normal_todo_check_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/editor_scroll_view"
            android:layout_alignBottom="@+id/editor_scroll_view"
            android:importantForAccessibility="no"
            android:layout_marginEnd="8dp"
            android:layout_alignParentStart="true">
            <CheckBox
                android:theme="@style/NoteTheme.List"
                android:id="@+id/cb_subtodo"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                style="@style/Todo.CheckBox"/>
        </RelativeLayout>
        <view
            android:theme="@style/NoteTheme.TodoEdit"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/editor_scroll_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@+id/normal_todo_check_group"
            class="com.miui.richeditor.RichEditScrollView">
            <view
                android:theme="@style/NoteTheme.TodoEdit"
                android:textSize="@dimen/text_default_size"
                android:textColor="@color/todo_item_content_text_common_color"
                android:textColorHint="@color/hint_todo_edit_text_color"
                android:gravity="top"
                android:autoLink="all"
                android:linksClickable="false"
                android:id="@+id/rich_editor"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:lineSpacingExtra="4dp"
                android:inputType="textImeMultiLine"
                android:imeOptions="flagNoFullscreen|actionDone"
                android:textCursorDrawable="@drawable/todo_editor_cursor"
                class="com.miui.todo.feature.todoedit.TodoRichEditor"/>
        </view>
    </com.miui.todo.feature.todoedit.TodoEditTitleContainerView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_subtodo"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/trash_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/miuix_theme_margin_base"
    android:layout_marginStart="@dimen/miuix_theme_margin_horizontal_common"
    android:layout_marginEnd="@dimen/miuix_theme_margin_horizontal_common">
    <TextView
        android:textSize="@dimen/pad_folder_dialog_trash_head_tip_textsize"
        android:textColor="@color/pad_folder_dialog_trash_head_tip_textcolor"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/pad_folder_dialog_trash_remind"
        android:background="@drawable/folder_dialog_trash_page_head_bg_shape"
        android:paddingTop="@dimen/pad_folder_dialog_trash_page_item_padding_vertical"
        android:paddingBottom="@dimen/pad_folder_dialog_trash_page_item_padding_vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/pad_folder_dialog_trash_page_item_spacing"
        android:text=""
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:textDirection="locale"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/pad_folder_dialog_trash_page_item_padding_horizontal"
        android:paddingEnd="@dimen/pad_folder_dialog_trash_page_item_padding_horizontal"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <miuix.springback.view.SpringBackLayout
            android:id="@+id/scrollable_view_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scrollOrientation="vertical"
            app:scrollableView="@+id/pad_folder_dialog_trash_rv">
            <com.miui.notes.ui.view.BaseNoteRecyclerView
                android:id="@+id/pad_folder_dialog_trash_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"/>
        </miuix.springback.view.SpringBackLayout>
        <miuix.miuixbasewidget.widget.EmptyStateView
            android:icon="@drawable/note_blank_icon"
            android:layout_gravity="center"
            android:id="@+id/trash_blank_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:title="@string/data_empty_note"/>
    </FrameLayout>
</LinearLayout>

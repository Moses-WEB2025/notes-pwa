<?xml version="1.0" encoding="utf-8"?>
<com.miui.doodle.feature.tools.ToolPanelFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tool_panel_height">
    <miuix.springback.view.SpringBackLayout
        android:id="@+id/brush_panel_container"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tool_panel_height"
        app:scrollOrientation="horizontal"
        app:scrollableView="@+id/tool_panel_group">
        <HorizontalScrollView
            android:id="@+id/tool_panel_group"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/brush_pencil"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <ImageView
                    android:id="@+id/brush_watercolor"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/brush_watercolor_margin_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/brush_pencil"/>
                <ImageView
                    android:id="@+id/brush_markpen"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/brush_markpen_margin_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/brush_watercolor"/>
                <ImageView
                    android:id="@+id/brush_normal"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/brush_normal_margin_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/brush_markpen"/>
                <ImageView
                    android:id="@+id/brush_eraser"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/brush_eraser_margin_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/brush_normal"/>
                <ImageView
                    android:id="@+id/tool_picture"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/brush_ruler_margin_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/brush_eraser"/>
                <ImageView
                    android:id="@+id/tool_text"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/tool_text_margin_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tool_picture"/>
                <ImageView
                    android:id="@+id/tool_background"
                    android:layout_width="@dimen/tool_item_width"
                    android:layout_height="@dimen/tool_item_height"
                    android:translationY="@dimen/tool_select_tran_y"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/tool_background_margin_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tool_text"/>
                <View
                    android:id="@+id/brush_pencil_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_brush_pencil"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/brush_watercolor"
                    app:layout_constraintStart_toStartOf="@+id/brush_pencil"
                    app:layout_constraintTop_toTopOf="@+id/brush_pencil"/>
                <View
                    android:id="@+id/brush_watercolor_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_brush_watercolor"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/brush_markpen"
                    app:layout_constraintStart_toStartOf="@+id/brush_watercolor"
                    app:layout_constraintTop_toTopOf="@+id/brush_watercolor"/>
                <View
                    android:id="@+id/brush_markpen_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_brush_markpen"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/brush_normal"
                    app:layout_constraintStart_toStartOf="@+id/brush_markpen"
                    app:layout_constraintTop_toTopOf="@+id/brush_markpen"/>
                <View
                    android:id="@+id/brush_normal_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_brush_pen"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/brush_eraser"
                    app:layout_constraintStart_toStartOf="@+id/brush_normal"
                    app:layout_constraintTop_toTopOf="@+id/brush_normal"/>
                <View
                    android:id="@+id/brush_eraser_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_tool_eraser"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tool_picture"
                    app:layout_constraintStart_toStartOf="@+id/brush_eraser"
                    app:layout_constraintTop_toTopOf="@+id/brush_eraser"/>
                <View
                    android:id="@+id/tool_picture_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_tool_picture"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tool_text"
                    app:layout_constraintStart_toStartOf="@+id/tool_picture"
                    app:layout_constraintTop_toTopOf="@+id/tool_picture"/>
                <View
                    android:id="@+id/tool_text_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_tool_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tool_background"
                    app:layout_constraintStart_toStartOf="@+id/tool_text"
                    app:layout_constraintTop_toTopOf="@+id/tool_text"/>
                <View
                    android:id="@+id/tool_background_touch"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/doodle_tool_background"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/tool_background"
                    app:layout_constraintStart_toStartOf="@+id/tool_background"
                    app:layout_constraintTop_toTopOf="@+id/tool_background"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </HorizontalScrollView>
    </miuix.springback.view.SpringBackLayout>
</com.miui.doodle.feature.tools.ToolPanelFrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/note_group"
    android:background="#ffffff"
    android:paddingTop="24dp"
    android:paddingBottom="19dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.miui.pc.component.PcMindThumbnailView
                android:orientation="vertical"
                android:id="@+id/mind_thumbnail"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <CheckBox
                    android:id="@android:id/checkbox"
                    android:focusable="false"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="@dimen/pc_note_list_checkbox_size"
                    android:layout_height="@dimen/pc_note_list_checkbox_size"
                    android:layout_marginEnd="12dp"
                    style="@style/Note.Pc.MultiCheckBox"/>
                <TextView
                    android:textAppearance="@style/V8.PC.TextAppearance.List.Tertiary"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"/>
                <ImageView
                    android:id="@+id/stick"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/pc_ic_item_stick"
                    android:scaleType="center"
                    android:layout_marginEnd="4dp"/>
                <ImageView
                    android:id="@+id/voice"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/pc_ic_item_audio"
                    android:scaleType="center"
                    android:layout_marginEnd="4dp"/>
                <ImageView
                    android:id="@+id/mind_map"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/pc_ic_item_mind"
                    android:scaleType="center"
                    android:layout_marginEnd="3.67dp"/>
                <ImageView
                    android:id="@+id/mind_outline"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/pc_ic_item_overview"
                    android:scaleType="center"
                    android:layout_marginEnd="3.67dp"/>
                <ImageView
                    android:id="@+id/hand_write_icon"
                    android:visibility="gone"
                    android:layout_width="16px"
                    android:layout_height="16px"
                    android:src="@drawable/pc_ic_item_hand_write"
                    android:scaleType="center"
                    android:layout_marginEnd="5dp"/>
                <ImageView
                    android:id="@+id/alarm"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_data_item_clock"
                    android:scaleType="center"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/image_vh"
            android:visibility="gone"
            android:layout_width="@dimen/v8_list_item_thumbnail_size"
            android:layout_height="@dimen/v8_list_item_thumbnail_size"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="@dimen/list_item_image_margin_end"/>
    </LinearLayout>
    <com.miui.notes.ui.widget.RoundImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        app:border="1dp"
        app:borderColor="#0d000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="8dp"/>
    <View
        android:id="@+id/cover_frame"
        android:background="@drawable/v12_note_grid_cover_frame"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/cover_frame_mask"
        android:background="@drawable/note_sample_bottom_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

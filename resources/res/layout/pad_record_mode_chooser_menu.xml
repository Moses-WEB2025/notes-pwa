<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/dialog_root_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/pad_pop_menu_bg_color"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/pad_note_pop_menu_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/pad_audio_mode_menu_min_width">
            <TextView
                android:enabled="true"
                android:textSize="@dimen/pop_menu_item_text_size"
                android:textColor="@color/pad_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/mode_single"
                android:background="@drawable/pad_note_pop_menu_item_head_bg"
                android:paddingTop="@dimen/pad_audio_mode_menu_item_head_padding_top"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pad_audio_mode_menu_item_height_head_and_tail"
                android:text="@string/audio_btn_mode_single"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/pad_audio_mode_menu_item_padding"
                android:paddingEnd="@dimen/pad_audio_mode_menu_item_padding"/>
            <TextView
                android:enabled="true"
                android:textSize="@dimen/pop_menu_item_text_size"
                android:textColor="@color/pad_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/mode_meeting"
                android:background="@drawable/pad_note_pop_menu_item_foot_bg"
                android:paddingBottom="@dimen/pad_audio_mode_menu_item_tail_padding_bottom"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pad_audio_mode_menu_item_height_head_and_tail"
                android:text="@string/audio_btn_mode_meeting"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/pad_audio_mode_menu_item_padding"
                android:paddingEnd="@dimen/pad_audio_mode_menu_item_padding"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

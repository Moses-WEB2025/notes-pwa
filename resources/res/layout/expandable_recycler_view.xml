<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/expandable_root_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/expand_header_view"
            android:layout_width="match_parent"
            android:layout_height="40px">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/header_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pc_icon_note"/>
            <TextView
                android:textAppearance="@style/V12.PC.TextAppearance.List.Primary"
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="12px"/>
            <ImageView
                android:id="@+id/expand_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pc_ic_expand_arrow"
                android:layout_marginEnd="20px"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.miui.pc.view.MaxHeightRecyclerView
                android:scrollbarSize="12px"
                android:scrollbarThumbVertical="@drawable/pc_scroll_bar_background"
                android:id="@+id/expand_list_view"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:maxHeight="300px"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

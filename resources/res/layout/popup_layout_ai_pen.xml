<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.miui.handwriting.common.view.colorpicker.BlurBackGroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_root"
        app:layout_constraintEnd_toEndOf="@+id/ll_root"
        app:layout_constraintStart_toStartOf="@+id/ll_root"
        app:layout_constraintTop_toTopOf="@+id/ll_root"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="@dimen/creation_pen_set_popup_window_width"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/creation_pen_set_margin_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <miuix.miuixbasewidget.widget.FilterSortView
            android:id="@+id/filterSortView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:layout_marginVertical="8dp"
            app:filterSortTabViewCoverBg="@drawable/bg_eraser_item"
            app:filterSortViewBackground="@null"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/system_permission_main_purpose_text"
            android:textColor="@color/system_permission_purpose"
            android:id="@+id/main_purpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"
            android:layout_marginEnd="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"/>
        <TextView
            android:textSize="@dimen/system_permission_privacy_text"
            android:textColor="@color/system_permission_desc"
            android:id="@+id/privacy_declare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/system_permission_top_padding_size"
            android:lineSpacingExtra="@dimen/system_permission_secondary_line_space"
            android:layout_marginStart="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"
            android:layout_marginEnd="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"/>
        <TextView
            android:textSize="@dimen/system_permission_privacy_text"
            android:textColor="@color/system_permission_desc"
            android:id="@+id/no_say_no"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/system_permission_top_padding_size"
            android:layout_marginStart="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"
            android:layout_marginEnd="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"/>
        <TextView
            android:textSize="@dimen/system_permission_privacy_text"
            android:textColor="@color/system_permission_desc"
            android:id="@+id/revoke_path"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/system_permission_top_padding_size"
            android:lineSpacingExtra="@dimen/system_permission_secondary_line_space"
            android:layout_marginStart="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"
            android:layout_marginEnd="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"/>
        <TextView
            android:textSize="@dimen/system_permission_main_purpose_text"
            android:textColor="@color/system_permission_purpose"
            android:id="@+id/double_link"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/system_permission_top_padding_size"
            android:lineSpacingExtra="@dimen/system_permission_secondary_line_space"
            android:layout_marginStart="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"
            android:layout_marginEnd="@dimen/miuix_appcompat_dialog_button_panel_horizontal_margin"/>
    </LinearLayout>
</ScrollView>

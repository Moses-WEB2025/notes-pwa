<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:id="@+id/creation_tool_panel_group"
        android:scrollbars="none"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="0dp"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/creation_brush_head_height"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="0dp">
        <LinearLayout
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/creation_brush_select"
                android:visibility="gone"
                android:contentDescription="@string/creation_tool_brush"
                style="@style/Creation_BrushView_Thin"/>
            <ImageView
                android:id="@+id/creation_brush_ballpoint"
                android:contentDescription="@string/creation_tool_ballpoint"
                android:layout_marginStart="@dimen/creation_brush_margin_start"
                style="@style/Creation_BrushView_Thin"/>
            <ImageView
                android:id="@+id/creation_brush_pencil"
                android:contentDescription="@string/creation_tool_pencil"
                android:layout_marginStart="@dimen/creation_brush_pencil_margin_start"
                style="@style/Creation_BrushView_Thin"/>
            <ImageView
                android:id="@+id/creation_brush_ink"
                android:contentDescription="@string/creation_tool_ink"
                android:layout_marginStart="@dimen/creation_brush_ink_margin_start"
                style="@style/Creation_BrushView_Thin"/>
            <ImageView
                android:id="@+id/creation_brush_markpen"
                android:contentDescription="@string/creation_tool_mark"
                android:layout_marginStart="@dimen/creation_brush_markpen_margin_start"
                style="@style/Creation_BrushView_Fat"/>
            <ImageView
                android:id="@+id/creation_brush_watercolor"
                android:contentDescription="@string/creation_tool_watercolor"
                android:layout_marginStart="@dimen/creation_brush_watercolor_margin_start"
                style="@style/Creation_BrushView_Thin"/>
            <ImageView
                android:id="@+id/creation_brush_ai"
                android:contentDescription="@string/creation_tool_ai_pen"
                android:layout_marginStart="@dimen/creation_brush_separate_margin_mid"
                style="@style/Creation_BrushView_Thin"/>
            <ImageView
                android:id="@+id/creation_brush_rect_select"
                android:contentDescription="@string/creation_tool_rect_select"
                android:layout_marginStart="@dimen/creation_brush_select_margin_start"
                style="@style/Creation_BrushView_Thin"/>
            <ImageView
                android:id="@+id/creation_brush_eraser"
                android:contentDescription="@string/creation_tool_eraser"
                android:layout_marginStart="@dimen/creation_brush_eraser_margin_start"
                style="@style/Creation_BrushView_Fat"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/creation_brush_ruler"
                android:contentDescription="@string/creation_tool_ruler"
                android:layout_marginStart="@dimen/creation_brush_ruler_margin_start"
                style="@style/Creation_BrushView_Fat"/>
            <LinearLayout
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/creation_tool_color_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.miui.handwriting.common.view.colorpicker.ColorSelectView
                    android:id="@+id/creation_brush_color_default"
                    android:visibility="gone"
                    android:contentDescription="@string/creation_tool_color_select"
                    android:layout_marginStart="@dimen/creation_brush_left_color_margin_start"
                    android:layout_marginEnd="@dimen/creation_brush_color_margin_start"
                    style="@style/Creation_ColorSelectView"/>
                <com.miui.handwriting.common.view.colorpicker.ColorSelectView
                    android:id="@+id/creation_brush_color_default_left"
                    android:layout_marginStart="@dimen/creation_brush_left_color_margin_start"
                    style="@style/Creation_ColorSelectView"/>
                <com.miui.handwriting.common.view.colorpicker.ColorSelectView
                    android:id="@+id/creation_brush_color_default_center"
                    android:layout_marginStart="@dimen/creation_brush_color_margin_start"
                    style="@style/Creation_ColorSelectView"/>
                <com.miui.handwriting.common.view.colorpicker.ColorSelectView
                    android:id="@+id/creation_brush_color_default_right"
                    android:layout_marginStart="@dimen/creation_brush_color_margin_start"
                    style="@style/Creation_ColorSelectView"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>

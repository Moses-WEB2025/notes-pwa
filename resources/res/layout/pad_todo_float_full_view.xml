<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todo_full_view"
    android:paddingTop="@dimen/float_todo_title_layout_padding_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/module_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp">
        <ImageView
            android:id="@+id/iv_data_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pad_fw_create_btn"
            android:scaleType="centerCrop"
            android:contentDescription="@string/todo_menu_add_description"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todo_module_name"
            android:layout_marginStart="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/head_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <miuix.miuixbasewidget.widget.EmptyStateView
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/blankview_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/float_data_blank_view_height"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/module_head"
        android:title="@string/data_empty_todo"/>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        layout="@layout/audio_create_float_group"/>
</RelativeLayout>

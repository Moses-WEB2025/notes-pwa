<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_root_view"
    android:background="@color/pad_homepage_note_list_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.nestedheader.widget.NestedHeaderLayout
        android:id="@+id/nhl_group"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:headerView="@+id/search_bar"
        app:rangeOffset="1px"
        app:scrollableView="@+id/scrollable_view_drawer"
        app:triggerView="@+id/micloud_state_view">
        <include
            android:id="@+id/micloud_state_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/miuix_appcompat_micloud_state_view"/>
        <miuix.springback.view.SpringBackLayout
            android:id="@+id/scrollable_view_drawer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scrollOrientation="vertical"
            app:scrollableView="@+id/todo_category_list">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/sv_blank"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="175dp">
                    <include
                        android:id="@+id/blankview_container"
                        layout="@layout/blank_layout"/>
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>
            <miuix.recyclerview.widget.RecyclerView
                android:id="@+id/todo_category_list"
                android:paddingBottom="58dp"
                android:visibility="visible"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </miuix.springback.view.SpringBackLayout>
        <include
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/miuix_appcompat_search_stub"/>
    </miuix.nestedheader.widget.NestedHeaderLayout>
</FrameLayout>

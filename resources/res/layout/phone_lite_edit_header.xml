<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/home"
        android:src="@drawable/ic_action_back"
        android:contentDescription="@string/actionbar_home_description"
        style="@style/ActionBarIconStyle"/>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/v12_notes_edit_header_ic_size"
        android:layout_weight="1"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/view_theme"
                android:visibility="invisible"
                style="@style/ActionBarIconStyle"/>
            <ImageView
                android:id="@+id/share"
                android:background="@drawable/ic_action_share"
                android:visibility="gone"
                android:contentDescription="@string/toolbar_share_description"
                android:layout_marginStart="@dimen/v12_notes_edit_header_ic_margin"
                style="@style/ActionBarIconStyle"/>
            <ImageView
                android:id="@+id/more"
                android:background="@drawable/ic_action_more"
                android:visibility="gone"
                android:contentDescription="@string/menu_more_description"
                android:layout_marginStart="@dimen/v12_notes_edit_header_ic_margin"
                style="@style/ActionBarIconStyle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/edit_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/undo"
                android:background="@drawable/ic_action_undo"
                android:visibility="invisible"
                android:contentDescription="@string/toolbar_undo_description"
                style="@style/ActionBarIconStyle"/>
            <ImageView
                android:id="@+id/redo"
                android:background="@drawable/ic_action_redo"
                android:visibility="invisible"
                android:contentDescription="@string/toolbar_redo_description"
                android:layout_marginStart="@dimen/v12_notes_edit_header_ic_margin"
                style="@style/ActionBarIconStyle"/>
            <ImageView
                android:id="@+id/done"
                android:background="@drawable/ic_action_done"
                android:visibility="invisible"
                android:contentDescription="@string/toolbar_done_description"
                android:layout_marginStart="@dimen/v12_notes_edit_header_ic_margin"
                style="@style/ActionBarIconStyle"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/todo_full_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/module_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="28dp">
        <ImageView
            android:id="@+id/iv_data_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_btn_fw_create_data"
            android:contentDescription="@string/todo_menu_add_description"/>
        <TextView
            android:textSize="@dimen/text_default_size"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="@string/todo_module_name"
            android:layout_marginStart="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/head_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <miuix.miuixbasewidget.widget.EmptyStateView
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/blankview_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:title="@string/data_empty_todo"/>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/audio_create_float_group"/>
</LinearLayout>

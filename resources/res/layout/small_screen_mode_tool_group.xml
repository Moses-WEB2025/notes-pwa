<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_mode_tool_group"
    android:visibility="gone"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0">
    <View
        android:id="@+id/small_placeholder"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/mix_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/toolbar_container"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/expand_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/toolbar_relative_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/notes_edit_toolbar_height"
            android:layout_weight="0.81">
            <com.miui.notes.ui.view.EditModeToolbar
                android:orientation="horizontal"
                android:id="@+id/toolbar"
                android:focusable="true"
                android:saveEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="3dp">
                <ImageView
                    android:id="@+id/ai"
                    android:saveEnabled="false"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:src="@drawable/icon_ai"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/ai_text_widget_title"
                    style="@style/EditToolBarIconBgStyle"/>
                <ImageView
                    android:id="@+id/audio"
                    android:saveEnabled="false"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:src="@drawable/ic_tool_voice"
                    android:scaleType="center"
                    android:contentDescription="@string/toolbar_voice_description"
                    style="@style/EditToolBarIconBgStyle"/>
                <ImageView
                    android:id="@+id/gallery"
                    android:saveEnabled="false"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:src="@drawable/ic_tool_gallery"
                    android:scaleType="center"
                    android:contentDescription="@string/toolbar_gallery_description"
                    style="@style/EditToolBarIconBgStyle"/>
                <ImageView
                    android:id="@+id/edit_image"
                    android:saveEnabled="false"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:src="@drawable/ic_tool_doodle"
                    android:scaleType="center"
                    android:contentDescription="@string/doodle_feature"
                    style="@style/EditToolBarIconBgStyle"/>
                <ImageView
                    android:id="@+id/check"
                    android:saveEnabled="false"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:src="@drawable/ic_tool_checkbox"
                    android:scaleType="center"
                    android:contentDescription="@string/rich_text_tasklist_description"
                    style="@style/EditToolBarIconBgStyle"/>
            </com.miui.notes.ui.view.EditModeToolbar>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.19">
            <ImageView
                android:id="@+id/rich_text_divide"
                android:visibility="invisible"
                android:saveEnabled="false"
                android:layout_width="0.75dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/v12_note_editmodebar_divide_gradient_bg"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/rich_text_switch"
                android:saveEnabled="false"
                android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                android:src="@drawable/ic_tool_richtext"
                android:scaleType="center"
                android:layout_centerVertical="true"
                android:contentDescription="@string/rich_text_expand_description"
                android:layout_marginEnd="28dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/expand_container"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/navi_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_container"/>
    <View
        android:id="@+id/navi_placeholder"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/expand_container"/>
    <View
        android:id="@+id/panel_divide"
        android:background="@color/toolbar_divide_color"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

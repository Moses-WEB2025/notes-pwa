<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/stub"
        android:visibility="visible"
        android:layout_width="1px"
        android:layout_height="1px"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:id="@+id/float_guide_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/pref_title_quick_note_talkback">
        <FrameLayout
            android:id="@+id/float_excerpt_view"
            android:background="@drawable/excerpt_float_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/float_excerpted"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/float_excerpt_view_height"
                android:alpha="0"
                android:paddingEnd="5dp"
                android:layout_marginStart="@dimen/float_excerpt_tv_margin_rl">
                <TextView
                    android:textColor="#ffbb00"
                    android:ellipsize="end"
                    android:id="@+id/float_excerpt_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/excerpted_to_note"
                    android:lines="1"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/float_excerpt_star"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    app:lottie_autoPlay="false"
                    app:lottie_fileName="star.json"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/float_excerpt_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/float_excerpt_view_height">
                <TextView
                    android:textSize="@dimen/excerpt_text_content_size"
                    android:textColor="@color/text_primary"
                    android:id="@+id/excerpt_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="275dp"
                    android:text="@string/excerpting"
                    android:singleLine="false"
                    android:layout_marginStart="@dimen/float_excerpt_tv_margin_rl"/>
                <ImageView
                    android:id="@+id/iv_stop_excerpt"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_stop_excerpt"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/toast_excerpt_end"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="@dimen/float_excerpt_bg_padding_end"/>
            </LinearLayout>
        </FrameLayout>
        <View
            android:id="@+id/float_guide_line_view"
            android:background="@drawable/todo_float_guide_bg"
            android:visibility="visible"
            android:layout_width="@dimen/float_guide_view_width_size"
            android:layout_height="@dimen/float_guide_view_length_size"
            android:layout_marginLeft="@dimen/float_guide_view_margin_start"
            android:layout_marginTop="@dimen/float_guide_view_margin_vertical"
            android:layout_marginRight="@dimen/float_guide_view_margin_end"
            android:layout_marginBottom="@dimen/float_guide_view_margin_vertical"/>
    </FrameLayout>
    <include
        android:id="@+id/full_float_view"
        android:visibility="gone"
        layout="@layout/float_full_view"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_item_group"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.miui.todo.view.SparkFrameLayout
        android:id="@+id/item_content_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/item_content"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/todo_fw_item_margin_top"
            android:layout_marginBottom="@dimen/todo_fw_item_margin_bottom"
            android:minHeight="@dimen/todo_fw_item_min_height"
            android:layerType="hardware"
            android:layout_marginStart="@dimen/todo_fw_item_margin_start"
            android:layout_marginEnd="@dimen/todo_fw_item_margin_start">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/todo_fw_item_content_bg_margin_top"
                android:layout_marginBottom="16dp"
                android:minHeight="43dp">
                <CheckBox
                    android:theme="@style/NoteTheme.List"
                    android:id="@android:id/checkbox"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/checkbox_mask"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Todo.CheckBox"/>
                <View
                    android:id="@+id/checkbox_mask"
                    android:layout_width="@dimen/todo_item_content_bg_margin_start"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/content_group"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/label"
                    app:layout_constraintEnd_toStartOf="@+id/tv_progress"
                    app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_goneMarginEnd="20dp">
                    <com.miui.common.view.StrikeTextView.StrikeTextView
                        android:textAppearance="@style/Todo.TextAppearance.List.Secondary"
                        android:textColor="@color/todo_fw_item_content_text_common_color"
                        android:ellipsize="end"
                        android:id="@+id/content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/label"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_below="@+id/content_group"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_progress"
                    app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
                    app:layout_constraintTop_toBottomOf="@+id/content_group"
                    app:layout_goneMarginEnd="20dp">
                    <TextView
                        android:textAppearance="@style/Todo.TextAppearance.List.Tertiary"
                        android:textSize="12sp"
                        android:textColor="@color/action_bg_border_color"
                        android:gravity="start|center_vertical"
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:id="@+id/iv_clock"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_todo_item_clock_n"
                        android:layout_marginStart="6dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_audio"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_todo_item_audio"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_tertiary_size"
                    android:textColor="@color/todo_item_list_process_text_color"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tv_progress"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ll_expand_group"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_expand_group"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_expand"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="20dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.miui.todo.view.SparkFrameLayout>
</RelativeLayout>

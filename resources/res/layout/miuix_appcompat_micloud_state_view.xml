<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    class="miuix.micloudview.MiCloudStateView">
    <LinearLayout
        android:id="@android:id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="@dimen/miuix_appcompat_cloud_state_message_height"
        android:layout_marginTop="@dimen/miuix_appcompat_cloud_state_bg_padding_top"
        android:layout_marginBottom="@dimen/miuix_appcompat_cloud_state_bg_padding_bottom"
        android:paddingStart="@dimen/miuix_appcompat_cloud_state_content_padding_start"
        android:paddingEnd="@dimen/miuix_appcompat_cloud_state_content_padding_end"
        android:layout_marginStart="@dimen/miuix_appcompat_cloud_state_bg_padding_horizontal"
        android:layout_marginEnd="@dimen/miuix_appcompat_cloud_state_bg_padding_horizontal">
        <TextView
            android:textAppearance="@style/TextAppearance.MiCloudState.Primary"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/cloud_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="2"
            android:marqueeRepeatLimit="marquee_forever"
            android:textDirection="locale"/>
        <FrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/custom_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/miuix_appcompat_cloud_state_text_margin"/>
    </LinearLayout>
</view>

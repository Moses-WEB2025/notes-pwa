<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/creation_select_popupwindow_background"
    app:cardCornerRadius="@dimen/creation_actionmode_radius"
    app:cardElevation="@dimen/creation_actionmode_elevation"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/creation_select_card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_save"
            android:background="@color/creation_select_popupwindow_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/save_to_pictures"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_24"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_cut"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_select_cut"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_24"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_copy"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_select_copy"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_crop"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_pow_select_crop"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_copy_paste"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_select_copy_paste"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_copy_as_text"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_select_copy_as_text"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_recognize_as_text"
            android:background="@color/creation_select_popupwindow_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_select_recognize_as_text"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/creation_select_delete"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="@dimen/creation_actionmode_height"
            android:text="@string/creation_ppw_select_delete"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_dp_16"
            android:paddingEnd="@dimen/creation_actionmode_dp_16"
            android:layout_marginStart="1dp"/>
        <ImageView
            android:id="@+id/creation_select_more"
            android:background="@color/creation_select_popupwindow_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/miui_ic_more"
            android:scaleType="center"
            android:minHeight="@dimen/creation_actionmode_height"
            android:contentDescription="@string/creation_tool_more"
            android:paddingStart="@dimen/creation_actionmode_more_margin_start"
            android:paddingEnd="@dimen/creation_actionmode_more_margin_end"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

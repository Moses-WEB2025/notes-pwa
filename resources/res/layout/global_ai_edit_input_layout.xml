<?xml version="1.0" encoding="utf-8"?>
<com.miui.notes.ai.ui.fold.utils.InputConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/global_ai_text_panel_input_height"
    android:layout_marginStart="@dimen/global_ai_input_container_margin">
    <FrameLayout
        android:id="@+id/global_input_rim_effect_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/global_ai_input_container_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.miui.notes.ai.ui.fold.utils.InputHyperCardView
        android:layout_gravity="center"
        android:id="@+id/global_input_content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shadowColor="@color/ai_widget_shadow_color_default"
        android:shadowDy="@dimen/ai_widget_shadow_dy"
        android:shadowRadius="@dimen/ai_widget_shadow_radius"
        android:layout_marginHorizontal="@dimen/global_ai_input_container_margin"
        app:cardBackgroundColor="@color/ai_widget_default_bg_color"
        app:cardBlendColorModes="@array/ai_panel_widget_blend_modes"
        app:cardBlendColors="@array/ai_panel_widget_blend_colors"
        app:cardCornerRadius="@dimen/ai_input_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:material_binding_render_mode="dark"
        app:material_blend_colors="@array/ai_input_send_blend_colors"
        app:material_blend_modes="@array/ai_material_default_blend_modes"
        app:material_blur_radius="@dimen/ai_material_blur_radius"
        app:material_corner_radius="@dimen/global_ai_text_panel_input_corner_radius"
        app:material_default_bg_color="@color/ai_input_material_default_bg_color"
        app:material_shadow_color="@color/ai_recommend_send_shadow_color"
        app:material_shadow_radius="100"
        app:material_shadow_y="40"
        app:material_stroke_colors="@array/ai_send_button_gradient_border_colors"
        app:material_stroke_width="@dimen/ai_widget_border_width"
        app:miuix_blurRadius="@dimen/ai_material_blur_radius"
        app:miuix_blurSelfBackground="true"
        app:miuix_strokeGradientColors="@array/ai_input_gradient_border_colors"
        app:miuix_strokeWidth="@dimen/ai_input_border_width">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.miui.notes.ai.ui.fold.utils.InputIconImageView
                android:id="@+id/ai_input_icon_image"
                android:layout_width="@dimen/global_ai_panel_input_icon_size_22"
                android:layout_height="@dimen/global_ai_panel_input_icon_size_22"
                android:layout_marginTop="@dimen/global_ai_edit_input_content_margin_vertical"
                android:src="@drawable/global_ai_panel_input_icon"
                android:scaleType="fitCenter"
                android:layout_marginStart="@dimen/ai_input_icon_margin_start"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/global_placeholder"
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:layout_marginBottom="@dimen/global_ai_edit_input_end_btn_margin_end"
                android:layout_marginEnd="@dimen/global_ai_edit_input_end_btn_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/global_ai_edit_input"/>
            <miuix.cardview.HyperCardView
                android:id="@+id/global_ai_edit_input_disable_layout"
                android:layout_width="52dp"
                android:layout_height="32dp"
                app:cardCornerRadius="@dimen/global_ai_text_panel_btn_corner"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/global_placeholder"
                app:layout_constraintEnd_toEndOf="@+id/global_placeholder"
                app:layout_constraintStart_toStartOf="@+id/global_placeholder"
                app:layout_constraintTop_toTopOf="@+id/global_placeholder">
                <TextView
                    android:textSize="@dimen/global_ai_edit_input_end_btn_text_size"
                    android:textColor="@color/global_ai_panel_btn_disable"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/global_ai_btn_disable"
                    android:background="@drawable/ai_edit_input_end_btn_disable"
                    android:padding="@dimen/global_ai_edit_input_end_btn_margin_end"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/ai_edit_input_end_btn_text"
                    android:fontFamily="sans-serif-medium"/>
            </miuix.cardview.HyperCardView>
            <com.miui.notes.ai.ui.material.MaterialEffectContainer
                android:id="@+id/global_ai_edit_input_enable_layout"
                android:layout_width="52dp"
                android:layout_height="32dp"
                app:layout_constraintBottom_toBottomOf="@+id/global_placeholder"
                app:layout_constraintEnd_toEndOf="@+id/global_placeholder"
                app:layout_constraintStart_toStartOf="@+id/global_placeholder"
                app:layout_constraintTop_toTopOf="@+id/global_placeholder"
                app:material_binding_render_mode="dark"
                app:material_blend_colors="@array/ai_input_send_blend_colors"
                app:material_blend_modes="@array/ai_material_default_blend_modes"
                app:material_blur_radius="@dimen/ai_material_blur_radius"
                app:material_corner_radius="@dimen/ai_input_send_corner_radius"
                app:material_default_bg_color="@color/ai_input_send_default_color"
                app:material_shadow_color="@color/ai_recommend_send_shadow_color"
                app:material_shadow_radius="100"
                app:material_shadow_y="40"
                app:material_stroke_colors="@array/ai_send_button_gradient_border_colors"
                app:material_stroke_width="@dimen/ai_widget_border_width">
                <miuix.cardview.HyperCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/global_ai_text_panel_btn_corner"
                    app:cardElevation="0dp">
                    <TextView
                        android:textSize="@dimen/global_ai_edit_input_end_btn_text_size"
                        android:textColor="@color/miuix_appcompat_white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/global_ai_edit_input_end_btn"
                        android:background="@drawable/ai_edit_input_end_btn"
                        android:padding="@dimen/global_ai_edit_input_end_btn_margin_end"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/ai_edit_input_end_btn_text"
                        android:fontFamily="sans-serif-medium"/>
                </miuix.cardview.HyperCardView>
            </com.miui.notes.ai.ui.material.MaterialEffectContainer>
            <com.miui.notes.ai.ui.CustomAiTextWidgetEditText
                android:textAppearance="?android:attr/textAppearanceLargeInverse"
                android:textSize="@dimen/global_ai_text_panel_input_text_size"
                android:textColor="@color/ai_input_text_color"
                android:textColorHint="@color/global_ai_panel_input_hint"
                android:gravity="start|center_vertical"
                android:id="@+id/global_ai_edit_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/ai_recommend_layout_edit_max_height"
                android:minHeight="@dimen/ai_recommend_layout_edit_min_height"
                android:hint="@string/ai_input_default_text"
                android:maxLines="4"
                android:includeFontPadding="false"
                android:maxLength="5000"
                android:lineSpacingMultiplier="0.9"
                android:inputType="textMultiLine"
                android:imeOptions="flagNoFullscreen"
                android:textSelectHandleLeft="@drawable/edit_select_handle_left"
                android:textSelectHandleRight="@drawable/edit_select_handle_right"
                android:textSelectHandle="@drawable/edit_select_handle_middle"
                android:textCursorDrawable="@drawable/global_ai_edit_cursor_color"
                android:layout_marginStart="@dimen/ai_recommend_layout_edit_margin_start"
                android:layout_marginEnd="@dimen/ai_recommend_layout_edit_margin_end"
                android:paddingVertical="@dimen/global_ai_edit_input_content_margin_vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/global_placeholder"
                app:layout_constraintStart_toEndOf="@+id/ai_input_icon_image"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/NoUnderlineEditText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.miui.notes.ai.ui.fold.utils.InputHyperCardView>
</com.miui.notes.ai.ui.fold.utils.InputConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/dialog_root_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/todo_edit_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@android:string/cancel"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.miui.todo.view.EditRootLayout
            android:id="@+id/edit_panel"
            android:background="@drawable/todo_edit_panel_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/todo_edit_container_margin_top"
            android:layout_marginStart="@dimen/todo_edit_container_margin_horizontal"
            android:layout_marginEnd="@dimen/todo_edit_container_margin_horizontal"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="vertical"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="182dp"
                android:splitMotionEvents="false">
                <LinearLayout
                    android:gravity="top"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:baselineAligned="false"
                    android:layout_weight="1"
                    android:splitMotionEvents="false"
                    android:layout_marginStart="@dimen/pad_todo_edit_bottom_menu_margin_start"
                    android:layout_marginEnd="@dimen/pad_todo_edit_bottom_menu_margin_start">
                    <include
                        android:id="@+id/todo_editor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pad_todo_edit_margin_top"
                        layout="@layout/pad_todo_editor"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pad_todo_edit_toolbar_padding"
                        android:layout_marginBottom="@dimen/todo_edit_toolbar_time_margin_bottom"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/pad_todo_edit_bottom_menu_margin_start">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/group_tag_custom"
                            android:background="@drawable/compose_todo_editor_tag_bg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/todo_edit_remind_custom_tag_min_height">
                            <ImageView
                                android:id="@+id/iv_tag_custom"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_todo_edit_remind"
                                android:importantForAccessibility="no"
                                android:layout_marginStart="@dimen/pad_todo_edit_remind_custom_tag_icon_margin_start"/>
                            <TextView
                                android:textSize="@dimen/todo_edit_remind_text_size"
                                android:textColor="@color/todo_edit_remind_color"
                                android:id="@+id/tv_tag_custom"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/todo_edit_btn_custom"
                                android:layout_weight="1"
                                android:contentDescription="@string/todo_edit_btn_custom"
                                android:paddingStart="4dp"
                                android:paddingEnd="@dimen/pad_todo_edit_remind_text_padding_end_default"/>
                            <View
                                android:id="@+id/v_tag_divider"
                                android:background="@color/divider_line"
                                android:visibility="gone"
                                android:layout_width="1dp"
                                android:layout_height="14dp"/>
                            <ImageView
                                android:id="@+id/iv_tag_cancel"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_todo_edit_remind_cancel"
                                android:contentDescription="@string/todo_edit_btn_cancel_remind"
                                android:paddingStart="8dp"
                                android:paddingEnd="12dp"/>
                        </LinearLayout>
                    </FrameLayout>
                    <com.miui.todo.view.ChildClickableLinearLayout
                        android:id="@+id/send_button_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pad_todo_edit_toolbar_padding"
                        android:layout_marginBottom="@dimen/todo_edit_toolbar_time_margin_bottom"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/pad_todo_edit_bottom_menu_margin_start">
                        <Button
                            android:enabled="false"
                            android:textSize="@dimen/pad_todo_edit_done_btn_text_size"
                            android:textColor="@color/todo_edit_done_color"
                            android:gravity="center"
                            android:id="@+id/send_button"
                            android:background="@null"
                            android:nextFocusLeft="@+id/embedded_text_editor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="80dp"
                            android:minHeight="@dimen/todo_edit_remind_custom_tag_min_height"
                            android:text="@string/todo_edit_btn_done"
                            android:layout_centerInParent="true"
                            android:contentDescription="@string/todo_edit_btn_done"
                            android:fontFamily="miui-bold"/>
                    </com.miui.todo.view.ChildClickableLinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.miui.todo.view.EditRootLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>

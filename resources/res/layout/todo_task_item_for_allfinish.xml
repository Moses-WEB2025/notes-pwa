<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_item_group"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.miui.todo.view.SparkFrameLayout
        android:id="@+id/item_content_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_content"
            android:background="@drawable/todo_child_item_bg_no_border"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/miuix_theme_margin_horizontal_common"
            android:minHeight="@dimen/todo_item_min_height"
            android:layerType="hardware"
            android:layout_marginStart="@dimen/miuix_theme_margin_horizontal_common"
            android:layout_marginEnd="@dimen/miuix_theme_margin_horizontal_common">
            <View
                android:id="@+id/v_bg"
                android:background="@drawable/todo_child_item_bg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layerType="hardware"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <CheckBox
                android:id="@android:id/checkbox"
                android:visibility="visible"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/checkbox_mask"
                app:layout_constraintEnd_toEndOf="@+id/checkbox_mask"
                app:layout_constraintTop_toTopOf="@+id/checkbox_mask"
                style="@style/Todo.CheckBox"/>
            <View
                android:id="@+id/checkbox_mask"
                android:layout_width="@dimen/todo_item_content_bg_margin_start"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/content_group"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/content_group"/>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:id="@+id/content_group"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="43dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_expand_group"
                app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="20dp">
                <com.miui.common.view.StrikeTextView.StrikeTextView
                    android:textAppearance="@style/Todo.TextAppearance.List.Secondary"
                    android:textColor="@color/todo_item_content_text_common_color"
                    android:ellipsize="end"
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="4"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/label"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textAppearance="@style/Todo.TextAppearance.List.Tertiary"
                        android:textSize="12sp"
                        android:textColor="@color/action_bg_border_color"
                        android:gravity="start|center_vertical"
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:id="@+id/iv_clock"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_todo_item_clock_n"
                        android:layout_marginStart="6dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_audio"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_data_item_audio"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_expand_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/content_group"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/content_group">
                <TextView
                    android:textSize="@dimen/text_tertiary_size"
                    android:textColor="@color/todo_item_list_process_text_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_expand"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/todo_item_content_bg_margin_end"/>
            </LinearLayout>
            <CheckBox
                android:theme="@style/Note.MultiCheckBox"
                android:layout_gravity="center"
                android:id="@+id/multi_checkbox"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/todo_item_multicheckbox_margin_end"
                app:layout_constraintBottom_toBottomOf="@+id/content_group"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/content_group"/>
            <ImageView
                android:id="@+id/iv_drag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_todo_item_drag"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/todo_drag_margin_start"
                app:layout_constraintBottom_toBottomOf="@+id/content_group"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/content_group"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.miui.todo.view.SparkFrameLayout>
</RelativeLayout>

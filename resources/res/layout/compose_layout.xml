<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollOrientation="vertical"
    app:scrollableView="@+id/scroll_view">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/compose_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?attr/searchRecommendationGroupDivider"
            android:showDividers="middle"
            android:dividerPadding="@dimen/miuix_search_container_margin_start"/>
    </androidx.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>

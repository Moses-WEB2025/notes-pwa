<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/ic_widget_bg_4x4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_note_root_layout"
        android:paddingTop="@dimen/widget_note_root_padding_vertical_4x4"
        android:paddingBottom="@dimen/widget_note_root_padding_vertical_4x4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/widget_note_root_padding_horizontal_4x4"
        android:paddingEnd="@dimen/widget_note_root_padding_horizontal_4x4">
        <include layout="@layout/widget_title_include"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_content_margin_top">
            <ImageView
                android:id="@+id/widget_image"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/widget_4x4_note_image_margin_bottom"/>
            <TextView
                android:textAppearance="@style/V13.TextAppearance.Widget.Snippet_4x"
                android:ellipsize="end"
                android:id="@+id/widget_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_content"
                android:maxLines="20"
                android:singleLine="false"
                android:lineSpacingExtra="@dimen/widget_content_line_spacing_extra_4x4"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/card_group_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="0dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="12dp">
    <com.miui.handwriting.common.view.custom.StateEditText
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:inputType="number"
        android:textAlignment="viewStart"
        app:miuixAppcompatLabel="@string/creation_page_size_custom_height"/>
    <com.miui.handwriting.common.view.custom.StateEditText
        android:id="@+id/content_width"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:inputType="number"
        android:textAlignment="viewStart"
        app:miuixAppcompatLabel="@string/creation_page_size_custom_width"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/brush_config_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/alpha_details_container"
        android:background="@drawable/doodle_brush_config_alpha_details_bg"
        android:clipChildren="false"
        android:layout_width="@dimen/alpha_details_panel_width"
        android:layout_height="@dimen/alpha_details_panel_height"
        android:layout_marginBottom="@dimen/alpha_details_panel_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/alpha_container"
        app:layout_constraintEnd_toEndOf="@+id/alpha_container"
        app:layout_constraintStart_toStartOf="@+id/alpha_container">
        <View
            android:id="@+id/alpha_details_sample"
            android:layout_width="@dimen/alpha_details_sample_size"
            android:layout_height="@dimen/alpha_details_sample_size"
            android:layout_marginTop="@dimen/alpha_details_sample_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/alpha_details_text_size"
            android:textColor="#333"
            android:id="@+id/alpha_details_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_details_text_margin_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.miui.support.cardview.CardView
        android:id="@+id/alpha_container"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_details_panel_height"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/color_items_panel_radius"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stroke_width_container"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/doodle_brush_config_alpha">
            <ImageView
                android:id="@+id/alpha_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alpha_alpha_bar_size"
                android:src="@drawable/doodle_brush_config_alpha_bg"
                android:scaleType="fitXY"
                android:layout_marginStart="@dimen/alpha_bg_margin"
                android:layout_marginEnd="@dimen/alpha_bg_margin"
                android:elevation="0.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/alpha_thumb"
                android:background="@drawable/ic_doodle_alpha_thumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationX="@dimen/alpha_thumb_size_half"
                android:elevation="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/alpha_bg"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.miui.support.cardview.CardView>
    <com.miui.support.cardview.CardView
        android:id="@+id/stroke_width_container"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/alpha_details_panel_height"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/color_items_panel_radius"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toEndOf="@+id/alpha_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_group"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/doodle_brush_config_width_level">
            <include
                android:id="@+id/item5"
                android:layout_width="@dimen/stroke_item_parent_size"
                android:layout_height="@dimen/stroke_item_parent_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/item4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                layout="@layout/doodle_stroke_width_item_l5"/>
            <include
                android:id="@+id/item4"
                android:layout_width="@dimen/stroke_item_parent_size"
                android:layout_height="@dimen/stroke_item_parent_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/item3"
                app:layout_constraintStart_toEndOf="@+id/item5"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                layout="@layout/doodle_stroke_width_item_l4"/>
            <include
                android:id="@+id/item3"
                android:layout_width="@dimen/stroke_item_parent_size"
                android:layout_height="@dimen/stroke_item_parent_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/item2"
                app:layout_constraintStart_toEndOf="@+id/item4"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                layout="@layout/doodle_stroke_width_item_l3"/>
            <include
                android:id="@+id/item2"
                android:layout_width="@dimen/stroke_item_parent_size"
                android:layout_height="@dimen/stroke_item_parent_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/item1"
                app:layout_constraintStart_toEndOf="@+id/item3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                layout="@layout/doodle_stroke_width_item_l2"/>
            <include
                android:id="@+id/item1"
                android:layout_width="@dimen/stroke_item_parent_size"
                android:layout_height="@dimen/stroke_item_parent_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/item2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                layout="@layout/doodle_stroke_width_item_l1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.miui.support.cardview.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>

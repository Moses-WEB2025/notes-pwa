<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarStyle="outsideOverlay"
    android:id="@+id/remind_picker_dialog"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:textSize="@dimen/text_title_size"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/remind_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/todo_time_picker_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/datepicker_sub_title_text"
            android:gravity="center"
            android:id="@+id/setting_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
        <miuix.pickerwidget.widget.DateTimePicker
            android:orientation="vertical"
            android:id="@+id/dateTimePicker"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/todo_date_picker_layout_padding"
            android:paddingEnd="@dimen/todo_date_picker_layout_padding"/>
        <include
            android:id="@+id/group_set_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/repeat_remind_margin_top"
            android:layout_marginBottom="@dimen/repeat_remind_margin_bottom"
            android:layout_marginStart="@dimen/repeat_remind_margin_start"
            layout="@layout/todo_remindtime_repeat_preference_value"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/whole_day_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/miuix_appcompat_secondary_text_size"
                android:textStyle="normal"
                android:textColor="@color/miuix_preference_secondary_text"
                android:id="@+id/alarm_at"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_weight="1"/>
            <miuix.slidingwidget.widget.SlidingButton
                android:id="@+id/alarm_enabler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

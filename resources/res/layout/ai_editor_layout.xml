<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/title_root_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ai_dialog_title_height">
        <ImageView
            android:id="@+id/title_cancel_btn"
            android:layout_width="@dimen/ai_dialog_title_icon_size"
            android:layout_height="@dimen/ai_dialog_title_icon_size"
            android:src="@drawable/miuix_action_icon_immersion_close"
            android:layout_centerVertical="true"
            android:contentDescription="@string/dialog_button_cancel"
            android:layout_marginStart="@dimen/ai_dialog_title_icon_start"/>
        <TextView
            android:textSize="@dimen/ai_dialog_title_size"
            android:textStyle="bold"
            android:id="@+id/title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_summary"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif"/>
    </RelativeLayout>
    <include
        android:id="@+id/translate_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ai_dialog_translate_root_margin_bottom"
        android:layout_below="@+id/title_root_view"
        android:layout_marginStart="@dimen/ai_dialog_translate_root_margin_start"
        android:layout_marginEnd="@dimen/ai_dialog_translate_root_margin_start"
        layout="@layout/ai_translate_layout"/>
    <TextView
        android:textSize="@dimen/loading_textview_size"
        android:textStyle="normal"
        android:id="@+id/loading_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/loading_textview_margin_top"
        android:layout_above="@+id/tab_root"
        android:layout_below="@+id/translate_root"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/loading_textview_margin_start"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/flow_error_layout"
        android:background="@drawable/todo_ai_retry_background"
        android:padding="@dimen/ai_error_view_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_error_view_margin_top"
        android:layout_marginBottom="@dimen/ai_error_view_margin_bottom"
        android:layout_below="@+id/translate_root"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="@dimen/ai_error_view_margin_h">
        <TextView
            android:textSize="@dimen/ai_retry_text_size"
            android:textColor="@color/ai_error_view_text_color"
            android:layout_gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ai_failed"
            android:layout_weight="6"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="@dimen/ai_retry_text_size"
            android:textColor="@color/ai_error_view_text_color"
            android:gravity="end"
            android:layout_gravity="center"
            android:id="@+id/flow_retry_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ai_feature_retry"
            android:layout_weight="4"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <com.miui.hybirdeditor.RichEditorWebView
        android:id="@+id/ai_webView"
        android:visibility="invisible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tab_root"
        android:layout_below="@+id/flow_error_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/error_warn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tab_root"
        android:layout_below="@+id/translate_root">
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="4"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ai_error_warn"/>
        <TextView
            android:textSize="@dimen/ai_error_text_size"
            android:textColor="@color/ai_error_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ai_error_text_margin"
            android:text="@string/ai_failed"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:hyphenationFrequency="fullFast"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6">
            <Button
                android:textSize="@dimen/ai_retry_text_size"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:id="@+id/error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ai_retry_btn_margin_top"
                android:text="@string/ai_feature_retry"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="@dimen/ai_retry_btn_padding_h"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tab_root"
        android:paddingTop="@dimen/ai_dialog_bottom_tab_paddingTop"
        android:paddingBottom="@dimen/ai_dialog_bottom_tab_paddingBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/ai_dialog_bottom_tab_paddingStart"
        android:paddingEnd="@dimen/ai_dialog_bottom_tab_paddingStart">
        <com.miui.notes.ai.ui.BottomTabItem
            android:orientation="vertical"
            android:id="@+id/retry"
            app:src="@drawable/ai_retry_icon"
            app:text="@string/action_retry"
            style="@style/AiBottomTabItemStyle"/>
        <com.miui.notes.ai.ui.BottomTabItem
            android:orientation="vertical"
            android:id="@+id/copy"
            app:src="@drawable/ai_copy_icon"
            app:text="@string/action_copy"
            style="@style/AiBottomTabItemStyle"/>
        <com.miui.notes.ai.ui.BottomTabItem
            android:orientation="vertical"
            android:id="@+id/insert"
            app:src="@drawable/ai_insert_icon"
            app:text="@string/action_insert"
            style="@style/AiBottomTabItemStyle"/>
        <com.miui.notes.ai.ui.BottomTabItem
            android:orientation="vertical"
            android:id="@+id/replace"
            app:src="@drawable/ai_replace_icon"
            app:text="@string/action_replace"
            style="@style/AiBottomTabItemStyle"/>
    </LinearLayout>
    <com.miui.notes.ai.ui.WaterMarkView
        android:id="@+id/water_mark_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tab_root"
        android:layout_below="@+id/title_root_view"/>
</RelativeLayout>

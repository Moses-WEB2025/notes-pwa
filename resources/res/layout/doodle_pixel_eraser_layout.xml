<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btn_pixel_eraser_container"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <com.miui.support.cardview.CardView
        android:id="@+id/pixel_eraser_entry"
        android:layout_width="@dimen/doodle_button_size"
        android:layout_height="@dimen/doodle_button_size"
        android:contentDescription="@string/doodle_tool_eraser_pixel_mode"
        android:elevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/doodle_button_radius"
        app:cardElevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:background="@drawable/doodle_btn_bg"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/doodle_ic_pixel_eraser"/>
    </com.miui.support.cardview.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tips_container"
        android:background="@drawable/doodle_brush_config_alpha_details_bg"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/doodle_button_size"
        android:minWidth="@dimen/tip_panel_width"
        android:layout_marginStart="@dimen/tip_panel_margin_start"
        app:layout_constraintStart_toEndOf="@+id/pixel_eraser_entry"
        app:layout_constraintTop_toTopOf="@+id/pixel_eraser_entry">
        <TextView
            android:textSize="@dimen/alpha_details_text_size"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/pixel_tips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doodle_tool_eraser_pixel_mode"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

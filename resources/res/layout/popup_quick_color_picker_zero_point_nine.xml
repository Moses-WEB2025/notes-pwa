<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quick_color_popup_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.miui.handwriting.common.view.colorpicker.QuickColorBlurBackGroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_root2"
        app:layout_constraintEnd_toEndOf="@+id/ll_root2"
        app:layout_constraintStart_toStartOf="@+id/ll_root2"
        app:layout_constraintTop_toTopOf="@+id/ll_root2"/>
    <com.miui.handwriting.common.view.colorpicker.QuickColorArrowBlurBackGroundView
        android:id="@+id/quick_color_popup_window_arrow_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_root2"
        android:paddingTop="@dimen/creation_color_picker_tab_margin_top_no_shadow_zero_point_nine"
        android:layout_width="@dimen/creation_color_picker_popup_width_zero_point_nine"
        android:layout_height="wrap_content"
        android:layout_margin="13dp"
        android:paddingHorizontal="@dimen/creation_color_picker_popup_view_page_margin_start_end_zero_point_nine"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <miuix.miuixbasewidget.widget.FilterSortView
            android:id="@+id/popup_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <view
                android:id="@+id/popup_grid_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/creation_color_picker_popup_tab_grid"
                app:layout_constraintEnd_toStartOf="@+id/popup_slider_button"
                app:layout_constraintStart_toStartOf="parent"
                class="miuix.miuixbasewidget.widget.FilterSortView$TabView"/>
            <view
                android:id="@+id/popup_slider_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/creation_color_picker_popup_tab_slider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/popup_grid_button"
                class="miuix.miuixbasewidget.widget.FilterSortView$TabView"/>
        </miuix.miuixbasewidget.widget.FilterSortView>
        <com.miui.handwriting.common.view.popup.PopupWindowScrollView
            android:scrollbarThumbVertical="@android:color/transparent"
            android:id="@+id/quick_color_popup_scroll_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_grid_panel_margin_top_zero_point_nine">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.miui.handwriting.common.view.colorpicker.CustomViewPager
                    android:id="@+id/custom_view_pager"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/creation_color_picker_popup_alpha_seekbar_margin_top_zero_point_nine">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/alpha_seekbar_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/creation_color_picker_popup_alpha_text_size_zero_point_nine"
                                android:textColor="@color/creation_more_popwindow_item_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/creation_color_picker_popup_alpha_text_transparent"
                                android:layout_alignParentStart="true"/>
                            <TextView
                                android:textSize="@dimen/creation_color_picker_popup_alpha_text_size_zero_point_nine"
                                android:gravity="end"
                                android:id="@+id/alpha_seek_bar_progress"
                                android:layout_width="@dimen/ai_create_part_zero_point_nine"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                        <com.miui.handwriting.common.view.colorpicker.ColorPickerAlphaView
                            android:id="@+id/alpha_seek_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/creation_color_picker_popup_alpha_seekbar_margin_top_zero_point_nine"
                            android:thumb="@drawable/color_picker_thumb"
                            android:contentDescription="@string/creation_color_picker_popup_alpha_text_transparent"
                            android:splitTrack="false"
                            app:thumb_scale="0.9"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/creation_color_picker_popup_margin_buttom_zero_point_nine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/creation_color_picker_popup_picker_display_margin_top_buttom_zero_point_nine"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/alpha_seekbar_ll">
                        <FrameLayout
                            android:id="@+id/color_picker"
                            android:layout_width="@dimen/creation_color_picker_popup_picker_display_width_height_zero_point_nine"
                            android:layout_height="@dimen/creation_color_picker_popup_picker_display_width_height_zero_point_nine"
                            android:layout_alignParentStart="true">
                            <ImageView
                                android:layout_gravity="center"
                                android:background="@drawable/color_picker_straw"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/creation_color_picker_popup_straw"/>
                        </FrameLayout>
                        <ImageView
                            android:id="@+id/display_block"
                            android:background="@drawable/color_picker_color_display_block"
                            android:clickable="false"
                            android:layout_width="@dimen/creation_color_picker_popup_picker_display_width_height_zero_point_nine"
                            android:layout_height="@dimen/creation_color_picker_popup_picker_display_width_height_zero_point_nine"
                            android:importantForAccessibility="no"
                            android:layout_alignParentEnd="true"
                            style="?android:attr/borderlessButtonStyle"/>
                    </RelativeLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.miui.handwriting.common.view.popup.PopupWindowScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:orientation="vertical"
    android:id="@+id/editor_container"
    android:addStatesFromChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.miui.todo.feature.todoedit.TodoEditTitleContainerView
            android:id="@+id/todo_editor_container"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_weight="1">
            <RelativeLayout
                android:id="@+id/normal_todo_check_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/rich_editor_scrollview"
                android:layout_alignParentTop="true"
                android:importantForAccessibility="no"
                android:layout_marginEnd="8dp"
                android:layout_alignParentStart="true">
                <CheckBox
                    android:theme="@style/NoteTheme.List"
                    android:id="@+id/cb_subtodo"
                    android:clickable="false"
                    android:layout_alignParentTop="true"
                    android:importantForAccessibility="no"
                    style="@style/Todo.Pc.CheckBox"/>
            </RelativeLayout>
            <view
                android:theme="@style/NoteTheme.TodoEdit"
                android:scrollbarStyle="outsideInset"
                android:id="@+id/rich_editor_scrollview"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:fillViewport="true"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@+id/normal_todo_check_group"
                class="com.miui.richeditor.RichEditScrollView">
                <view
                    android:textSize="@dimen/pc_todo_edit_text_size"
                    android:textColor="@color/pc_todo_item_content_text_common_color"
                    android:textColorHint="@color/note_title_hint_color_light"
                    android:gravity="top"
                    android:autoLink="all"
                    android:linksClickable="false"
                    android:id="@+id/rich_editor"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:lineSpacingExtra="4dp"
                    android:inputType="textImeMultiLine"
                    android:imeOptions="flagNoFullscreen|actionDone"
                    android:textCursorDrawable="@drawable/pc_todo_editor_cursor"
                    class="com.miui.pc.feature.todo.PcTodoRichEditor"/>
            </view>
        </com.miui.todo.feature.todoedit.TodoEditTitleContainerView>
        <TextView
            android:textSize="16dp"
            android:textColor="#4d000000"
            android:id="@+id/tv_subtodo_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_subtodo"
        android:background="@null"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shortcut_key_dialog_bg"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:paddingTop="@dimen/creation_shortcut_padding_top_bottom"
        android:paddingBottom="@dimen/creation_shortcut_padding_top_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/creation_shortcut_key_text"
            android:id="@+id/creation_shortcut_primary_key"
            android:text="@string/creation_ppw_shortcut_primary_key"
            android:alpha="0.8"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/creation_shortcut_key_main_style"/>
        <ImageView
            android:id="@+id/creation_img_primary_key"
            android:src="@drawable/creation_primary_key"
            app:layout_constraintBottom_toBottomOf="@+id/creation_shortcut_primary_key"
            app:layout_constraintStart_toEndOf="@+id/creation_shortcut_barrier"
            app:layout_constraintTop_toTopOf="@+id/creation_shortcut_primary_key"
            style="@style/creation_shortcut_pen_style"/>
        <TextView
            android:textAppearance="@style/creation_shortcut_subkey_text"
            android:id="@+id/creation_shortcut_primary_key_click"
            android:text="@string/creation_ppw_shortcut_single_click"
            android:alpha="0.5"
            android:layout_marginStart="@dimen/creation_shortcut_padding_startend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creation_shortcut_primary_key"
            style="@style/creation_shortcut_key_sub_style"/>
        <TextView
            android:textAppearance="@style/creation_shortcut_subkey_text"
            android:id="@+id/creation_shortcut_primary_key_click_disp"
            android:layout_width="0dp"
            android:text="@string/creation_ppw_shortcut_pk_single_click_tip"
            android:alpha="0.5"
            android:layout_marginStart="@dimen/creation_shortcut_margin_start"
            android:layout_marginEnd="@dimen/creation_shortcut_padding_startend"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/creation_shortcut_barrier"
            app:layout_constraintTop_toBottomOf="@+id/creation_shortcut_primary_key"
            style="@style/creation_shortcut_key_sub_style"/>
        <TextView
            android:textAppearance="@style/creation_shortcut_subkey_text"
            android:id="@+id/creation_shortcut_primary_key_longpress"
            android:text="@string/creation_ppw_shortcut_long_click"
            android:alpha="0.5"
            android:layout_marginStart="@dimen/creation_shortcut_padding_startend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creation_shortcut_primary_key_click_disp"
            style="@style/creation_shortcut_key_sub_style"/>
        <TextView
            android:textAppearance="@style/creation_shortcut_subkey_text"
            android:gravity="start"
            android:id="@+id/creation_shortcut_primary_key_longpress_disp"
            android:layout_width="0dp"
            android:text="@string/creation_ppw_shortcut_pk_long_click_tip"
            android:alpha="0.5"
            android:layout_marginStart="@dimen/creation_shortcut_margin_start"
            android:layout_marginEnd="@dimen/creation_shortcut_padding_startend"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/creation_shortcut_barrier"
            app:layout_constraintTop_toBottomOf="@+id/creation_shortcut_primary_key_click_disp"
            style="@style/creation_shortcut_key_sub_style"/>
        <TextView
            android:textAppearance="@style/creation_shortcut_key_text"
            android:id="@+id/creation_shortcut_sub_key"
            android:layout_marginTop="@dimen/creation_sub_shortcut_padding_top"
            android:text="@string/creation_ppw_shortcut_secondary_key"
            android:alpha="0.8"
            app:layout_constraintTop_toBottomOf="@+id/creation_shortcut_primary_key_longpress_disp"
            style="@style/creation_shortcut_key_main_style"/>
        <ImageView
            android:id="@+id/creation_img_sub_key"
            android:src="@drawable/creation_sub_key"
            app:layout_constraintBottom_toBottomOf="@+id/creation_shortcut_sub_key"
            app:layout_constraintStart_toEndOf="@+id/creation_shortcut_barrier"
            app:layout_constraintTop_toTopOf="@+id/creation_shortcut_sub_key"
            style="@style/creation_shortcut_pen_style"/>
        <TextView
            android:textAppearance="@style/creation_shortcut_subkey_text"
            android:id="@+id/creation_shortcut_sub_key_click"
            android:text="@string/creation_ppw_shortcut_single_click"
            android:alpha="0.5"
            android:layout_marginStart="@dimen/creation_shortcut_padding_startend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creation_shortcut_sub_key"
            style="@style/creation_shortcut_key_sub_style"/>
        <TextView
            android:textAppearance="@style/creation_shortcut_subkey_text"
            android:id="@+id/creation_shortcut_sub_key_disp"
            android:layout_width="0dp"
            android:text="@string/creation_ppw_shortcut_sk_single_click_tip"
            android:alpha="0.5"
            android:layout_marginStart="@dimen/creation_shortcut_margin_start"
            android:layout_marginEnd="@dimen/creation_shortcut_padding_startend"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/creation_shortcut_barrier"
            app:layout_constraintTop_toBottomOf="@+id/creation_shortcut_sub_key"
            style="@style/creation_shortcut_key_sub_style"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/creation_shortcut_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="true"
            app:barrierDirection="end"
            app:constraint_referenced_ids="creation_shortcut_primary_key,         creation_shortcut_primary_key_click,         creation_shortcut_primary_key_longpress,         creation_shortcut_sub_key,         creation_shortcut_sub_key_click"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/creation_shortcut_barrier_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="true"
            app:barrierDirection="end"
            app:constraint_referenced_ids="creation_img_primary_key,         creation_shortcut_primary_key_click_disp,         creation_shortcut_primary_key_longpress_disp,         creation_img_sub_key,         creation_shortcut_sub_key_disp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

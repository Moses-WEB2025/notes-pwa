<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/annotate_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="1">
    <FrameLayout
        android:id="@+id/annotate_group"
        android:background="@android:color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <miuix.androidbasewidget.widget.ClearableEditText
                android:textSize="@dimen/pc_image_annotation_edit_content_text_size"
                android:textColor="@color/theme_common_secondary_color_light"
                android:textColorHint="@color/empty_text_hint_light"
                android:gravity="start|center_vertical"
                android:id="@+id/edit_content"
                android:background="@drawable/pc_edit_layout_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pc_image_annotation_edit_margin_vertical"
                android:layout_marginBottom="@dimen/pc_image_annotation_edit_margin_vertical"
                android:minHeight="@dimen/pc_image_annotation_panel_height"
                android:hint="@string/image_annotation_edit_hint"
                android:maxLines="1"
                android:paddingStart="@dimen/pc_image_annotation_edit_content_padding_start"
                android:paddingEnd="@dimen/pc_image_annotation_edit_content_padding_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/done"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/pc_image_annotation_edit_content_text_size"
                android:textColor="@color/pc_notes_edit_annotation_done_color"
                android:gravity="center"
                android:id="@+id/done"
                android:background="@drawable/pc_edit_layout_bg"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pc_image_annotation_panel_height"
                android:layout_marginTop="@dimen/pc_image_annotation_edit_margin_vertical"
                android:layout_marginBottom="@dimen/pc_image_annotation_edit_margin_vertical"
                android:text="@string/done"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="@dimen/pc_image_annotation_edit_done_margin_start"
                android:layout_marginEnd="@dimen/pc_image_annotation_edit_margin_vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/edit_content"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</FrameLayout>

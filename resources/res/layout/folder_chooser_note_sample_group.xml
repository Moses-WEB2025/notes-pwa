<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/note_sample_group"
    android:clipChildren="false"
    android:layout_width="70dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/note_sample_bottom"
        android:background="@drawable/note_sample_bottom_bg"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:layout_marginTop="2dp"
        android:alpha="0"
        android:transformPivotX="0px"
        android:transformPivotY="0px"
        android:rotation="10"
        android:layout_marginStart="17dp"/>
    <View
        android:id="@+id/note_sample_mid"
        android:background="@drawable/note_sample_mid_bg"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:alpha="0"
        android:transformPivotX="0px"
        android:transformPivotY="0px"
        android:rotation="-1"
        android:layout_marginStart="8dp"/>
    <View
        android:id="@+id/note_sample_top"
        android:background="@drawable/note_sample_top_bg"
        android:clipChildren="false"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:alpha="0"
        android:transformPivotX="0px"
        android:transformPivotY="0px"
        android:rotation="-10"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/note_group"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layerType="hardware">
    <com.miui.notes.component.PreviewImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image">
        <TextView
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingMultiplier="1.2"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/content_body"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"/>
        <com.miui.notes.component.OverviewThumbnailView
            android:orientation="vertical"
            android:id="@+id/overview_thumbnail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <com.miui.notes.component.MindThumbnailView
            android:orientation="vertical"
            android:id="@+id/mind_thumbnail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bar"
            android:paddingTop="@dimen/v12_item_grid_label_margin_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/v12_item_grid_padding_bottom">
            <TextView
                android:textAppearance="@style/V8.TextAppearance.List.Tertiary"
                android:ellipsize="marquee"
                android:id="@+id/time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:id="@+id/stick"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_data_item_stick"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:id="@+id/voice"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_data_item_audio"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:id="@+id/mind_map"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_data_item_mind_map"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:id="@+id/mind_outline"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_data_item_mind_outline"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:id="@+id/hand_write_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_data_item_hand_write"
                android:layout_marginEnd="6dp"/>
            <ImageView
                android:id="@+id/alarm"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_data_item_clock"/>
        </LinearLayout>
    </LinearLayout>
    <CheckBox
        android:theme="@style/Note.MultiCheckBox"
        android:layout_gravity="end|bottom"
        android:id="@android:id/checkbox"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grid_checkbox_margin_bottom"
        android:layout_marginEnd="@dimen/grid_checkbox_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/generating_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ai_window_webview_height"
    android:layout_marginHorizontal="@dimen/ai_floating_window_margin_horizontal">
    <WebView
        android:scrollbarThumbVertical="@drawable/miuix_appcompat_scrollbar_thumb_vertical"
        android:scrollbarStyle="outsideOverlay"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ai_webview"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_above="@+id/ai_done_tab"
        android:layout_marginHorizontal="@dimen/ai_generating_web_view_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/ai_done_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.miui.notes.ai.ui.AiWaterMarkView
        android:id="@+id/ai_water_mark_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ai_done_tab"
        android:layout_marginHorizontal="@dimen/ai_generating_web_view_margin_horizontal"/>
    <ImageView
        android:id="@+id/ai_error_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ai_widget_error"
        app:layout_constraintBottom_toTopOf="@+id/ai_done_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ai_done_tab"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ai_stop_button_margin_bottom"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="@dimen/ai_done_tab_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.miui.notes.ai.ui.material.MaterialEffectContainer
            android:layout_gravity="bottom"
            android:id="@+id/container_generating_stop"
            android:alpha="0"
            app:material_blend_colors="@array/ai_panel_widget_blend_colors"
            app:material_blend_modes="@array/ai_panel_widget_blend_modes"
            app:material_blur_radius="@dimen/ai_material_blur_radius"
            app:material_corner_radius="@dimen/ai_tab_corner_radius"
            app:material_default_bg_color="@color/ai_widget_default_bg_color"
            app:material_shadow_color="@color/ai_widget_shadow_color_default"
            app:material_shadow_radius="50"
            app:material_shadow_y="15"
            app:material_stroke_colors="@array/ai_button_gradient_border_colors"
            app:material_stroke_width="@dimen/ai_widget_border_width"
            style="@style/AiLoadingStopButtonStyle">
            <TextView
                android:textSize="@dimen/ai_text_size"
                android:textStyle="bold"
                android:textColor="@color/btn_generating_stop_color"
                android:gravity="center"
                android:id="@+id/btn_generating_stop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/ai_generate_stop_button"
                android:fontFamily="sans-serif-medium"/>
        </com.miui.notes.ai.ui.material.MaterialEffectContainer>
        <com.miui.notes.ai.ui.material.MaterialEffectContainer
            android:id="@+id/ai_back"
            app:material_blend_colors="@array/ai_panel_widget_blend_colors"
            app:material_blend_modes="@array/ai_panel_widget_blend_modes"
            app:material_blur_radius="@dimen/ai_material_blur_radius"
            app:material_corner_radius="@dimen/ai_tab_corner_radius"
            app:material_default_bg_color="@color/ai_widget_default_bg_color"
            app:material_shadow_color="@color/ai_widget_shadow_color_default"
            app:material_shadow_radius="50"
            app:material_shadow_y="15"
            app:material_stroke_colors="@array/ai_button_gradient_border_colors"
            app:material_stroke_width="@dimen/ai_widget_border_width"
            style="@style/AiWidgetButtomItemStyle">
            <com.miui.notes.ai.ui.AiButtomItem
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ai_back_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:item_src="@drawable/ai_back_icon"
                app:item_text="@string/ai_text_widget_return"/>
        </com.miui.notes.ai.ui.material.MaterialEffectContainer>
        <com.miui.notes.ai.ui.material.MaterialEffectContainer
            android:id="@+id/ai_refesh"
            app:material_blend_colors="@array/ai_panel_widget_blend_colors"
            app:material_blend_modes="@array/ai_panel_widget_blend_modes"
            app:material_blur_radius="@dimen/ai_material_blur_radius"
            app:material_corner_radius="@dimen/ai_tab_corner_radius"
            app:material_default_bg_color="@color/ai_widget_default_bg_color"
            app:material_shadow_color="@color/ai_widget_shadow_color_default"
            app:material_shadow_radius="50"
            app:material_shadow_y="15"
            app:material_stroke_colors="@array/ai_button_gradient_border_colors"
            app:material_stroke_width="@dimen/ai_widget_border_width"
            style="@style/AiWidgetButtomItemStyle">
            <com.miui.notes.ai.ui.AiButtomItem
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ai_refresh_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:item_src="@drawable/ai_refesh_icon"
                app:item_text="@string/ai_text_widget_rebuild"/>
        </com.miui.notes.ai.ui.material.MaterialEffectContainer>
        <com.miui.notes.ai.ui.material.MaterialEffectContainer
            android:id="@+id/ai_copy"
            app:material_blend_colors="@array/ai_panel_widget_blend_colors"
            app:material_blend_modes="@array/ai_panel_widget_blend_modes"
            app:material_blur_radius="@dimen/ai_material_blur_radius"
            app:material_corner_radius="@dimen/ai_tab_corner_radius"
            app:material_default_bg_color="@color/ai_widget_default_bg_color"
            app:material_shadow_color="@color/ai_widget_shadow_color_default"
            app:material_shadow_radius="50"
            app:material_shadow_y="15"
            app:material_stroke_colors="@array/ai_button_gradient_border_colors"
            app:material_stroke_width="@dimen/ai_widget_border_width"
            style="@style/AiWidgetButtomItemStyle">
            <com.miui.notes.ai.ui.AiButtomItem
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:item_src="@drawable/ai_copy_icon"
                app:item_text="@string/ai_text_widget_copy"/>
        </com.miui.notes.ai.ui.material.MaterialEffectContainer>
        <com.miui.notes.ai.ui.material.MaterialEffectContainer
            android:id="@+id/ai_insert"
            app:material_blend_colors="@array/ai_panel_widget_blend_colors"
            app:material_blend_modes="@array/ai_panel_widget_blend_modes"
            app:material_blur_radius="@dimen/ai_material_blur_radius"
            app:material_corner_radius="@dimen/ai_tab_corner_radius"
            app:material_default_bg_color="@color/ai_widget_default_bg_color"
            app:material_shadow_color="@color/ai_widget_shadow_color_default"
            app:material_shadow_radius="50"
            app:material_shadow_y="15"
            app:material_stroke_colors="@array/ai_button_gradient_border_colors"
            app:material_stroke_width="@dimen/ai_widget_border_width"
            style="@style/AiWidgetButtomItemStyle">
            <com.miui.notes.ai.ui.AiButtomItem
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:item_src="@drawable/ai_insert_icon"
                app:item_text="@string/ai_insert_original_text"/>
        </com.miui.notes.ai.ui.material.MaterialEffectContainer>
        <com.miui.notes.ai.ui.material.MaterialEffectContainer
            android:id="@+id/ai_done"
            app:material_blend_colors="@array/ai_panel_widget_blend_colors"
            app:material_blend_modes="@array/ai_panel_widget_blend_modes"
            app:material_blur_radius="@dimen/ai_material_blur_radius"
            app:material_corner_radius="@dimen/ai_tab_corner_radius"
            app:material_default_bg_color="@color/ai_widget_default_bg_color"
            app:material_shadow_color="@color/ai_widget_shadow_color_default"
            app:material_shadow_radius="50"
            app:material_shadow_y="15"
            app:material_stroke_colors="@array/ai_button_gradient_border_colors"
            app:material_stroke_width="@dimen/ai_widget_border_width"
            style="@style/AiWidgetButtomItemStyle">
            <com.miui.notes.ai.ui.AiButtomItem
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:item_src="@drawable/ai_complete_icon"
                app:item_text="@string/ai_text_widget_finish"/>
        </com.miui.notes.ai.ui.material.MaterialEffectContainer>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/color_picker_slider"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="@dimen/creation_color_picker_view_page_slider_width"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/creation_color_picker_view_page_margin_top"
        android:layout_marginStart="@dimen/creation_color_picker_view_page_slider_margin_start">
        <TextView
            android:textSize="@dimen/creation_color_picker_view_page_text_size"
            android:id="@+id/slider_hue_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/creation_color_picker_view_page_text_hue"
            android:importantForAccessibility="yes"/>
        <com.miui.handwriting.common.view.colorpicker.ColorPickerHueView
            android:id="@+id/slider_hue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creation_color_picker_view_page_slider_seek_bar_height"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_slider_seek_bar_margin_top"
            android:thumb="@drawable/color_picker_thumb"
            android:contentDescription="@string/creation_color_picker_view_page_text_hue"
            android:splitTrack="false"/>
        <TextView
            android:textSize="@dimen/creation_color_picker_view_page_text_size"
            android:id="@+id/slider_saturation_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_slider_text_margin_top"
            android:text="@string/creation_color_picker_view_page_text_saturation"
            android:importantForAccessibility="yes"/>
        <com.miui.handwriting.common.view.colorpicker.ColorPickerSaturationView
            android:id="@+id/slider_saturation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creation_color_picker_view_page_slider_seek_bar_height"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_slider_seek_bar_margin_top"
            android:thumb="@drawable/color_picker_thumb"
            android:contentDescription="@string/creation_color_picker_view_page_text_saturation"
            android:splitTrack="false"/>
        <TextView
            android:textSize="@dimen/creation_color_picker_view_page_text_size"
            android:id="@+id/slider_lightness_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_slider_text_margin_top"
            android:text="@string/creation_color_picker_view_page_text_lightness"
            android:importantForAccessibility="yes"/>
        <com.miui.handwriting.common.view.colorpicker.ColorPickerLightnessView
            android:id="@+id/slider_lightness"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creation_color_picker_view_page_slider_seek_bar_height"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_slider_seek_bar_margin_top"
            android:thumb="@drawable/color_picker_thumb"
            android:contentDescription="@string/creation_color_picker_view_page_text_lightness"
            android:splitTrack="false"/>
    </LinearLayout>
</LinearLayout>

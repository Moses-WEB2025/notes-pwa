<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/note_full_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/module_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_float_full_view_note_head_padding_top"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp">
        <ImageView
            android:id="@+id/iv_data_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pad_fw_create_btn"
            android:scaleType="centerCrop"
            android:contentDescription="@string/menu_add_description"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/note_toggle_region"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/float_note_title"
                android:layout_marginStart="12dp"/>
            <ImageView
                android:id="@+id/iv_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pad_ic_fw_data_switch"
                android:layout_marginStart="2.9dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/continuous_excerpt"
            android:background="@drawable/float_excerpt_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:minHeight="36dp"
            android:paddingEnd="20dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_excerpt_icon"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/continuous_excerpt_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/excerpt"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/module_head">
        <miuix.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <miuix.miuixbasewidget.widget.EmptyStateView
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/blankview_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/float_data_blank_view_height"
            android:title="@string/data_empty_note"/>
    </LinearLayout>
    <include
        android:id="@+id/invisible_card_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/float_note_list_fake_item"/>
</RelativeLayout>

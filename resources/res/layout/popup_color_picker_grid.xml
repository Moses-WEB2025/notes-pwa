<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/color_picker_grid"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/creation_color_picker_view_page_text_size"
            android:textColor="@color/creation_more_popwindow_item_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/creation_color_picker_view_page_text_hue"
            android:importantForAccessibility="yes"
            android:layout_marginStart="@dimen/creation_color_picker_view_page_grid_text_margin_start"/>
        <com.miui.handwriting.common.view.colorpicker.ColorPickPanelView
            android:id="@+id/color_picker_panel"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="@dimen/creation_color_picker_view_page_grid_panel_width"
            android:layout_height="@dimen/creation_color_picker_view_page_grid_panel_height"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_grid_panel_margin_top"
            android:importantForAccessibility="yes"/>
    </LinearLayout>
</LinearLayout>

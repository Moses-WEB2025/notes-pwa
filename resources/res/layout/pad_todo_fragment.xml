<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/pad_common_bg_color"
        android:visibility="visible"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/todo_search_result_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/pc_text_common_color"
                android:id="@+id/todo_search_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"/>
            <View
                android:background="#0d000000"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:id="@+id/tv_category_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pad_todo_right_list_item_margin_start"
            android:layout_marginEnd="@dimen/pad_todo_right_list_item_margin_end"/>
        <com.miui.common.view.RoundClipLayout
            android:id="@+id/list_container"
            android:paddingTop="@dimen/pad_todo_right_list_margin_top"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:topLeftRadius="@dimen/pad_common_radius"
            android:topRightRadius="@dimen/pad_common_radius">
            <miuix.springback.view.SpringBackLayout
                android:id="@+id/scrollable_view_drawer"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scrollOrientation="vertical"
                app:scrollableView="@+id/recycler_view">
                <com.miui.todo.base.ProTodoRecyclerView
                    android:id="@+id/recycler_view"
                    android:paddingBottom="@dimen/pad_list_padding_bottom"
                    android:visibility="visible"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </miuix.springback.view.SpringBackLayout>
        </com.miui.common.view.RoundClipLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/sv_blank"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <miuix.miuixbasewidget.widget.EmptyStateView
            android:layout_gravity="center"
            android:id="@+id/todo_list_blank_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.miui.notes.ui.widget.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/todo_add"
        android:layout_width="@dimen/floating_action_button_size"
        android:layout_height="@dimen/floating_action_button_size"
        android:layout_marginBottom="@dimen/pad_floating_action_bar_margin_bottom"
        android:src="@drawable/ic_content_add"
        android:contentDescription="@string/todo_menu_add_description"
        android:layout_marginEnd="@dimen/pad_floating_action_bar_margin_end"
        app:fabShadowEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Note.FloatingActionButton"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/dialog_root_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/pad_pop_menu_bg_color"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/menu_container"
                android:background="@drawable/pad_note_pop_menu_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="186dp">
                <TextView
                    android:enabled="true"
                    android:textSize="@dimen/pop_menu_item_text_size"
                    android:textColor="@color/pad_note_popmenu_item_text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/chooser_gallery"
                    android:background="@drawable/pad_note_pop_menu_item_head_bg"
                    android:paddingTop="24dp"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pad_insert_image_menu_select_from_pad_gallery"
                    android:fontFamily="mipro-medium"
                    android:paddingStart="27dp"
                    android:paddingEnd="27dp"/>
                <TextView
                    android:enabled="true"
                    android:textSize="@dimen/pop_menu_item_text_size"
                    android:textColor="@color/pad_note_popmenu_item_text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/chooser_camera"
                    android:background="@drawable/pad_note_pop_menu_item_bg"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pad_insert_image_menu_take_photo_by_pad"
                    android:fontFamily="mipro-medium"
                    android:paddingStart="27dp"
                    android:paddingEnd="27dp"/>
                <TextView
                    android:textSize="@dimen/pop_menu_item_text_size"
                    android:textColor="@color/pad_note_popmenu_item_text_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/chooser_phone_camera"
                    android:background="@drawable/pad_note_pop_menu_item_bg"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pad_insert_image_menu_take_photo_by_phone"
                    android:fontFamily="mipro-medium"
                    android:paddingStart="27dp"
                    android:paddingEnd="27dp"/>
            </LinearLayout>
        </ScrollView>
    </com.miui.support.cardview.CardView>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/test_id"
        android:visibility="gone"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_alignBottom="@+id/content"
        android:layout_alignEnd="@+id/content"
        android:elevation="10dp"
        app:lottie_autoPlay="true"
        app:lottie_fileName="point.json"/>
</FrameLayout>

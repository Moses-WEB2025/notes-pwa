<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/home"
        style="@style/ActionBarIconStyle"/>
    <View
        android:id="@+id/blank_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/v12_notes_edit_header_ic_size"
        android:layout_weight="1"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/end_menu_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/undo"
            android:visibility="gone"
            android:contentDescription="@string/toolbar_undo_description"
            style="@style/ActionBarIconStyle"/>
        <ImageView
            android:id="@+id/redo"
            android:visibility="gone"
            android:contentDescription="@string/toolbar_redo_description"
            android:layout_marginStart="@dimen/v12_notes_edit_header_ic_margin"
            style="@style/ActionBarIconStyle"/>
        <ImageView
            android:id="@+id/mode"
            android:layout_marginStart="@dimen/v12_notes_edit_header_ic_margin"
            style="@style/ActionBarIconStyle"/>
        <ImageView
            android:id="@+id/more"
            android:contentDescription="@string/menu_more_description"
            android:layout_marginStart="@dimen/v12_notes_edit_header_ic_margin"
            style="@style/ActionBarIconStyle"/>
    </LinearLayout>
</LinearLayout>

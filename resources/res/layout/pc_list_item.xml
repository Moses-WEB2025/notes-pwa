<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/folder"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <TextView
        android:textAppearance="@style/V12.PC.TextAppearance.List.Secondary"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pc_module_notes_name"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="24dp"
        android:layout_alignParentStart="true"/>
    <RelativeLayout
        android:id="@+id/edit_container"
        android:background="@drawable/pc_edit_folder_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp">
        <androidx.appcompat.widget.AppCompatEditText
            android:theme="@style/NoteTheme.PcRoot"
            android:textAppearance="@style/V12.PC.TextAppearance.List.Secondary"
            android:textColorHighlight="#33ffb005"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/edit_title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:textCursorDrawable="@drawable/pc_todo_editor_cursor"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="24dp"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</RelativeLayout>

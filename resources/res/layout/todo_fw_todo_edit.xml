<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/NoteTheme.TodoEdit"
    android:background="@drawable/todo_child_item_edit_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_editor_panel"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:id="@+id/bottom_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/todo_fw_edit_margin_top"
            android:baselineAligned="false"
            android:splitMotionEvents="false"
            android:layout_marginStart="@dimen/todo_fw_edit_bottom_menu_inner_margin_start"
            android:layout_marginEnd="@dimen/todo_fw_edit_bottom_menu_inner_margin_start">
            <com.miui.todo.view.ChildClickableFrameLayout
                android:layout_gravity="top"
                android:id="@+id/editor_audio_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/todo_fw_editor"/>
            </com.miui.todo.view.ChildClickableFrameLayout>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/group_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/todo_fw_edit_toolbar_padding_top"
                android:layout_marginBottom="@dimen/todo_fw_edit_toolbar_padding_bottom"
                android:layout_marginStart="@dimen/todo_fw_edit_bottom_menu_inner_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/send_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/group_tag_custom"
                    android:background="@drawable/compose_todo_editor_tag_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:paddingEnd="2dp"
                    app:layout_constrainedWidth="true">
                    <ImageView
                        android:id="@+id/iv_tag_custom"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_todo_edit_remind"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="12dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/todo_edit_remind_color"
                        android:id="@+id/tv_tag_custom"
                        android:paddingTop="6dp"
                        android:paddingBottom="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/todo_fw_edit_max_width"
                        android:text="@string/todo_edit_btn_custom"
                        android:contentDescription="@string/todo_edit_btn_custom"
                        android:paddingStart="6dp"
                        android:paddingEnd="12dp"/>
                    <View
                        android:id="@+id/v_tag_divider"
                        android:background="@color/divider_line"
                        android:visibility="gone"
                        android:layout_width="1.5dp"
                        android:layout_height="10.2dp"/>
                    <ImageView
                        android:id="@+id/iv_tag_cancel"
                        android:background="@drawable/ic_todo_edit_remind_cancel"
                        android:visibility="gone"
                        android:layout_width="@dimen/ic_52px_size"
                        android:layout_height="@dimen/ic_52px_size"
                        android:contentDescription="@string/todo_edit_btn_cancel_remind"
                        android:layout_marginStart="5.5dp"
                        android:layout_marginEnd="9dp"/>
                </LinearLayout>
            </FrameLayout>
            <Button
                android:enabled="false"
                android:textSize="16dp"
                android:textColor="@color/todo_edit_done_color"
                android:gravity="end|center_vertical"
                android:id="@+id/send_button"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="80dp"
                android:text="@string/todo_edit_btn_done"
                android:contentDescription="@string/todo_edit_btn_done"
                android:fontFamily="miui-bold"
                android:layoutDirection="locale"
                android:layout_marginEnd="@dimen/todo_fw_edit_bottom_menu_inner_margin_start"
                app:layout_constraintBottom_toBottomOf="@+id/group_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/group_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:paddingTop="@dimen/todo_edit_toolbar_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        layout="@layout/fw_toast_notification"/>
    <TextView
        android:textSize="@dimen/bubble_text_size"
        android:textColor="@color/countdown_view_text_color"
        android:id="@+id/tv_audio_countdown"
        android:background="@drawable/countdown_view_backgound"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
</RelativeLayout>

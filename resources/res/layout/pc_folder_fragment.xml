<?xml version="1.0" encoding="utf-8"?>
<com.miui.pc.frame.BaseLeftLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/left_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/navi_group"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/create_region"
            android:background="@drawable/pc_create_note_background"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="24dp">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/create_note_region"
                android:layout_width="138dp"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/ic_create_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pc_create_note"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_action_create_new_note"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/ic_create_note"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/create_more_region"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ic_create_more"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/pc_create_more"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/more"
                    android:layout_marginEnd="24dp"/>
            </RelativeLayout>
        </LinearLayout>
        <com.miui.pc.view.ExpandableRecyclerView
            android:id="@+id/pc_folder_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_below="@+id/create_region"/>
        <com.miui.pc.view.ExpandableRecyclerView
            android:id="@+id/pc_todo_type_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/pc_folder_list"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.miui.pc.view.SearchInputEditText
                android:textSize="14dp"
                android:textColorHighlight="#33ffb005"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/search_input"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/pc_todo_editor_cursor"
                android:paddingStart="8dp"
                android:paddingEnd="9dp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/note_list_lane"
        android:background="@drawable/pc_create_menu_background"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/pc_text_appearance_list_secondary_text_color"
            android:ellipsize="end"
            android:id="@+id/pc_folder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:maxLines="1"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"/>
        <View
            android:id="@+id/divider"
            android:background="#0d000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/no_note_hint"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#33000000"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="310dp"
                    android:text="@string/new_data_empty_note"/>
            </FrameLayout>
            <com.miui.pc.frame.PcBaseNoteRecyclerView
                android:scrollbarSize="12dp"
                android:scrollbarThumbVertical="@drawable/pc_scroll_bar_background"
                android:id="@+id/pc_note_list"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
</com.miui.pc.frame.BaseLeftLayout>

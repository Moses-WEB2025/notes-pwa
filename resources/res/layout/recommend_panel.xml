<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/recommend_icon_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <miuix.cardview.HyperCardView
        android:id="@+id/container_recommend_2"
        android:layout_marginBottom="@dimen/ai_recommend_item_margin_bottom"
        android:shadowColor="@color/ai_recommend_input_shadow_color"
        android:shadowDy="@dimen/ai_recommend_bubble_shadow_dy"
        android:shadowRadius="@dimen/ai_recommend_bubble_shadow_radius"
        app:cardBackgroundColor="@color/ai_recommend_tag_default_bg_color"
        app:cardBlendColorModes="@array/ai_material_default_blend_modes"
        app:cardBlendColors="@array/ai_recommend_bubble_blend_colors"
        app:cardCornerRadius="@dimen/ai_recommend_tab_corner_radius"
        app:miuix_blurRadius="@dimen/ai_material_blur_radius"
        app:miuix_blurSelfBackground="true"
        app:miuix_strokeGradientColors="@array/ai_button_gradient_border_colors"
        app:miuix_strokeWidth="@dimen/ai_recommend_tag_border_width"
        style="@style/AiRecommendItemStyle">
        <com.miui.notes.ai.ui.AiRecommendItem
            android:orientation="horizontal"
            android:id="@+id/ai_recommend_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:recommend_item_src="@drawable/ai_comma_icon"
            app:recommend_item_text="测试推荐语1"/>
    </miuix.cardview.HyperCardView>
    <miuix.cardview.HyperCardView
        android:id="@+id/container_recommend_1"
        android:layout_marginBottom="@dimen/ai_recommend_item_margin_bottom"
        android:shadowColor="@color/ai_recommend_input_shadow_color"
        android:shadowDy="@dimen/ai_recommend_bubble_shadow_dy"
        android:shadowRadius="@dimen/ai_recommend_bubble_shadow_radius"
        app:cardBackgroundColor="@color/ai_recommend_tag_default_bg_color"
        app:cardBlendColorModes="@array/ai_material_default_blend_modes"
        app:cardBlendColors="@array/ai_recommend_bubble_blend_colors"
        app:cardCornerRadius="@dimen/ai_recommend_tab_corner_radius"
        app:miuix_blurRadius="@dimen/ai_material_blur_radius"
        app:miuix_blurSelfBackground="true"
        app:miuix_strokeGradientColors="@array/ai_button_gradient_border_colors"
        app:miuix_strokeWidth="@dimen/ai_recommend_tag_border_width"
        style="@style/AiRecommendItemStyle">
        <com.miui.notes.ai.ui.AiRecommendItem
            android:orientation="horizontal"
            android:id="@+id/ai_recommend_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:recommend_item_src="@drawable/ai_comma_icon"
            app:recommend_item_text="测试推荐语2"/>
    </miuix.cardview.HyperCardView>
    <miuix.cardview.HyperCardView
        android:id="@+id/container_recommend_0"
        android:layout_marginBottom="@dimen/ai_recommend_item_margin_bottom_last"
        android:shadowColor="@color/ai_recommend_input_shadow_color"
        android:shadowDy="@dimen/ai_recommend_bubble_shadow_dy"
        android:shadowRadius="@dimen/ai_recommend_bubble_shadow_radius"
        app:cardBackgroundColor="@color/ai_recommend_tag_default_bg_color"
        app:cardBlendColorModes="@array/ai_material_default_blend_modes"
        app:cardBlendColors="@array/ai_recommend_bubble_blend_colors"
        app:cardCornerRadius="@dimen/ai_recommend_tab_corner_radius"
        app:miuix_blurRadius="@dimen/ai_material_blur_radius"
        app:miuix_blurSelfBackground="true"
        app:miuix_strokeGradientColors="@array/ai_button_gradient_border_colors"
        app:miuix_strokeWidth="@dimen/ai_recommend_tag_border_width"
        style="@style/AiRecommendItemStyle">
        <com.miui.notes.ai.ui.AiRecommendItem
            android:id="@+id/ai_recommend_0"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:recommend_item_src="@drawable/ai_comma_icon"
            app:recommend_item_text="测试推荐语3"/>
    </miuix.cardview.HyperCardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="@dimen/ai_floating_window_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ai_floating_window_input_margin_bottom">
        <FrameLayout
            android:id="@+id/recommend_input_rim_effect_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <miuix.cardview.HyperCardView
            android:id="@+id/recommend_input_content_view"
            android:layout_width="@dimen/ai_floating_window_input_width"
            android:layout_height="wrap_content"
            android:shadowColor="@color/ai_recommend_input_shadow_color"
            android:shadowDy="@dimen/ai_recommend_input_shadow_dy"
            android:shadowRadius="@dimen/ai_recommend_input_shadow_radius"
            android:layout_marginVertical="@dimen/ai_recommend_layout_edit_margin_vertical"
            app:cardBackgroundColor="@color/ai_recommend_search_default_bg_color"
            app:cardBlendColorModes="@array/ai_material_default_blend_modes"
            app:cardBlendColors="@array/ai_widget_blend_colors"
            app:cardCornerRadius="@dimen/ai_input_corner_radius"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:material_binding_render_mode="dark"
            app:material_blend_colors="@array/ai_input_send_blend_colors"
            app:material_blend_modes="@array/ai_material_default_blend_modes"
            app:material_blur_radius="@dimen/ai_material_blur_radius"
            app:material_corner_radius="@dimen/ai_input_send_corner_radius"
            app:material_default_bg_color="@color/ai_input_send_default_color"
            app:material_shadow_color="@color/ai_recommend_send_shadow_color"
            app:material_shadow_radius="100"
            app:material_shadow_y="40"
            app:material_stroke_colors="@array/ai_send_button_gradient_border_colors"
            app:material_stroke_width="@dimen/ai_widget_border_width"
            app:miuix_blurRadius="@dimen/ai_material_blur_radius"
            app:miuix_blurSelfBackground="true"
            app:miuix_strokeGradientColors="@array/ai_input_gradient_border_colors"
            app:miuix_strokeWidth="@dimen/ai_input_border_width">
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/input_recommend_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.miui.notes.ai.ui.fold.utils.InputIconImageView
                    android:id="@+id/ai_recommend_icon_image"
                    android:layout_width="@dimen/ai_input_icon_size"
                    android:layout_height="@dimen/ai_input_icon_size"
                    android:src="@drawable/icon_ai_search"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ai_input_icon_margin_start"/>
                <com.miui.notes.ai.ui.CustomAiTextWidgetEditText
                    android:textAppearance="?android:attr/textAppearanceLargeInverse"
                    android:textSize="@dimen/ai_recommend_layout_edit_text_size"
                    android:textColor="@color/ai_input_text_color"
                    android:textColorHint="@color/ai_hint_text_color"
                    android:id="@+id/ai_recommend_edit"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="@dimen/ai_recommend_layout_edit_max_height"
                    android:minHeight="@dimen/ai_recommend_layout_edit_min_height"
                    android:hint="@string/ai_search_hint_text"
                    android:maxLength="5000"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:inputType="textMultiLine"
                    android:imeOptions="flagNoFullscreen"
                    android:textSelectHandleLeft="@drawable/edit_select_handle_left"
                    android:textSelectHandleRight="@drawable/edit_select_handle_right"
                    android:textSelectHandle="@drawable/edit_select_handle_middle"
                    android:textCursorDrawable="@drawable/ai_edit_cursor_color"
                    android:layout_marginStart="@dimen/ai_recommend_layout_edit_margin_start"
                    android:layout_marginEnd="@dimen/ai_recommend_layout_edit_margin_end"
                    android:layout_toStartOf="@+id/ai_recommend_send_icon"
                    android:layout_toEndOf="@+id/ai_recommend_icon_image"
                    style="@style/NoUnderlineEditText"/>
                <com.miui.notes.ai.ui.material.MaterialEffectContainer
                    android:id="@+id/ai_recommend_DeepSeek_container"
                    android:background="@drawable/ai_deepseek_button_background"
                    android:paddingTop="@dimen/ai_deepseek_padding_top"
                    android:paddingBottom="@dimen/ai_deepseek_padding_bottom"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ai_recommend_layout_send_icon_margin_bottom"
                    android:layout_below="@+id/ai_recommend_edit"
                    android:paddingStart="@dimen/ai_deepseek_padding_left"
                    android:paddingEnd="@dimen/ai_deepseek_padding_right"
                    android:layout_marginStart="@dimen/ai_recommend_layout_ai_icon_start"
                    app:material_binding_render_mode="dark"
                    app:material_blend_colors="@array/ai_input_send_blend_colors"
                    app:material_blend_modes="@array/ai_material_default_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_input_send_corner_radius"
                    app:material_default_bg_color="@color/ai_input_send_default_color"
                    app:material_shadow_color="@color/ai_recommend_send_shadow_color"
                    app:material_shadow_radius="100"
                    app:material_shadow_y="40"
                    app:material_stroke_colors="@array/ai_send_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width">
                    <ImageView
                        android:id="@+id/ai_recommend_icon"
                        android:background="@drawable/ai_deepseek_button_seletor"
                        android:layout_width="@dimen/ai_recommend_layout_ai_icon_size"
                        android:layout_height="@dimen/ai_recommend_layout_ai_icon_size"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="@dimen/ai_recommend_layout_ai_DeepSeek_button_textSize"
                        android:textColor="@color/ai_input_text_color"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/ai_recommend_button_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_DeepSeek_button_text"
                        android:fontFamily="mipro-medium"
                        android:layout_marginStart="@dimen/ai_recommend_layout_ai_icon_text_left"/>
                </com.miui.notes.ai.ui.material.MaterialEffectContainer>
                <com.miui.notes.ai.ui.material.MaterialEffectContainer
                    android:id="@+id/ai_recommend_send_icon"
                    android:background="@drawable/ai_deepseek_button_background"
                    android:layout_width="@dimen/ai_recommend_layout_send_icon_width"
                    android:layout_height="@dimen/ai_recommend_layout_send_icon_height"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/ai_recommend_layout_send_icon_margin_right"
                    android:layout_alignParentEnd="true"
                    app:material_binding_render_mode="dark"
                    app:material_blend_colors="@array/ai_input_send_blend_colors"
                    app:material_blend_modes="@array/ai_material_default_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_input_send_corner_radius"
                    app:material_default_bg_color="@color/ai_input_send_default_color"
                    app:material_shadow_color="@color/ai_recommend_send_shadow_color"
                    app:material_shadow_radius="100"
                    app:material_shadow_y="40"
                    app:material_stroke_colors="@array/ai_send_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ai_recommend_send_icon_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ai_input_send_icon"
                        android:contentDescription="@string/ai_recommend_send_icon_talkback_text"/>
                </com.miui.notes.ai.ui.material.MaterialEffectContainer>
            </RelativeLayout>
        </miuix.cardview.HyperCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:background="?attr/preferenceItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Preference.PreferenceScreen">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/guide_img"
        android:layout_width="277.7734dp"
        android:layout_height="277.7734dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="quick_note_guide.json"
        app:lottie_repeatCount="-1"/>
    <TextView
        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Secondary.Preference"
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:maxLines="10"
        android:layout_alignStart="@android:id/title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>

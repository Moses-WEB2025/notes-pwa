<?xml version="1.0" encoding="utf-8"?>
<com.miui.notes.ai.ui.FloatingDecorView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.notes.ai.ui.RenderViewLayout
        android:id="@+id/bg_effect_view_container"
        android:background="@color/miuix_color_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/floating_view"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <FrameLayout
            android:id="@+id/floating_rim_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/ai_panel_bright_edge_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <miuix.cardview.HyperCardView
            android:id="@+id/floating_content_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ai_panel_bright_edge_margin"
            android:minHeight="@dimen/ai_panel_card_min_height"
            android:shadowDy="@dimen/ai_panel_shadow_dy_zero"
            android:shadowRadius="@dimen/ai_panel_shadow_radius_none"
            app:cardBackgroundColor="@color/ai_panel_default_bg_color"
            app:cardBlendColorModes="@array/ai_panel_blend_modes"
            app:cardBlendColors="@array/ai_panel_blend_colors"
            app:cardCornerRadius="@dimen/ai_panel_card_corner_radius"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:miuix_blurRadius="@dimen/ai_panel_blur_radius"
            app:miuix_blurSelfBackground="true"
            app:miuix_strokeGradientColors="@array/ai_panel_gradient_border_colors"
            app:miuix_strokeWidth="@dimen/ai_panel_border_width">
            <com.miui.notes.ai.ui.fold.utils.FloatingWindowRelativeLayout
                android:clipChildren="false"
                android:layout_width="@dimen/ai_floating_window_width"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/ai_text_widget_actionbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/ai_text_widget_actionbar_layout"/>
                <com.miui.notes.ai.ui.fold.utils.FlagView
                    android:id="@+id/flag_view"
                    android:layout_width="@dimen/ai_floating_window_view_width"
                    android:layout_height="@dimen/ai_floating_window_view_height"
                    android:layout_below="@+id/ai_text_widget_actionbar"
                    android:layout_centerHorizontal="true"/>
                <ViewStub
                    android:id="@+id/stub_panel_layout"
                    android:layout="@layout/panel_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_panel_layout_margin_top"
                    android:layout_below="@+id/flag_view"/>
                <ViewStub
                    android:id="@+id/ai_generating_stub_layout"
                    android:layout="@layout/ai_generating_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ai_text_widget_actionbar"/>
            </com.miui.notes.ai.ui.fold.utils.FloatingWindowRelativeLayout>
        </miuix.cardview.HyperCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/recommend_panel_stub_layout"
        android:layout="@layout/recommend_panel"
        android:layout_width="@dimen/ai_recommend_pannel_width"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <include
        android:id="@+id/input_layout"
        android:layout_width="@dimen/ai_floating_window_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_floating_window_input_margin_top"
        android:layout_alignTop="@+id/floating_view"
        android:layout_centerHorizontal="true"
        layout="@layout/ai_input_layout"/>
</com.miui.notes.ai.ui.FloatingDecorView>

<?xml version="1.0" encoding="utf-8"?>
<com.xiaomi.passport.ui.view.FlexVerticalLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="28sp"
        android:textColor="@color/passport_input_code_notice_title"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="@string/passport_set_password_title"/>
    <com.xiaomi.passport.ui.view.EditTextGroupView
        android:id="@+id/password_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/passport_view_group_external_margin_vertical"
        app:passport_inputHintText="@string/passport_input_new_pwd"
        app:passport_inputTextType="password"/>
    <com.xiaomi.passport.ui.view.EditTextGroupView
        android:id="@+id/confirm_password_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/passport_view_group_internal_margin_vertical"
        app:passport_inputHintText="@string/passport_confirm_new_pwd"
        app:passport_inputTextType="password"/>
    <TextView
        android:id="@+id/password_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/passport_password_req_notice"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/passport_progress_percent_color"
        android:id="@+id/password_invalid_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="12dp"/>
    <Button
        android:id="@+id/btn_password_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/passport_completed"
        style="@style/PassportWidget.HighlightRoundButton"/>
</com.xiaomi.passport.ui.view.FlexVerticalLinearLayout>

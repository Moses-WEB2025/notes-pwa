<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/doodle_tools_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/unimmerse"
            android:background="@drawable/doodle_ic_action_unimmerse_mode"
            android:visibility="visible"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/doodle_action_exit_immersion_mode"
            android:alpha="0"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HeaderIconStyle"/>
        <com.miui.support.cardview.CardView
            android:id="@+id/panel_immerse_entry"
            android:layout_width="@dimen/palette_panel_size"
            android:layout_height="@dimen/palette_panel_size"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/doodle_action_show_tool_panel"
            android:layout_marginStart="@dimen/palette_panel_margin_start_full"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="@dimen/palette_panel_radius"
            app:cardElevation="8dp"
            app:contentPadding="@dimen/palette_panel_padding"
            app:layout_constraintBottom_toTopOf="@+id/palette_entry"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/panel_immerse_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"/>
        </com.miui.support.cardview.CardView>
        <com.miui.support.cardview.CardView
            android:id="@+id/palette_entry"
            android:layout_width="@dimen/palette_panel_size"
            android:layout_height="@dimen/palette_panel_size"
            android:layout_marginBottom="@dimen/palette_panel_margin_bottom_full"
            android:contentDescription="@string/doodle_palette"
            android:layout_marginStart="@dimen/palette_panel_margin_start_full"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="@dimen/palette_panel_radius"
            app:cardElevation="8dp"
            app:contentPadding="@dimen/palette_panel_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:id="@+id/palette_entry_color"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.miui.support.cardview.CardView>
        <include
            android:id="@+id/element_eraser_container"
            android:visibility="invisible"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/eraser_panel_margin_bottom_0"
            app:layout_constraintBottom_toTopOf="@+id/palette_entry"
            app:layout_constraintEnd_toEndOf="@+id/palette_entry"
            app:layout_constraintStart_toStartOf="@+id/palette_entry"
            layout="@layout/doodle_element_eraser_layout"/>
        <include
            android:id="@+id/pixel_eraser_container"
            android:visibility="invisible"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/eraser_panel_margin_bottom_1"
            app:layout_constraintBottom_toTopOf="@+id/element_eraser_container"
            app:layout_constraintEnd_toEndOf="@+id/element_eraser_container"
            app:layout_constraintStart_toStartOf="@+id/element_eraser_container"
            layout="@layout/doodle_pixel_eraser_layout"/>
        <View
            android:id="@+id/tool_panel_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/tool_panel_guideline_margin_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <include
            android:id="@+id/tool_background_container"
            android:visibility="gone"
            android:layout_width="218.18dp"
            android:layout_height="145.45dp"
            android:layout_marginBottom="29.09dp"
            android:layout_marginEnd="@dimen/pad_background_container_margin_full"
            app:layout_constraintBottom_toTopOf="@+id/tool_panel_container"
            app:layout_constraintEnd_toEndOf="parent"
            layout="@layout/doodle_background_layout"/>
        <include
            android:id="@+id/tool_panel_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tool_panel_container_margin_start_full"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/palette_entry"
            app:layout_constraintTop_toTopOf="@+id/tool_panel_guideline"
            layout="@layout/doodle_brushes_panel_full"/>
        <include
            android:id="@+id/palette_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/pad_panel_margin_bottom_full"
            android:layout_marginStart="@dimen/pad_panel_margin_full"
            android:layout_marginEnd="@dimen/pad_panel_margin_full"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/pad_doodle_palette_layout_full"/>
        <include
            android:id="@+id/brush_config_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:layout_marginStart="@dimen/panel_margin"
            android:layout_marginEnd="@dimen/panel_margin"
            app:layout_constraintBottom_toTopOf="@+id/tool_panel_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/doodle_brush_config_layout_full"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>

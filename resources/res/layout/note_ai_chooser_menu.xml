<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/dialog_root_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/pad_pop_menu_bg_color"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp">
        <ScrollView
            android:id="@+id/menu_scroll_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/menu_container"
                android:background="@drawable/pad_note_pop_menu_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="186dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ai_summary"
                    android:background="@drawable/pad_note_pop_menu_item_head_bg"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    style="@style/Widget.ListView.Item.Immersion">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_ai_summary"
                        android:layout_marginStart="@dimen/miuix_appcompat_popup_menu_item_padding_left"
                        android:layout_marginEnd="@dimen/miuix_appcompat_immersion_menu_icon_margin_end"/>
                    <TextView
                        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Immersion"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_summary"
                        android:singleLine="true"
                        android:contentDescription="@string/ai_summary"
                        android:fontFamily="sans-serif"
                        android:textAlignment="viewStart"
                        android:layout_marginEnd="@dimen/miuix_appcompat_popup_menu_item_padding_right"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ai_layout"
                    android:background="@drawable/pad_note_pop_menu_item_bg"
                    android:layout_width="match_parent"
                    style="@style/Widget.ListView.Item.Immersion">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_ai_layout"
                        android:layout_marginStart="@dimen/miuix_appcompat_popup_menu_item_padding_left"
                        android:layout_marginEnd="@dimen/miuix_appcompat_immersion_menu_icon_margin_end"/>
                    <TextView
                        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Immersion"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_layout"
                        android:singleLine="true"
                        android:contentDescription="@string/ai_layout"
                        android:fontFamily="sans-serif"
                        android:textAlignment="viewStart"
                        android:layout_marginEnd="@dimen/miuix_appcompat_popup_menu_item_padding_right"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ai_check"
                    android:background="@drawable/pad_note_pop_menu_item_bg"
                    android:layout_width="match_parent"
                    style="@style/Widget.ListView.Item.Immersion">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_ai_check"
                        android:layout_marginStart="@dimen/miuix_appcompat_popup_menu_item_padding_left"
                        android:layout_marginEnd="@dimen/miuix_appcompat_immersion_menu_icon_margin_end"/>
                    <TextView
                        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Immersion"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_check"
                        android:singleLine="true"
                        android:contentDescription="@string/ai_check"
                        android:fontFamily="sans-serif"
                        android:textAlignment="viewStart"
                        android:layout_marginEnd="@dimen/miuix_appcompat_popup_menu_item_padding_right"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ai_translate"
                    android:background="@drawable/pad_note_pop_menu_item_foot_bg"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    style="@style/Widget.ListView.Item.Immersion">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_ai_translate"
                        android:layout_marginStart="@dimen/miuix_appcompat_popup_menu_item_padding_left"
                        android:layout_marginEnd="@dimen/miuix_appcompat_immersion_menu_icon_margin_end"/>
                    <TextView
                        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Immersion"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_translate"
                        android:singleLine="true"
                        android:contentDescription="@string/ai_translate"
                        android:fontFamily="sans-serif"
                        android:textAlignment="viewStart"
                        android:layout_marginEnd="@dimen/miuix_appcompat_popup_menu_item_padding_right"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.miui.support.cardview.CardView>
</FrameLayout>

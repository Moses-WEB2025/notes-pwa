<?xml version="1.0" encoding="utf-8"?>
<com.miui.notes.ai.ui.AutoFloatingContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background"
        android:background="@color/ai_bg_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/content"
        android:background="@color/bottom_sheet_view_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_flag"/>
    <View
        android:id="@+id/bottom_flag"
        android:background="@color/ai_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</com.miui.notes.ai.ui.AutoFloatingContainer>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_root_view"
    android:background="@color/homepage_primary_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.nestedheader.widget.NestedHeaderLayout
        android:id="@+id/nested_header_layout"
        android:clipChildren="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:headerClose="true"
        app:headerView="@+id/search_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rangeOffset="0px"
        app:scrollableView="@+id/scrollable_view_drawer"
        app:stickyView="@+id/sticky_view"
        app:triggerView="@+id/micloud_state_view">
        <include
            android:id="@+id/micloud_state_view"
            layout="@layout/miuix_appcompat_micloud_state_view"/>
        <miuix.springback.view.SpringBackLayout
            android:id="@+id/scrollable_view_drawer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scrollOrientation="vertical"
            app:scrollableView="@+id/recycler_view">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/sv_blank"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <miuix.miuixbasewidget.widget.EmptyStateView
                    android:icon="@drawable/note_blank_icon"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/phone_note_list_blank_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/phone_note_blank_view_margin_top"
                    android:title="@string/data_empty_note"/>
            </androidx.core.widget.NestedScrollView>
            <com.miui.notes.ui.view.BaseNoteRecyclerView
                android:id="@+id/recycler_view"
                android:paddingTop="@dimen/data_list_padding_top"
                android:paddingBottom="58dp"
                android:visibility="visible"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </miuix.springback.view.SpringBackLayout>
        <include
            android:id="@+id/search_bar"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/miuix_appcompat_search_stub"/>
        <FrameLayout
            android:id="@+id/sticky_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/data_folder_list_layout"/>
        </FrameLayout>
    </miuix.nestedheader.widget.NestedHeaderLayout>
    <com.miui.notes.ui.widget.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/note_add"
        android:layout_width="@dimen/floating_action_button_size"
        android:layout_height="@dimen/floating_action_button_size"
        android:layout_marginBottom="@dimen/floating_action_bar_margin_bottom"
        android:src="@drawable/ic_content_add"
        android:contentDescription="@string/menu_add_description"
        android:layout_marginEnd="@dimen/floating_action_bar_margin_end"
        app:fabColor="@color/subfolder_actionbar_background_color1"
        app:fabShadowEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/handwrite_add"/>
    <com.miui.notes.ui.widget.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/handwrite_add"
        android:visibility="gone"
        android:layout_width="@dimen/floating_action_button_size"
        android:layout_height="@dimen/floating_action_button_size"
        android:layout_marginBottom="@dimen/floating_action_bar_margin_bottom"
        android:src="@drawable/pad_ic_create_hand_write_note"
        android:scaleType="centerInside"
        android:contentDescription="@string/menu_add_handwrite_description"
        android:layout_marginEnd="@dimen/floating_action_bar_margin_end"
        app:fabColor="@color/subfolder_actionbar_background_color1"
        app:fabShadowEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ProgressBar
        android:id="@+id/frame_progress_bar"
        android:visibility="gone"
        android:layout_width="1px"
        android:layout_height="1px"
        android:indeterminate="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <miuix.miuixbasewidget.widget.EmptyStateView
        android:icon="@drawable/note_blank_icon"
        android:layout_gravity="center"
        android:id="@+id/pad_edit_blank_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="41dp"
        android:alpha="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sv_note_edit"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/editor_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <miuix.nestedheader.widget.NestedHeaderLayout
                android:id="@+id/nested_header_layout"
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scrollableView="@+id/content_container"
                app:triggerContentMinHeight="10dp"
                app:triggerView="@+id/note_folder_info">
                <include
                    android:id="@+id/note_folder_info"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/note_dir_indicator_bg_height"
                    android:layout_marginBottom="@dimen/notes_edit_header_margin_bottom"
                    android:layout_marginStart="@dimen/pad_note_edit_web_mind_content_horizontal_padding"
                    android:layout_marginEnd="@dimen/pad_note_edit_web_mind_content_horizontal_padding"
                    layout="@layout/note_edit_folder_layout"/>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_note_edit"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <miuix.springback.view.SpringBackLayout
                        android:id="@+id/content_container"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:scrollOrientation="vertical"
                        app:scrollableView="@+id/web_view">
                        <com.miui.hybirdeditor.RichEditorWebView
                            android:id="@+id/web_view"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:accessibilityTraversalAfter="@+id/note_add"/>
                    </miuix.springback.view.SpringBackLayout>
                </FrameLayout>
            </miuix.nestedheader.widget.NestedHeaderLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/content_mask"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/toolbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/edit_fragment_loading_color"
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_text"
            android:layout_below="@+id/progress_bar"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>

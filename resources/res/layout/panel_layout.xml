<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:id="@+id/polish_tab"
        android:scrollbars="none"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ai_item_layout"
                android:paddingBottom="@dimen/ai_tab_padding_bottom"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ai_tab_padding_start"
                android:paddingEnd="@dimen/ai_tab_padding_end">
                <com.miui.notes.ai.ui.fold.utils.AiWidgetTabItemMaterialEffectContainer
                    android:id="@+id/ai_summary_material_effect"
                    app:material_blend_colors="@array/ai_panel_widget_blend_colors"
                    app:material_blend_modes="@array/ai_panel_widget_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_tab_corner_radius"
                    app:material_default_bg_color="@color/ai_widget_default_bg_color"
                    app:material_shadow_color="@color/ai_widget_shadow_color_default"
                    app:material_shadow_radius="50"
                    app:material_shadow_y="15"
                    app:material_stroke_colors="@array/ai_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width"
                    style="@style/AiWidgetTabItemStyle">
                    <com.miui.notes.ai.ui.AiWidgetTabItem
                        android:orientation="vertical"
                        android:id="@+id/ai_summary"
                        android:paddingLeft="@dimen/ai_widget_tab_icon_margin_left"
                        android:paddingTop="@dimen/ai_widget_tab_icon_margin_top"
                        android:paddingRight="@dimen/ai_widget_tab_icon_margin_right"
                        android:paddingBottom="@dimen/ai_widget_tab_icon_margin_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:src="@drawable/ai_summary_icon"
                        app:tab="true"
                        app:text="@string/ai_text_widget_summary"/>
                </com.miui.notes.ai.ui.fold.utils.AiWidgetTabItemMaterialEffectContainer>
                <com.miui.notes.ai.ui.fold.utils.AiWidgetTabItemMaterialEffectContainer
                    android:id="@+id/ai_check_material_effect"
                    app:material_blend_colors="@array/ai_panel_widget_blend_colors"
                    app:material_blend_modes="@array/ai_panel_widget_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_tab_corner_radius"
                    app:material_default_bg_color="@color/ai_widget_default_bg_color"
                    app:material_shadow_color="@color/ai_widget_shadow_color_default"
                    app:material_shadow_radius="50"
                    app:material_shadow_y="15"
                    app:material_stroke_colors="@array/ai_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width"
                    style="@style/AiWidgetTabItemStyle">
                    <com.miui.notes.ai.ui.AiWidgetTabItem
                        android:orientation="vertical"
                        android:id="@+id/ai_check"
                        android:paddingLeft="@dimen/ai_widget_tab_icon_margin_left"
                        android:paddingTop="@dimen/ai_widget_tab_icon_margin_top"
                        android:paddingRight="@dimen/ai_widget_tab_icon_margin_right"
                        android:paddingBottom="@dimen/ai_widget_tab_icon_margin_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:src="@drawable/ai_check_icon"
                        app:tab="true"
                        app:text="@string/ai_text_widget_check"/>
                </com.miui.notes.ai.ui.fold.utils.AiWidgetTabItemMaterialEffectContainer>
                <com.miui.notes.ai.ui.fold.utils.AiWidgetTabItemMaterialEffectContainer
                    android:id="@+id/ai_extension_material_effect"
                    app:material_blend_colors="@array/ai_panel_widget_blend_colors"
                    app:material_blend_modes="@array/ai_panel_widget_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_tab_corner_radius"
                    app:material_default_bg_color="@color/ai_widget_default_bg_color"
                    app:material_shadow_color="@color/ai_widget_shadow_color_default"
                    app:material_shadow_radius="50"
                    app:material_shadow_y="15"
                    app:material_stroke_colors="@array/ai_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width"
                    style="@style/AiWidgetTabItemStyle">
                    <com.miui.notes.ai.ui.AiWidgetTabItem
                        android:orientation="vertical"
                        android:id="@+id/ai_extension"
                        android:paddingLeft="@dimen/ai_widget_tab_icon_margin_left"
                        android:paddingTop="@dimen/ai_widget_tab_icon_margin_top"
                        android:paddingRight="@dimen/ai_widget_tab_icon_margin_right"
                        android:paddingBottom="@dimen/ai_widget_tab_icon_margin_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:src="@drawable/ai_extension_icon"
                        app:tab="true"
                        app:text="@string/ai_text_widget_extension"/>
                </com.miui.notes.ai.ui.fold.utils.AiWidgetTabItemMaterialEffectContainer>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/ai_polish_title_text_size"
                android:textStyle="bold"
                android:textColor="@color/ai_widget_polish_title_color"
                android:id="@+id/polish_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/panel_polish_top"
                android:layout_marginBottom="@dimen/panel_polish_bottom"
                android:text="@string/polish_title"
                android:layout_below="@+id/ai_item_layout"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/ai_polish_title_margin_left"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="@dimen/panel_polish_padding_top"
                android:paddingBottom="@dimen/panel_polish_padding_bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/panel_polish_padding_start"
                android:paddingEnd="@dimen/panel_polish_padding_end">
                <com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer
                    android:id="@+id/ai_general"
                    app:material_blend_colors="@array/ai_panel_widget_blend_colors"
                    app:material_blend_modes="@array/ai_panel_widget_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_polish_corner_radius"
                    app:material_default_bg_color="@color/ai_widget_default_bg_color"
                    app:material_shadow_color="@color/ai_widget_shadow_color_default"
                    app:material_shadow_radius="50"
                    app:material_shadow_y="15"
                    app:material_stroke_colors="@array/ai_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width"
                    style="@style/AiWidgetPolishItemStyleForeign">
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:background="@drawable/scroll_list_compose"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/ai_general_icon"
                            android:layout_width="@dimen/ai_polish_icon_width"
                            android:layout_height="@dimen/ai_polish_icon_width"
                            android:src="@drawable/ai_general_icon_global"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/ai_widget_tab_icon_margin_right"/>
                        <TextView
                            android:textStyle="normal"
                            android:textColor="@color/ai_text_color_widget_summary"
                            android:gravity="center"
                            android:id="@+id/ai_general_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/ai_text_widget_general"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="@dimen/ai_widget_tab_text_margin_right"
                            android:layout_toEndOf="@+id/ai_general_icon"
                            style="@style/NoUnderlineEditText"/>
                    </RelativeLayout>
                </com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer>
                <com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer
                    android:id="@+id/ai_professional"
                    app:material_blend_colors="@array/ai_panel_widget_blend_colors"
                    app:material_blend_modes="@array/ai_panel_widget_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_polish_corner_radius"
                    app:material_default_bg_color="@color/ai_widget_default_bg_color"
                    app:material_shadow_color="@color/ai_widget_shadow_color_default"
                    app:material_shadow_radius="50"
                    app:material_shadow_y="15"
                    app:material_stroke_colors="@array/ai_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width"
                    style="@style/AiWidgetPolishItemStyleForeign">
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:background="@drawable/scroll_list_compose"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/ai_professional_icon"
                            android:layout_width="@dimen/ai_polish_icon_width"
                            android:layout_height="@dimen/ai_polish_icon_width"
                            android:src="@drawable/ai_professional_icon_global"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/ai_widget_tab_icon_margin_right"/>
                        <TextView
                            android:textStyle="normal"
                            android:textColor="@color/ai_text_color_widget_summary"
                            android:gravity="center"
                            android:id="@+id/ai_professional_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/ai_text_widget_professional"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="@dimen/ai_widget_tab_text_margin_right"
                            android:layout_toEndOf="@+id/ai_professional_icon"
                            style="@style/NoUnderlineEditText"/>
                    </RelativeLayout>
                </com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer>
                <com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer
                    android:id="@+id/ai_easy"
                    app:material_blend_colors="@array/ai_panel_widget_blend_colors"
                    app:material_blend_modes="@array/ai_panel_widget_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_polish_corner_radius"
                    app:material_default_bg_color="@color/ai_widget_default_bg_color"
                    app:material_shadow_color="@color/ai_widget_shadow_color_default"
                    app:material_shadow_radius="50"
                    app:material_shadow_y="15"
                    app:material_stroke_colors="@array/ai_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width"
                    style="@style/AiWidgetPolishItemStyleForeign">
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:background="@drawable/scroll_list_compose"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/ai_easy_icon"
                            android:layout_width="@dimen/ai_polish_icon_width"
                            android:layout_height="@dimen/ai_polish_icon_width"
                            android:src="@drawable/ai_easy_icon_global"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/ai_widget_tab_icon_margin_right"/>
                        <TextView
                            android:textStyle="normal"
                            android:textColor="@color/ai_text_color_widget_summary"
                            android:gravity="center"
                            android:id="@+id/ai_easy_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/ai_text_widget_easy"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="@dimen/ai_widget_tab_text_margin_right"
                            android:layout_toEndOf="@+id/ai_easy_icon"
                            style="@style/NoUnderlineEditText"/>
                    </RelativeLayout>
                </com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer>
                <com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer
                    android:id="@+id/ai_friendly"
                    app:material_blend_colors="@array/ai_panel_widget_blend_colors"
                    app:material_blend_modes="@array/ai_panel_widget_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/ai_polish_corner_radius"
                    app:material_default_bg_color="@color/ai_widget_default_bg_color"
                    app:material_shadow_color="@color/ai_widget_shadow_color_default"
                    app:material_shadow_radius="50"
                    app:material_shadow_y="15"
                    app:material_stroke_colors="@array/ai_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width"
                    style="@style/AiWidgetPolishItemStyleForeign">
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:background="@drawable/scroll_list_compose"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/ai_friendly_icon"
                            android:layout_width="@dimen/ai_polish_icon_width"
                            android:layout_height="@dimen/ai_polish_icon_width"
                            android:src="@drawable/ai_friendly_icon_global"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/ai_widget_tab_icon_margin_right"/>
                        <TextView
                            android:textStyle="normal"
                            android:textColor="@color/ai_text_color_widget_summary"
                            android:gravity="center"
                            android:id="@+id/ai_friendly_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/ai_text_widget_friendly"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="@dimen/ai_widget_tab_text_margin_right"
                            android:layout_toEndOf="@+id/ai_friendly_icon"
                            style="@style/NoUnderlineEditText"/>
                    </RelativeLayout>
                </com.miui.notes.ai.ui.fold.utils.AiWidgetPolishItemForeignMaterialEffectContainer>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

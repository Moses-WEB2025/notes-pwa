<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@null"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/sub_todo_item_height">
    <RelativeLayout
        android:id="@+id/check_group"
        android:layout_width="30dp"
        android:layout_height="match_parent">
        <CheckBox
            android:theme="@style/NoteTheme.List"
            android:id="@+id/cb_subtodo"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="20dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            style="@style/SubTodo.CheckBox"/>
    </RelativeLayout>
    <com.miui.common.view.StrikeTextView.StrikeTextView
        android:textSize="@dimen/text_default_size"
        android:textColor="@color/todo_item_content_text_common_color"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="yes"
        android:layout_marginEnd="4dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/creation_shape_edit_popupwindow_background"
    app:cardCornerRadius="@dimen/creation_actionmode_radius"
    app:cardElevation="@dimen/creation_actionmode_elevation"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.miui.handwriting.common.view.colorpicker.BlurBackGroundView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ll_root"
            app:layout_constraintEnd_toEndOf="@+id/ll_root"
            app:layout_constraintStart_toStartOf="@+id/ll_root"
            app:layout_constraintTop_toTopOf="@+id/ll_root"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_root"
            android:paddingTop="@dimen/creation_color_picker_tab_margin_top_no_shadow"
            android:layout_width="@dimen/creation_color_picker_popup_width"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/creation_color_picker_popup_view_page_margin_start_end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <miuix.miuixbasewidget.widget.FilterSortView
                android:id="@+id/popup_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <view
                    android:id="@+id/popup_grid_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/creation_color_picker_popup_tab_grid"
                    app:layout_constraintEnd_toStartOf="@+id/popup_slider_button"
                    app:layout_constraintStart_toStartOf="parent"
                    class="miuix.miuixbasewidget.widget.FilterSortView$TabView"/>
                <view
                    android:id="@+id/popup_slider_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/creation_color_picker_popup_tab_slider"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/popup_grid_button"
                    class="miuix.miuixbasewidget.widget.FilterSortView$TabView"/>
            </miuix.miuixbasewidget.widget.FilterSortView>
            <com.miui.handwriting.common.view.colorpicker.CustomViewPager
                android:id="@+id/custom_view_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/creation_color_picker_popup_alpha_seekbar_margin_top">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/alpha_seekbar_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/creation_color_picker_popup_alpha_text_size"
                                android:textColor="@color/creation_more_popwindow_item_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/creation_color_picker_popup_alpha_text_transparent"
                                android:layout_alignParentStart="true"/>
                            <TextView
                                android:textSize="@dimen/creation_color_picker_popup_alpha_text_size"
                                android:id="@+id/alpha_seek_bar_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                        <com.miui.handwriting.common.view.colorpicker.ColorPickerAlphaView
                            android:id="@+id/alpha_seek_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/creation_color_picker_popup_alpha_seekbar_margin_top"
                            android:thumb="@drawable/color_picker_thumb"
                            android:contentDescription="@string/creation_color_picker_popup_alpha_text_transparent"
                            android:splitTrack="false"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/creation_color_picker_popup_picker_display_margin_top_buttom"
                        android:layout_marginBottom="@dimen/creation_color_picker_popup_margin_buttom"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/alpha_seekbar_ll">
                        <FrameLayout
                            android:id="@+id/color_picker"
                            android:layout_width="@dimen/creation_color_picker_popup_picker_display_width_height"
                            android:layout_height="@dimen/creation_color_picker_popup_picker_display_width_height"
                            android:layout_alignParentStart="true">
                            <ImageView
                                android:layout_gravity="center"
                                android:background="@drawable/color_picker_straw"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/creation_color_picker_popup_straw"/>
                        </FrameLayout>
                        <ImageView
                            android:id="@+id/display_block"
                            android:background="@drawable/color_picker_color_display_block"
                            android:clickable="false"
                            android:layout_width="@dimen/creation_color_picker_popup_picker_display_width_height"
                            android:layout_height="@dimen/creation_color_picker_popup_picker_display_width_height"
                            android:importantForAccessibility="no"
                            android:layout_alignParentEnd="true"
                            style="?android:attr/borderlessButtonStyle"/>
                    </RelativeLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>

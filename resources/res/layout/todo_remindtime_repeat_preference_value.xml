<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_preference_item_padding_inner"
            android:layout_marginBottom="@dimen/miuix_preference_item_padding_inner"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:paddingEnd="@dimen/miuix_preference_icon_padding_end"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:paddingBottom="@dimen/miuix_preference_item_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/miuix_preference_item_padding_inner">
        <TextView
            android:textSize="@dimen/miuix_preference_normal_text_size"
            android:textStyle="normal"
            android:textColor="@color/miuix_preference_secondary_text"
            android:ellipsize="end"
            android:id="@android:id/title"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/miuix_preference_secondary_text_size"
            android:textColor="@color/miuix_preference_secondary_text"
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="10"
            android:layout_below="@android:id/title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@android:id/title"/>
    </RelativeLayout>
    <miuix.appcompat.widget.Spinner
        android:id="@+id/value_right"
        android:paddingBottom="@dimen/miuix_preference_item_padding_bottom"
        android:layout_width="200dp"
        android:layout_height="wrap_content"/>
</LinearLayout>

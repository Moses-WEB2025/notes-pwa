<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/float_primary_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rl_preview"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">
            <RelativeLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <com.miui.handwriting.common.ai.PreviewImageView
                    android:id="@+id/iv_preview"
                    android:layout_width="@dimen/creation_ai_preview_width"
                    android:layout_height="@dimen/creation_ai_preview_height"
                    android:layout_marginTop="@dimen/creation_ai_preview_top"
                    android:scaleType="fitCenter"
                    app:cornerRadius="@dimen/creation_ai_preview_radius"/>
                <miuix.androidbasewidget.widget.EditText
                    android:textSize="@dimen/creation_ai_edit_text_size"
                    android:gravity="start|top"
                    android:id="@+id/et_input"
                    android:background="@drawable/edit_text_bg"
                    android:layout_width="@dimen/creation_ai_edit_width"
                    android:layout_height="@dimen/creation_ai_edit_height"
                    android:hint="@string/creation_ai_edit_hint"
                    android:maxLength="200"
                    android:layout_alignTop="@+id/iv_preview"
                    android:inputType="textMultiLine"
                    android:fontFamily="mipro-regular"
                    android:layout_marginStart="@dimen/creation_ai_edit_margin_start"
                    android:layout_toEndOf="@+id/iv_preview"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="@dimen/creation_ai_text_size"
                    android:ellipsize="end"
                    android:id="@+id/ai_participation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_ai_text_margin_top"
                    android:text="@string/creation_ai_participation"
                    android:maxLines="2"
                    android:layout_below="@+id/et_input"
                    android:fontFamily="mipro-regular"
                    android:textAlignment="viewStart"
                    android:layout_marginEnd="2dp"
                    android:layout_toStartOf="@+id/tv_progress"
                    android:layout_alignStart="@+id/et_input"/>
                <TextView
                    android:textSize="@dimen/creation_ai_text_size"
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_ai_text_margin_top"
                    android:layout_below="@+id/et_input"
                    android:fontFamily="mipro-regular"
                    android:layout_alignEnd="@+id/et_input"/>
                <miuix.androidbasewidget.widget.SeekBar
                    android:id="@+id/sb_participation"
                    android:layout_width="@dimen/creation_ai_seekbar_width"
                    android:layout_height="@dimen/creation_ai_seekbar_height"
                    android:layout_marginTop="@dimen/creation_ai_seekbar_margin_top"
                    android:max="9"
                    android:progress="6"
                    android:layout_below="@+id/ai_participation"
                    android:layout_alignStart="@+id/et_input"
                    android:layout_alignEnd="@+id/et_input"
                    android:min="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/creation_ai_tv_keyword"
                    android:id="@+id/tv_keyword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_ai_rv_text_size_margin_top"
                    android:text="@string/creation_ai_recommend_keyword"
                    android:layout_below="@+id/iv_preview"/>
                <miuix.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_keyword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/creation_ai_rv_margin_top"
                    android:layout_below="@+id/tv_keyword"
                    android:overScrollMode="never"/>
            </RelativeLayout>
        </ScrollView>
        <Button
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/btn_start"
            android:layout_width="@dimen/creation_ai_btn_start_width"
            android:layout_height="wrap_content"
            android:text="@string/creation_ai_begin"
            android:layout_marginVertical="@dimen/creation_ai_btn_result_margin_bottom"
            style="@style/Widget.Button.Primary"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/rl_detail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <miuix.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ai_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/creation_ai_result_preview_padding"/>
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/creation_ai_btn_result_margin_bottom">
            <Button
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/creation_ai_btn_result_margin_bottom"
                android:text="@string/creation_ai_back"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/creation_ai_btn_result_margin_both"
                style="@style/Widget.Button"/>
            <Button
                android:enabled="false"
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/creation_ai_btn_result_margin_bottom"
                android:text="@string/creation_ai_next"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/creation_ai_btn_result_margin_mid"
                android:layout_marginEnd="@dimen/creation_ai_btn_result_margin_both"
                style="@style/Widget.Button.Primary"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

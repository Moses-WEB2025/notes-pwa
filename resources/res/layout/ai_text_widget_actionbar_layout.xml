<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.miui.notes.ai.ui.fold.utils.TitleActionBarTextView
        android:textSize="@dimen/ai_text_widget_size"
        android:textStyle="normal"
        android:textColor="@color/ai_widget_tab_text_color"
        android:gravity="center"
        android:id="@+id/ai_title_start"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ai_widget_actionbar_height"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_toStartOf="@+id/ai_title"/>
    <TextView
        android:textSize="@dimen/ai_text_widget_size"
        android:textStyle="normal"
        android:textColor="@color/ai_widget_tab_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ai_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/ai_input_max_width"
        android:minHeight="@dimen/ai_widget_actionbar_height"
        android:text="@string/ai_text_widget_title"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"/>
    <com.miui.notes.ai.ui.fold.utils.TitleActionBarTextView
        android:textSize="@dimen/ai_text_widget_size"
        android:textStyle="normal"
        android:textColor="@color/ai_widget_tab_text_color"
        android:gravity="center"
        android:id="@+id/ai_title_end"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ai_widget_actionbar_height"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_toEndOf="@+id/ai_title"/>
    <com.miui.notes.ai.ui.fold.utils.CloseActionBarMaterialEffectContainer
        android:id="@+id/close_button"
        android:layout_width="@dimen/ai_text_widget_actionbar_close_button_icon_size"
        android:layout_height="@dimen/ai_text_widget_actionbar_close_button_icon_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/ai_text_widget_actionbar_margin_end"
        android:layout_alignParentEnd="true"
        app:material_binding_render_mode="light"
        app:material_blend_colors="@array/ai_panel_close_blend_colors"
        app:material_blend_modes="@array/ai_material_default_blend_modes"
        app:material_blur_radius="@dimen/ai_material_blur_radius"
        app:material_corner_radius="@dimen/ai_input_send_corner_radius"
        app:material_default_bg_color="@color/ai_panel_close_default_bg_color"
        app:material_shadow_color="@color/miuix_color_transparent"
        app:material_shadow_radius="0"
        app:material_shadow_y="0"
        app:material_stroke_colors="@array/ai_close_button_gradient_border_colors"
        app:material_stroke_width="@dimen/ai_widget_border_width">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ai_panel_close_ic"
            android:contentDescription="@string/close_button_talkback_text"/>
    </com.miui.notes.ai.ui.fold.utils.CloseActionBarMaterialEffectContainer>
</RelativeLayout>

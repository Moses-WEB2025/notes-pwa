<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/audio_trans"
    android:background="@drawable/audio_record_panel_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/pad_note_audio_panel_height">
    <View
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audio_trans_tools"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pad_note_audio_toolbar_height"
        android:paddingStart="@dimen/pad_audio_content_margin"
        android:paddingEnd="@dimen/pad_audio_content_margin">
        <TextView
            android:id="@+id/stop"
            android:background="@drawable/pad_btn_meeting_audio_stop"
            android:layout_width="@dimen/pad_audio_btn_stop_width"
            android:layout_height="@dimen/pad_audio_btn_stop_height"
            android:contentDescription="@string/toolbar_voice_done_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/flag"
            android:background="@drawable/pad_btn_meeting_audio_flags"
            android:layout_width="@dimen/pad_audio_btn_stop_width"
            android:layout_height="@dimen/pad_audio_btn_stop_height"
            android:contentDescription="@string/toolbar_voice_mark_description"
            android:layout_marginStart="@dimen/pad_audio_btn_flag_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/stop"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/mode_group"
            android:background="@drawable/pad_note_audio_mode_switch_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/pad_audio_btn_stop_height"
            android:layout_marginEnd="@dimen/pad_audio_btn_mode_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/translation"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_gravity="center"
                android:id="@+id/mode"
                android:background="@drawable/pad_note_audio_mode_item_bg_s"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/pad_audio_mode_content_margin">
                <TextView
                    android:textSize="@dimen/pad_audio_text_size"
                    android:textColor="@color/pad_note_audio_mode_item_text_color_s"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/mode_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_btn_mode_single"
                    android:layout_marginStart="@dimen/pad_audio_btn_text_margin_start"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/pad_audio_switch_arrow"
                    android:layout_width="@dimen/pad_audio_arrow_width"
                    android:layout_height="@dimen/pad_audio_arrow_height"
                    android:layout_marginStart="@dimen/pad_audio_arrow_margin_start"
                    android:layout_marginEnd="@dimen/pad_audio_arrow_margin_end"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/mode_large"
            android:background="@drawable/pad_note_audio_mode_switch_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/pad_audio_btn_stop_height"
            android:layout_marginEnd="@dimen/pad_audio_btn_mode_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/translation"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/pad_audio_text_size"
                android:textColor="@color/pad_note_edit_header_info"
                android:gravity="center"
                android:id="@+id/mode_single"
                android:layout_width="@dimen/pad_audio_btn_single_width"
                android:layout_height="@dimen/pad_audio_btn_single_height"
                android:text="@string/audio_btn_mode_single"
                android:layout_marginStart="@dimen/pad_audio_btn_mode_single_margin"/>
            <TextView
                android:textSize="@dimen/pad_audio_text_size"
                android:textColor="@color/pad_note_edit_header_info"
                android:gravity="center"
                android:id="@+id/mode_meeting"
                android:layout_width="@dimen/pad_audio_btn_single_width"
                android:layout_height="@dimen/pad_audio_btn_single_height"
                android:text="@string/audio_btn_mode_meeting"
                android:layout_marginEnd="@dimen/pad_audio_btn_mode_single_margin"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/todo_item_time_text_common_color"
            android:gravity="center"
            android:id="@+id/translation"
            android:background="@drawable/pad_btn_meeting_ch_en_trans"
            android:layout_width="@dimen/pad_audio_btn_translation_width"
            android:layout_height="@dimen/pad_audio_btn_stop_height"
            android:contentDescription="@string/audio_btn_trans"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.miui.common.view.RecordingWaveView
        android:layout_gravity="center_horizontal"
        android:id="@+id/record_wave"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/pad_audio_wave_height"
        android:layout_marginTop="@dimen/pad_audio_wave_margin_top"
        android:importantForAccessibility="no"
        app:defaultColor="@color/warn_color_red"
        app:indicatorColor="@color/theme_main_color"
        app:indicatorMaxHeight="@dimen/wave_max_height"
        app:indicatorNum="27"
        app:indicatorWidth="@dimen/wave_width"
        app:interval="@dimen/wave_interval"/>
</LinearLayout>

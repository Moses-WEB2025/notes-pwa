<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.miui.handwriting.common.view.colorpicker.BlurBackGroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_root"
        app:layout_constraintEnd_toEndOf="@+id/ll_root"
        app:layout_constraintStart_toStartOf="@+id/ll_root"
        app:layout_constraintTop_toTopOf="@+id/ll_root"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_root"
        android:paddingBottom="30dp"
        android:layout_width="@dimen/creation_pen_set_popup_window_width"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/creation_pen_set_margin_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/creation_multi_brush_ballpoint"
                android:layout_width="@dimen/creation_tool_item_width_thin"
                android:layout_height="@dimen/creation_tool_item_height"
                android:contentDescription="@string/creation_tool_ballpoint"
                android:translationY="@dimen/creation_tool_select_multi_tran_y"
                android:layout_marginStart="@dimen/creation_brush_multi_ballpoint_margin_start"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/creation_multi_brush_pencil"
                android:layout_width="@dimen/creation_tool_item_width_thin"
                android:layout_height="@dimen/creation_tool_item_height"
                android:contentDescription="@string/creation_tool_pencil"
                android:translationY="@dimen/creation_tool_select_multi_tran_y"
                android:layout_marginStart="@dimen/creation_brush_multi_pencil_margin_start"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/creation_multi_brush_ink"
                android:layout_width="@dimen/creation_tool_item_width_thin"
                android:layout_height="@dimen/creation_tool_item_height"
                android:contentDescription="@string/creation_tool_ink"
                android:translationY="@dimen/creation_tool_select_multi_tran_y"
                android:layout_marginStart="@dimen/creation_brush_multi_ink_margin_start"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/creation_multi_brush_markpen"
                android:layout_width="@dimen/creation_tool_item_width_fat"
                android:layout_height="@dimen/creation_tool_item_height"
                android:contentDescription="@string/creation_tool_mark"
                android:translationY="@dimen/creation_tool_select_multi_tran_y"
                android:layout_marginStart="@dimen/creation_brush_multi_markpen_margin_start"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/creation_multi_brush_watercolor"
                android:layout_width="@dimen/creation_tool_item_width_thin"
                android:layout_height="@dimen/creation_tool_item_height"
                android:contentDescription="@string/creation_tool_watercolor"
                android:translationY="@dimen/creation_tool_select_multi_tran_y"
                android:layout_marginStart="@dimen/creation_brush_multi_markpen_margin_start"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/creation_multi_ai_select"
                android:layout_width="@dimen/creation_tool_item_width_thin"
                android:layout_height="@dimen/creation_tool_item_height"
                android:contentDescription="@string/creation_tool_ai_pen"
                android:translationY="@dimen/creation_tool_select_multi_tran_y"
                android:layout_marginStart="@dimen/creation_brush_multi_markpen_margin_start"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/creation_multibrush_config"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/creation_multibrush_line"
                    android:background="@color/creation_split_line_color"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/creation_brush_multi_config_width_margin"
                    android:layout_marginEnd="@dimen/creation_brush_multi_config_width_margin"/>
                <ImageView
                    android:id="@+id/iv_pen_review"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/creation_pen_set_preview_image_height"
                    android:layout_marginTop="@dimen/creation_pen_set_pen_review_top"
                    android:scaleType="centerCrop"/>
                <ScrollView
                    android:id="@+id/sl"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_pen_thickness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/creation_pen_set_top">
                            <TextView
                                android:id="@+id/tv_pen_thickness"
                                android:text="@string/creation_pen_thickness"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <TextView
                                android:id="@+id/tv_pen_thickness_num"
                                android:text="100"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <com.miui.handwriting.common.view.popup.SelectPropertyView
                                android:id="@+id/seekbar_pen_thickness"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                                android:thumb="@drawable/color_picker_thumb"
                                android:contentDescription="@string/creation_pen_thickness"
                                android:splitTrack="false"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_pen_thickness"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_pen_sensitivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/creation_pen_set_top">
                            <TextView
                                android:id="@+id/tv_pen_sensitivity"
                                android:text="@string/creation_pen_sensitivity"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <TextView
                                android:id="@+id/tv_pen_sensitivity_num"
                                android:text="100"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <com.miui.handwriting.common.view.popup.SelectPropertyView
                                android:id="@+id/seekbar_pen_sensitivity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                                android:thumb="@drawable/color_picker_thumb"
                                android:contentDescription="@string/creation_pen_sensitivity"
                                android:splitTrack="false"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_pen_sensitivity"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_pen_tip_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/creation_pen_set_image_top">
                            <TextView
                                android:id="@+id/tv_pen_tip_size"
                                android:text="@string/creation_pen_tip_size"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <TextView
                                android:id="@+id/tv_pen_tip_size_num"
                                android:text="100"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <com.miui.handwriting.common.view.popup.SelectPropertyView
                                android:id="@+id/seekbar_pen_tip_size"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                                android:thumb="@drawable/color_picker_thumb"
                                android:contentDescription="@string/creation_pen_tip_size"
                                android:splitTrack="false"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_pen_tip_size"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_pen_text_transparent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/creation_pen_set_top">
                            <TextView
                                android:id="@+id/tv_pen_text_transparent"
                                android:text="@string/creation_pen_text_transparent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <TextView
                                android:id="@+id/tv_pen_text_transparent_num"
                                android:text="100"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/creation_pen_set"/>
                            <com.miui.handwriting.common.view.popup.SelectAlphaView
                                android:id="@+id/seekbar_pen_text_transparent"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                                android:thumb="@drawable/color_picker_thumb"
                                android:contentDescription="@string/creation_pen_text_transparent"
                                android:splitTrack="false"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_pen_text_transparent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ai_controller"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:visibility="gone"
                android:layout_width="@dimen/creation_ai_preview_height"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/creation_pen_set_margin_horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <miuix.miuixbasewidget.widget.FilterSortView
                    android:id="@+id/filterSortView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginVertical="8dp"
                    app:filterSortTabViewCoverBg="@drawable/bg_eraser_item"
                    app:filterSortViewBackground="@null"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

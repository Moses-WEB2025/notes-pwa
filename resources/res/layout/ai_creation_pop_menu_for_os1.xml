<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/creation_select_popupwindow_background"
    app:cardCornerRadius="@dimen/creation_actionmode_radius"
    app:cardElevation="@dimen/creation_actionmode_elevation"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:gravity="center"
            android:id="@+id/ai_creation_select"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/creation_actionmode_height"
            android:text="@string/creation_ai"
            android:layout_marginStart="@dimen/creation_actionmode_dp_24"
            android:layout_marginEnd="@dimen/creation_actionmode_dp_24"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

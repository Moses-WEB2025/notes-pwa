<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/doodle_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/doodle_tools_panel"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="41dp"
            android:layout_marginStart="20dp">
            <ImageView
                android:id="@+id/undo"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_doodle_action_undo"
                android:contentDescription="@string/toolbar_undo_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/redo"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_doodle_action_redo"
                android:contentDescription="@string/toolbar_redo_description"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@+id/undo"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/immerse"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/doodle_ic_action_immerse_mode"
                android:contentDescription="@string/doodle_action_enter_immersion_mode"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toStartOf="@+id/done"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/done"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_doodle_action_done"
                android:contentDescription="@string/toolbar_done_description"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:background="@null"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.miui.support.cardview.CardView
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:outlineSpotShadowColor="#66000000"
        app:cardBackgroundColor="@color/rich_text_float_menu_bg_color"
        app:cardCornerRadius="@dimen/rich_text_menu_radius"
        app:cardElevation="@dimen/rich_text_menu_elevation"
        app:miuix_strokeColor="@color/rich_text_float_menu_border_color"
        app:miuix_strokeWidth="1dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/menu_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/annotate_image"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_float_menu_annotate"
                android:contentDescription="@string/image_action_annotate"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/edit_image"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_float_menu_doodle"
                android:contentDescription="@string/doodle_feature"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/scale_image"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_float_menu_zoom_out"
                android:contentDescription="@string/image_action_zoom_out"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/view_image"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_float_menu_view_image"
                android:contentDescription="@string/image_action_browse"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/copy_image"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_float_menu_copy_image"
                android:contentDescription="@string/image_action_copy"
                android:layout_marginStart="4dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/delete_image"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_float_menu_delete_image"
                android:contentDescription="@string/image_action_delete"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

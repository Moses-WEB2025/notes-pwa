<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:alpha="0">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/undo"
            android:visibility="visible"
            android:src="@drawable/pc_ic_undo"
            android:contentDescription="@string/toolbar_undo_description"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/redo"
            android:visibility="visible"
            android:src="@drawable/pc_ic_redo"
            android:contentDescription="@string/toolbar_redo_description"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/size_group"
            android:background="@drawable/note_pad_toolbar_item_bg"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="117dp"
            android:layout_height="28dp"
            android:contentDescription="@string/pc_note_edit_text_format_des">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/pc_text_common_color"
                    android:gravity="center"
                    android:id="@+id/text_size_content"
                    android:paddingTop="2dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_text_size_indicator"
                    android:layout_marginEnd="12dp"/>
            </LinearLayout>
        </FrameLayout>
        <View
            android:background="#20000000"
            android:layout_width="0.4dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:id="@+id/bold"
            android:src="@drawable/pc_ic_action_bold"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/italic"
            android:src="@drawable/pc_ic_action_italic"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/underline"
            android:src="@drawable/pc_ic_action_underline"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/bg_highlight"
            android:src="@drawable/pc_ic_action_highlight"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/check"
            android:padding="2dp"
            android:src="@drawable/pc_ic_action_check"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/bullet"
            android:src="@drawable/pc_ic_action_bulleted"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/center"
            android:src="@drawable/pc_ic_action_center"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/right"
            android:src="@drawable/pc_ic_action_right"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
        <ImageView
            android:id="@+id/gallery"
            android:padding="2dp"
            android:src="@drawable/pc_ic_gallery"
            android:layout_marginStart="@dimen/pc_notes_pad_edit_ic_margin"
            style="@style/PcToolBarIconStyle"/>
    </LinearLayout>
</RelativeLayout>

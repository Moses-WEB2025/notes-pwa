<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/annotate_group"
    android:background="@android:color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="@dimen/image_annotation_panel_height"
    android:alpha="1">
    <View
        android:background="#08000000"
        android:layout_width="0dp"
        android:layout_height="1px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.miui.notes.ui.widget.ClearableEditText
        android:textSize="@dimen/image_annotation_edit_content_text_size"
        android:textColor="@color/theme_common_secondary_color"
        android:textColorHint="@color/empty_text_hint"
        android:gravity="start|center_vertical"
        android:id="@+id/edit_content"
        android:background="@drawable/edit_layout_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/image_annotation_edit_margin_vertical"
        android:layout_marginBottom="@dimen/image_annotation_edit_margin_vertical"
        android:hint="@string/image_annotation_edit_hint"
        android:maxLines="1"
        android:imeOptions="actionDone"
        android:paddingStart="@dimen/image_annotation_edit_content_padding_start"
        android:paddingEnd="@dimen/image_annotation_edit_content_padding_end"
        android:layout_marginStart="@dimen/image_annotation_edit_margin_horizontal"
        app:layout_constraintEnd_toStartOf="@+id/done"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/image_annotation_edit_content_text_size"
        android:textColor="@color/todo_edit_done_color"
        android:gravity="center"
        android:id="@+id/done"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/done"
        android:layout_marginStart="@dimen/image_annotation_edit_done_margin_start"
        android:layout_marginEnd="@dimen/image_annotation_edit_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/edit_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mind_note_tool_group"
    android:background="@color/pad_toolbar_bg_color"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0">
    <View
        android:id="@+id/mix_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/group_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/level_reduce"
                    android:background="@drawable/ic_tool_overview_demote"
                    android:layout_width="@dimen/mind_notes_edit_toolbar_icon_size"
                    android:layout_height="@dimen/mind_notes_edit_toolbar_icon_size"
                    android:contentDescription="@string/mind_note_toolbar_demote"/>
                <ImageView
                    android:id="@+id/level_increase"
                    android:background="@drawable/ic_tool_overview_promote"
                    android:layout_width="@dimen/mind_notes_edit_toolbar_icon_size"
                    android:layout_height="@dimen/mind_notes_edit_toolbar_icon_size"
                    android:contentDescription="@string/mind_note_toolbar_promote"
                    android:layout_marginStart="@dimen/pad_toolbar_margin_start"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/group_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/delete_node"
                    android:background="@drawable/ic_tool_delete_node"
                    android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                    android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:contentDescription="@string/mind_note_toolbar_delete_node"/>
                <ImageView
                    android:id="@+id/add_child_node"
                    android:background="@drawable/ic_tool_add_child_node"
                    android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                    android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:contentDescription="@string/mind_note_toolbar_add_child_node"
                    android:layout_marginStart="@dimen/pad_mind_note_edit_toolbar_margin_start"/>
                <ImageView
                    android:id="@+id/add_brother_node"
                    android:background="@drawable/ic_tool_add_brother_node"
                    android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                    android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                    android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                    android:contentDescription="@string/mind_note_toolbar_add_brother_node"
                    android:layout_marginStart="@dimen/pad_mind_note_edit_toolbar_margin_start"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:id="@+id/navi_placeholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/toolbar"/>
    </RelativeLayout>
    <View
        android:id="@+id/panel_divide"
        android:background="@color/toolbar_divide_color"
        android:layout_width="0dp"
        android:layout_height="0.44dp"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

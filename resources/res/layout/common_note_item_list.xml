<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/note_group"
    android:background="@drawable/v12_list_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/list_item_margin_bottom"
    android:minHeight="@dimen/list_item_height_min"
    android:layerType="hardware">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/note_list_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/list_item_content_margin_top"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="@dimen/list_item_content_margin_start"
        android:layout_marginEnd="@dimen/list_item_content_margin_start"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/label"
        app:layout_constraintEnd_toStartOf="@+id/image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingMultiplier="1.2"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/content_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingMultiplier="1.2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/list_item_content_margin_bottom"
        android:layout_marginStart="@dimen/list_item_content_margin_start"
        android:layout_marginEnd="@dimen/list_item_content_margin_start"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/image"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textAppearance="@style/V8.TextAppearance.List.Tertiary"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/stick"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_data_item_stick"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_data_item_audio"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/mind_map"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_data_item_mind_map"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/mind_outline"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_data_item_mind_outline"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/hand_write_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_data_item_hand_write"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/alarm"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_data_item_clock"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/v8_ic_indicator_white"/>
    </LinearLayout>
    <com.miui.notes.ui.widget.RoundImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="@dimen/v12_list_item_thumbnail_size"
        android:layout_height="@dimen/v12_list_item_thumbnail_size"
        android:layout_marginTop="@dimen/list_item_content_margin_bottom"
        android:layout_marginBottom="@dimen/list_item_content_margin_bottom"
        android:layout_marginEnd="@dimen/list_item_image_margin_end"
        app:border="@dimen/ic_1px_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="@dimen/list_item_preview_image_radius"/>
    <CheckBox
        android:theme="@style/Note.MultiCheckBox"
        android:id="@android:id/checkbox"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/miuix_appcompat_check_widget_width"
        android:layout_height="@dimen/miuix_appcompat_check_widget_height"
        android:layout_marginEnd="@dimen/list_item_content_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.todo.view.EditRootLayout
        android:gravity="bottom"
        android:id="@+id/content"
        android:background="@drawable/pc_todo_edit_bg"
        android:layout_width="404dp"
        android:layout_height="match_parent"
        android:minHeight="@dimen/bottom_editor_panel_min_height"
        android:layout_alignParentEnd="true"
        android:elevation="60dp">
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            layout="@layout/audio_create_panel_with_button"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/editor_scroll_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:splitMotionEvents="false">
            <include
                android:id="@+id/todo_editor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="36dp"
                android:layout_weight="1"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="36dp"
                layout="@layout/pc_todo_editor"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/group_tag_custom"
                    android:background="@drawable/pc_todo_editor_time_bg"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    android:paddingEnd="2dp"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#33000000"
                        android:id="@+id/tv_tag_custom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_todo_set_remind_time_hint"
                        android:layout_weight="1"
                        android:contentDescription="@string/todo_edit_btn_custom"
                        android:layout_marginStart="16dp"/>
                    <View
                        android:id="@+id/v_tag_divider"
                        android:background="@color/divider_line"
                        android:visibility="gone"
                        android:layout_width="1.5dp"
                        android:layout_height="10.91dp"/>
                    <ImageView
                        android:id="@+id/iv_tag_cancel"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_todo_edit_remind_cancel"
                        android:contentDescription="@string/todo_edit_btn_cancel_remind"
                        android:paddingStart="5.5dp"
                        android:paddingEnd="9dp"/>
                    <ImageView
                        android:id="@+id/iv_tag_custom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pc_ic_todo_edit_alert_n"
                        android:layout_marginEnd="16dp"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp">
                <Button
                    android:textSize="16dp"
                    android:textColor="#cc000000"
                    android:gravity="center"
                    android:id="@+id/cancel_button"
                    android:background="@drawable/pc_todo_edit_btn_cancel_bg"
                    android:nextFocusLeft="@+id/embedded_text_editor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="@string/dialog_button_cancel"
                    android:layout_weight="1"
                    android:layoutDirection="locale"
                    android:layout_marginEnd="10dp"/>
                <Button
                    android:textSize="16dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/send_button"
                    android:background="@drawable/pc_todo_edit_btn_done_bg"
                    android:nextFocusLeft="@+id/embedded_text_editor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="@string/dialog_button_confirm"
                    android:layout_weight="1"
                    android:layoutDirection="locale"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.miui.todo.view.EditRootLayout>
</RelativeLayout>

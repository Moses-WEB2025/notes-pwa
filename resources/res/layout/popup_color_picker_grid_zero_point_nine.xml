<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/color_picker_grid"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/creation_color_picker_view_page_text_size_zero_point_nine"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/creation_color_picker_view_page_text_hue"
            android:importantForAccessibility="yes"
            android:layout_marginStart="@dimen/creation_color_picker_view_page_grid_text_margin_start_zero_point_nine"/>
        <com.miui.handwriting.common.view.colorpicker.ColorPickPanelView
            android:id="@+id/color_picker_panel"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="@dimen/creation_color_picker_view_page_grid_panel_width_zero_point_nine"
            android:layout_height="@dimen/creation_color_picker_view_page_grid_panel_height_zero_point_nine"
            android:layout_marginTop="@dimen/creation_color_picker_view_page_grid_panel_margin_top_zero_point_nine"
            android:importantForAccessibility="yes"
            app:select_thumb_scale="0.9"/>
    </LinearLayout>
</LinearLayout>

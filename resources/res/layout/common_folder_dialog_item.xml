<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/folder_dialog_item_layout"
        android:background="@drawable/common_folder_dialog_list_bg_shape"
        android:layout_width="match_parent"
        android:layout_height="@dimen/folder_list_item_height"
        android:layerType="hardware"
        android:paddingStart="@dimen/folder_list_item_padding_start"
        android:paddingEnd="@dimen/folder_list_item_padding_end">
        <ImageView
            android:id="@+id/fold_folder_dialog_item_tick"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_folder_dialog_item_check_tick"/>
        <TextView
            android:textSize="@dimen/folder_list_item_title_textsize"
            android:textColor="@color/pad_dialog_folder_item_text_color"
            android:ellipsize="end"
            android:id="@+id/fold_folder_dialog_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/folder_list_item_title_margin_start"/>
        <ImageView
            android:id="@+id/fold_folder_dialog_item_top"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_folder_dialog_item_top"
            android:layout_marginStart="@dimen/folder_list_item_title_margin_start"/>
        <TextView
            android:textSize="@dimen/folder_list_item_num_textsize"
            android:textColor="@color/common_folder_dialog_item_num_color"
            android:ellipsize="end"
            android:id="@+id/fold_folder_dialog_item_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/folder_list_item_title_margin_start"/>
        <CheckBox
            android:theme="@style/Note.MultiCheckBox"
            android:id="@android:id/checkbox"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/folder_list_item_title_margin_start"/>
    </LinearLayout>
</FrameLayout>

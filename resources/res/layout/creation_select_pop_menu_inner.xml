<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/creation_select_popupwindow_background"
    app:cardCornerRadius="@dimen/creation_actionmode_radius"
    app:cardElevation="@dimen/creation_actionmode_elevation"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/creation_select_card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/creation_select_back"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/creation_tool_back">
            <ImageView
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/creation_actionmode_height"
                android:src="@drawable/creation_select_back"
                android:scaleType="center"
                android:paddingStart="@dimen/creation_actionmode_inner_margin"
                android:paddingEnd="@dimen/creation_actionmode_inner_margin"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/creation_select_copy_paste"
            android:background="@color/creation_select_popupwindow_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creation_actionmode_inner_height"
            android:text="@string/creation_ppw_select_copy_paste"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_inner_margin"
            android:paddingEnd="@dimen/creation_actionmode_inner_margin"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/creation_select_copy_as_text"
            android:background="@color/creation_select_popupwindow_background"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/creation_actionmode_inner_height"
            android:text="@string/creation_ppw_select_copy_as_text"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_inner_margin"
            android:paddingEnd="@dimen/creation_actionmode_inner_margin"/>
        <TextView
            android:textSize="@dimen/creation_paste_size"
            android:textColor="@color/creation_select_popupwindow_text"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/creation_select_recognize_as_text"
            android:background="@color/creation_select_popupwindow_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/creation_actionmode_inner_height"
            android:text="@string/creation_ppw_select_recognize_as_text"
            android:maxLines="1"
            android:fontFamily="mipro-medium"
            android:paddingStart="@dimen/creation_actionmode_inner_margin"
            android:paddingEnd="@dimen/creation_actionmode_inner_margin"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

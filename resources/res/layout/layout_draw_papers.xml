<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/ll_papers"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginStart="20dp">
    <FrameLayout
        android:id="@+id/creation_tool_more_action_bg_solid"
        android:contentDescription="@string/creation_setting_show_solid"
        style="@style/creation_draw_paper_parent_item">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="50dp"
            android:layout_height="68dp"
            android:src="@drawable/bg_papar_solid_no"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/creation_tool_more_action_bg_dot"
        android:contentDescription="@string/creation_setting_show_dot"
        style="@style/creation_draw_paper_parent_item">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="50dp"
            android:layout_height="68dp"
            android:src="@drawable/bg_paper_dot_no"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/creation_tool_more_action_bg_line"
        android:contentDescription="@string/creation_setting_show_line"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/creation_draw_paper_parent_item">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="50dp"
            android:layout_height="68dp"
            android:src="@drawable/bg_paper_line_no"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/creation_tool_more_action_bg_grid"
        android:contentDescription="@string/creation_setting_show_grid"
        style="@style/creation_draw_paper_parent_item">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="50dp"
            android:layout_height="68dp"
            android:src="@drawable/bg_paper_grid_no"/>
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/creation_select_popupwindow_background"
        app:cardCornerRadius="@dimen/creation_actionmode_radius"
        app:cardElevation="@dimen/creation_actionmode_elevation"
        app:cardUseCompatPadding="true">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/creation_select_card_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/creation_paste_size"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="start|center_vertical"
                android:id="@+id/page_unbounded"
                android:background="@color/creation_select_popupwindow_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/creation_page_size_spinner_item_width"
                android:minHeight="@dimen/creation_page_size_spinner_item_height"
                android:text="@string/creation_page_size_unbounded"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/creation_page_size_spinner_item_padding_start"
                android:paddingEnd="@dimen/creation_page_size_spinner_item_padding_end"/>
            <TextView
                android:textSize="@dimen/creation_paste_size"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="start|center_vertical"
                android:id="@+id/page_a4_v"
                android:background="@color/creation_select_popupwindow_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/creation_page_size_spinner_item_width"
                android:minHeight="@dimen/creation_page_size_spinner_item_height"
                android:text="@string/creation_page_size_default_v"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/creation_page_size_spinner_item_padding_start"
                android:paddingEnd="@dimen/creation_page_size_spinner_item_padding_end"/>
            <TextView
                android:textSize="@dimen/creation_paste_size"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="start|center_vertical"
                android:id="@+id/page_a4_h"
                android:background="@color/creation_select_popupwindow_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/creation_page_size_spinner_item_width"
                android:minHeight="@dimen/creation_page_size_spinner_item_height"
                android:text="@string/creation_page_size_default_h"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/creation_page_size_spinner_item_padding_start"
                android:paddingEnd="@dimen/creation_page_size_spinner_item_padding_end"/>
            <TextView
                android:textSize="@dimen/creation_paste_size"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="start|center_vertical"
                android:id="@+id/page_16_9_v"
                android:background="@color/creation_select_popupwindow_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/creation_page_size_spinner_item_width"
                android:minHeight="@dimen/creation_page_size_spinner_item_height"
                android:text="@string/creation_page_size_16_9_v"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/creation_page_size_spinner_item_padding_start"
                android:paddingEnd="@dimen/creation_page_size_spinner_item_padding_end"/>
            <TextView
                android:textSize="@dimen/creation_paste_size"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="start|center_vertical"
                android:id="@+id/page_16_9_h"
                android:background="@color/creation_select_popupwindow_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/creation_page_size_spinner_item_width"
                android:minHeight="@dimen/creation_page_size_spinner_item_height"
                android:text="@string/creation_page_size_16_9_h"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/creation_page_size_spinner_item_padding_start"
                android:paddingEnd="@dimen/creation_page_size_spinner_item_padding_end"/>
            <TextView
                android:textSize="@dimen/creation_paste_size"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="start|center_vertical"
                android:id="@+id/page_1_1"
                android:background="@color/creation_select_popupwindow_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/creation_page_size_spinner_item_width"
                android:minHeight="@dimen/creation_page_size_spinner_item_height"
                android:text="@string/creation_page_size_1_1"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/creation_page_size_spinner_item_padding_start"
                android:paddingEnd="@dimen/creation_page_size_spinner_item_padding_end"/>
            <TextView
                android:textSize="@dimen/creation_paste_size"
                android:textColor="@color/creation_select_popupwindow_text"
                android:gravity="start|center_vertical"
                android:id="@+id/page_custom"
                android:background="@color/creation_select_popupwindow_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/creation_page_size_spinner_item_width"
                android:minHeight="@dimen/creation_page_size_spinner_item_height"
                android:text="@string/creation_page_size_custom"
                android:fontFamily="mipro-medium"
                android:paddingStart="@dimen/creation_page_size_spinner_item_padding_start"
                android:paddingEnd="@dimen/creation_page_size_spinner_item_padding_end"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>

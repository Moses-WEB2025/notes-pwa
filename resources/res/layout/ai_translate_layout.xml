<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/translate_root"
    android:background="@drawable/ai_translate_root_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/translate_src"
        android:background="@drawable/ai_translate_item_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_dialog_translate_item_margin"
        android:layout_marginBottom="@dimen/ai_dialog_translate_item_margin"
        android:minHeight="@dimen/ai_dialog_translate_item_height"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/ai_dialog_translate_item_margin"
        android:layout_marginEnd="@dimen/ai_dialog_translate_item_end">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/ai_dialog_translate_item_text_size"
                android:textStyle="bold"
                android:textColor="@color/translate_item_text_color"
                android:id="@+id/src_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="chinese"
                android:fontFamily="sans-serif-medium"
                android:textDirection="locale"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/src_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/src_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_up_down"
                android:layout_marginStart="@dimen/ai_language_icon_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/src_language"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_translate_arrow"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/translate_target"
        android:background="@drawable/ai_translate_item_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_dialog_translate_item_margin"
        android:layout_marginBottom="@dimen/ai_dialog_translate_item_margin"
        android:minHeight="@dimen/ai_dialog_translate_item_height"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/ai_dialog_translate_item_end"
        android:layout_marginEnd="@dimen/ai_dialog_translate_item_margin">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/ai_dialog_translate_item_text_size"
                android:textStyle="bold"
                android:textColor="@color/translate_item_text_color"
                android:id="@+id/target_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="english"
                android:fontFamily="sans-serif-medium"
                android:textDirection="locale"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/target_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/target_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_up_down"
                android:layout_marginStart="@dimen/ai_language_icon_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/target_language"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>

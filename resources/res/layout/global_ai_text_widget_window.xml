<?xml version="1.0" encoding="utf-8"?>
<com.miui.notes.ai.ui.FloatingDecorView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.notes.ai.ui.RenderViewLayout
        android:id="@+id/global_ai_bg_effect_view_container"
        android:background="@color/miuix_color_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/global_ai_floating_view"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <FrameLayout
            android:id="@+id/global_ai_floating_rim_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/ai_panel_bright_edge_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <miuix.cardview.HyperCardView
            android:id="@+id/global_ai_floating_content_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ai_panel_bright_edge_margin"
            android:minHeight="@dimen/ai_panel_card_min_height"
            android:shadowDy="@dimen/ai_panel_shadow_dy_zero"
            android:shadowRadius="@dimen/ai_panel_shadow_radius_none"
            app:cardBackgroundColor="@color/ai_panel_default_bg_color"
            app:cardBlendColorModes="@array/ai_panel_blend_modes"
            app:cardBlendColors="@array/ai_panel_blend_colors"
            app:cardCornerRadius="@dimen/ai_panel_card_corner_radius"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:miuix_blurRadius="@dimen/ai_panel_blur_radius"
            app:miuix_blurSelfBackground="true"
            app:miuix_strokeGradientColors="@array/ai_panel_gradient_border_colors"
            app:miuix_strokeWidth="@dimen/ai_panel_border_width">
            <com.miui.notes.ai.ui.fold.utils.FloatingWindowRelativeLayout
                android:clipChildren="false"
                android:layout_width="@dimen/global_ai_floating_window_width"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/global_ai_text_widget_actionbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/global_ai_panel_title_text_size"
                        android:textStyle="normal"
                        android:textColor="@color/global_ai_panel_title"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/global_ai_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/ai_input_max_width"
                        android:minHeight="@dimen/ai_widget_actionbar_height"
                        android:text="@string/ai_text_widget_title"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif-medium"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/global_ai_close_button"
                        android:layout_width="@dimen/global_ai_panel_close_icon_size"
                        android:layout_height="@dimen/global_ai_panel_close_icon_size"
                        android:src="@drawable/global_ai_panel_close_icon"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/close_button_talkback_text"
                        android:layout_marginEnd="@dimen/ai_text_widget_actionbar_margin_end"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <miuix.cardview.HyperCardView
                    android:id="@+id/global_ai_panel_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ai_item_text_padding_top"
                    android:minHeight="@dimen/ai_panel_card_min_height"
                    android:layout_below="@+id/global_ai_text_widget_actionbar"
                    android:layout_marginHorizontal="@dimen/global_ai_text_panel_card_margin_horizontal"
                    app:cardBackgroundColor="@color/global_ai_panel_bg"
                    app:cardCornerRadius="@dimen/global_ai_text_panel_card_radius"
                    app:cardElevation="0dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/global_ai_panel_webview_layout"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/global_ai_text_panel_web_feed_height"
                            app:layout_constraintBottom_toTopOf="@+id/global_ai_panel_divider"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <WebView
                                android:scrollbarThumbVertical="@drawable/miuix_appcompat_scrollbar_thumb_vertical"
                                android:scrollbarStyle="outsideOverlay"
                                android:id="@+id/global_ai_panel_webview"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/global_ai_text_panel_webview_height"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/global_ai_panel_feedback_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/global_ai_text_panel_feedback_bar_height"
                                android:layout_marginHorizontal="@dimen/global_ai_text_panel_feedback_margin_horizontal"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/global_ai_panel_webview">
                                <com.airbnb.lottie.LottieAnimationView
                                    android:id="@+id/global_ai_panel_feedback_positive"
                                    android:layout_width="@dimen/global_ai_panel_input_icon_size_24"
                                    android:layout_height="@dimen/global_ai_panel_input_icon_size_24"
                                    android:layout_marginTop="@dimen/global_ai_edit_input_content_margin_vertical"
                                    android:src="@drawable/ai_feedback_positive"
                                    android:layout_marginEnd="@dimen/global_ai_text_panel_feedback_margin_horizontal"
                                    app:layout_constraintEnd_toStartOf="@+id/global_ai_panel_feedback_negative"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:lottie_autoPlay="false"
                                    app:lottie_loop="false"/>
                                <com.airbnb.lottie.LottieAnimationView
                                    android:id="@+id/global_ai_panel_feedback_negative"
                                    android:layout_width="@dimen/global_ai_panel_input_icon_size_24"
                                    android:layout_height="@dimen/global_ai_panel_input_icon_size_24"
                                    android:layout_marginTop="@dimen/global_ai_edit_input_content_margin_vertical"
                                    android:src="@drawable/ai_feedback_negative"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/global_ai_panel_feedback_positive"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:lottie_autoPlay="false"
                                    app:lottie_loop="false"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/global_ai_panel_empty"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:layout_width="100dp"
                                    android:layout_height="64dp"
                                    android:src="@drawable/ai_panel_empty"
                                    android:scaleType="fitXY"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <View
                            android:id="@+id/global_ai_panel_divider"
                            android:background="@color/global_ai_panel_grey_bg"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/global_ai_text_panel_input_margin_horizontal"
                            app:layout_constraintBottom_toTopOf="@+id/global_ai_panel_tag_list_layout"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/global_ai_panel_webview_layout"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/global_ai_panel_tag_list_layout"
                            android:paddingTop="22dp"
                            android:paddingBottom="@dimen/global_ai_text_panel_tag_margin_horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/global_ai_text_panel_input_margin_horizontal"
                            app:layout_constraintBottom_toTopOf="@+id/global_ai_show_input_layout"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/global_ai_panel_divider">
                            <FrameLayout
                                android:id="@+id/global_ai_panel_tag_style_container"
                                android:background="@drawable/global_ai_panel_tag_bg"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/global_ai_text_panel_tag_height"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/global_ai_panel_tag_word_num_container"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/global_ai_panel_tag_text_size"
                                    android:textColor="@color/global_ai_panel_style_text"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/global_ai_panel_tag_style"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="3"
                                    android:lineSpacingMultiplier="0.9"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="@dimen/global_ai_text_tag_padding_horizontal"
                                    android:paddingVertical="@dimen/global_ai_text_tag_padding_vertical"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/global_ai_panel_tag_word_num_container"
                                android:background="@drawable/global_ai_panel_tag_bg"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/global_ai_text_panel_tag_height"
                                android:layout_marginHorizontal="@dimen/global_ai_text_panel_tag_margin_horizontal"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/global_ai_panel_tag_emoticon_num_container"
                                app:layout_constraintStart_toEndOf="@+id/global_ai_panel_tag_style_container"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/global_ai_panel_tag_text_size"
                                    android:textColor="@color/global_ai_panel_style_text"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/global_ai_panel_tag_word_num"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="3"
                                    android:lineSpacingMultiplier="0.9"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="@dimen/global_ai_text_tag_padding_horizontal"
                                    android:paddingVertical="@dimen/global_ai_text_tag_padding_vertical"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/global_ai_panel_tag_emoticon_num_container"
                                android:background="@drawable/global_ai_panel_tag_bg"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/global_ai_text_panel_tag_height"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/global_ai_panel_tag_word_num_container"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/global_ai_panel_tag_text_size"
                                    android:textColor="@color/global_ai_panel_style_text"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/global_ai_panel_tag_emoticon_num"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="3"
                                    android:lineSpacingMultiplier="0.9"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="@dimen/global_ai_text_tag_padding_horizontal"
                                    android:paddingVertical="@dimen/global_ai_text_tag_padding_vertical"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/global_ai_panel_tag_comment_container"
                                android:background="@drawable/global_ai_panel_tag_bg"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/global_ai_text_panel_tag_height"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/global_ai_panel_tag_comment_num_container"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/global_ai_panel_tag_text_size"
                                    android:textColor="@color/global_ai_panel_style_text"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/global_ai_panel_tag_comment"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="3"
                                    android:lineSpacingMultiplier="0.9"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="@dimen/global_ai_text_tag_padding_horizontal"
                                    android:paddingVertical="@dimen/global_ai_text_tag_padding_vertical"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/global_ai_panel_tag_comment_num_container"
                                android:background="@drawable/global_ai_panel_tag_bg"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/global_ai_text_panel_tag_height"
                                android:layout_marginStart="@dimen/global_ai_text_panel_tag_margin_horizontal"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/global_ai_panel_tag_comment_container"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/global_ai_panel_tag_text_size"
                                    android:textColor="@color/global_ai_panel_style_text"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/global_ai_panel_tag_comment_num"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="3"
                                    android:lineSpacingMultiplier="0.9"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="@dimen/global_ai_text_tag_padding_horizontal"
                                    android:paddingVertical="@dimen/global_ai_text_tag_padding_vertical"/>
                            </FrameLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/global_ai_show_input_layout"
                            android:background="@drawable/global_ai_panel_input_bg"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/global_ai_text_panel_input_height"
                            android:layout_centerHorizontal="true"
                            android:layout_marginHorizontal="@dimen/global_ai_text_panel_input_margin_horizontal"
                            app:layout_constraintBottom_toTopOf="@+id/global_ai_panel_card_btn_layout"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/global_ai_panel_tag_list_layout">
                            <com.miui.notes.ai.ui.fold.utils.InputIconImageView
                                android:id="@+id/global_ai_panel_input_icon"
                                android:layout_width="@dimen/global_ai_panel_input_icon_size_22"
                                android:layout_height="@dimen/global_ai_panel_input_icon_size_22"
                                android:src="@drawable/global_ai_panel_input_icon"
                                android:scaleType="fitCenter"
                                android:layout_marginStart="@dimen/ai_input_icon_margin_start"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/global_ai_panel_show_input"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <EditText
                                android:textSize="@dimen/global_ai_text_panel_input_text_size"
                                android:textColor="@color/global_ai_panel_style_text"
                                android:textColorHint="@color/global_ai_panel_input_hint"
                                android:gravity="center_vertical"
                                android:id="@+id/global_ai_panel_show_input"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="@string/ai_input_default_text"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:layout_marginStart="@dimen/ai_polish_title_margin_top"
                                android:layout_marginEnd="@dimen/ai_recommend_layout_edit_margin_end"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/global_ai_panel_input_icon"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/NoUnderlineEditText"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <FrameLayout
                            android:id="@+id/global_ai_panel_card_btn_layout"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/global_ai_text_panel_card_bottom_btn_height"
                            android:layout_marginHorizontal="@dimen/global_ai_text_panel_input_margin_horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/global_ai_show_input_layout">
                            <TextView
                                android:textSize="@dimen/global_ai_text_panel_bottom_text_size"
                                android:textColor="@color/miuix_default_color_primary_dark"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/global_ai_panel_stop_generate_btn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_action_stop_generate"
                                android:maxLines="2"
                                android:fontFamily="sans-serif-medium"/>
                            <TextView
                                android:textSize="@dimen/global_ai_text_panel_bottom_text_size"
                                android:textColor="@color/miuix_color_blue_light_level1"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/global_ai_panel_regenerate_btn"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_action_regenerate"
                                android:maxLines="2"
                                android:fontFamily="sans-serif-medium"/>
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </miuix.cardview.HyperCardView>
                <com.miui.notes.ai.ui.material.MaterialEffectContainer
                    android:id="@+id/global_ai_panel_paste_layout"
                    android:background="@drawable/global_ai_paste_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/global_ai_panel_card"
                    android:layout_marginHorizontal="@dimen/global_ai_text_panel_card_margin_horizontal"
                    android:layout_marginVertical="@dimen/global_ai_text_panel_paste_btn_margin_vertical"
                    app:material_blend_colors="@array/global_ai_panel_paste_card_blend_colors"
                    app:material_blend_modes="@array/ai_panel_blend_modes"
                    app:material_blur_radius="@dimen/ai_material_blur_radius"
                    app:material_corner_radius="@dimen/global_ai_text_panel_paste_btn_radius"
                    app:material_default_bg_color="@color/global_ai_panel_paste_bg"
                    app:material_stroke_colors="@array/ai_send_button_gradient_border_colors"
                    app:material_stroke_width="@dimen/ai_widget_border_width">
                    <TextView
                        android:textSize="@dimen/global_ai_text_panel_bottom_text_size"
                        android:textStyle="bold"
                        android:textColor="@color/global_ai_input_paste_btn_text_color"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/global_ai_panel_paste_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:text="@string/ai_action_paste_to_page"
                        android:maxLines="2"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp"/>
                </com.miui.notes.ai.ui.material.MaterialEffectContainer>
            </com.miui.notes.ai.ui.fold.utils.FloatingWindowRelativeLayout>
        </miuix.cardview.HyperCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/global_ai_edit_input_layout"
        android:visibility="gone"
        android:layout_width="@dimen/global_ai_floating_window_width"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        layout="@layout/global_ai_edit_input_layout"/>
</com.miui.notes.ai.ui.FloatingDecorView>

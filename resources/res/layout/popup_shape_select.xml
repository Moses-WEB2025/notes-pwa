<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.handwriting.common.view.colorpicker.BlurBackGroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_root"
        app:layout_constraintEnd_toEndOf="@+id/ll_root"
        app:layout_constraintStart_toStartOf="@+id/ll_root"
        app:layout_constraintTop_toTopOf="@+id/ll_root"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/shape_selsct_popup_padding_horizontal"
        android:paddingVertical="@dimen/shape_selsct_popup_padding_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/shape_line"
            android:background="@drawable/ic_shape_select_circle"
            android:visibility="gone"
            android:layout_width="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_height="@dimen/shape_selsct_popup_icon_width_height"
            android:contentDescription="@string/creation_more_tool_insert_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/shape_circle"
            android:background="@drawable/ic_shape_select_circle"
            android:layout_width="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_height="@dimen/shape_selsct_popup_icon_width_height"
            android:contentDescription="@string/creation_more_tool_insert_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/shape_rect"
            android:background="@drawable/ic_shape_select_rect"
            android:layout_width="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_height="@dimen/shape_selsct_popup_icon_width_height"
            android:contentDescription="@string/creation_more_tool_insert_rect"
            android:layout_marginHorizontal="@dimen/shape_selsct_popup_icon_margin"
            app:layout_constraintEnd_toStartOf="@+id/shape_triangle"
            app:layout_constraintStart_toEndOf="@+id/shape_circle"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/shape_triangle"
            android:background="@drawable/ic_shape_select_triangle"
            android:layout_width="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_height="@dimen/shape_selsct_popup_icon_width_height"
            android:contentDescription="@string/creation_more_tool_insert_triangle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/shape_arrow"
            android:background="@drawable/ic_shape_select_arrow"
            android:layout_width="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_height="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_marginTop="@dimen/shape_selsct_popup_icon_margin"
            android:contentDescription="@string/creation_more_tool_insert_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shape_circle"/>
        <ImageView
            android:id="@+id/shape_star"
            android:background="@drawable/ic_shape_select_star"
            android:layout_width="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_height="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_marginTop="@dimen/shape_selsct_popup_icon_margin"
            android:contentDescription="@string/creation_more_tool_insert_star"
            android:layout_marginHorizontal="@dimen/shape_selsct_popup_icon_margin"
            app:layout_constraintEnd_toStartOf="@+id/shape_arrow_big"
            app:layout_constraintStart_toEndOf="@+id/shape_arrow"
            app:layout_constraintTop_toBottomOf="@+id/shape_rect"/>
        <ImageView
            android:id="@+id/shape_arrow_big"
            android:background="@drawable/ic_shape_select_arrow_big"
            android:layout_width="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_height="@dimen/shape_selsct_popup_icon_width_height"
            android:layout_marginTop="@dimen/shape_selsct_popup_icon_margin"
            android:contentDescription="@string/creation_more_tool_insert_arrow_big"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shape_triangle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

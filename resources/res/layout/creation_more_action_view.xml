<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.miui.handwriting.common.view.colorpicker.BlurBackGroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/creation_item_group"
        app:layout_constraintEnd_toEndOf="@+id/creation_item_group"
        app:layout_constraintStart_toStartOf="@+id/creation_item_group"
        app:layout_constraintTop_toTopOf="@+id/creation_item_group"/>
    <ScrollView
        android:id="@+id/creation_item_group"
        android:scrollbars="none"
        android:layout_width="@dimen/creation_common_edit_popup_window_width"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:visibility="visible"
            android:layout_width="@dimen/creation_common_edit_popup_window_width"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_bg_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="20dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/creation_more_popwindow_item_text"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/creation_more_popwindow_select_bg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/creation_setting_select_background"
                    android:maxLines="3"
                    android:layout_weight="1"
                    android:textAlignment="viewStart"/>
                <LinearLayout
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:id="@+id/ll_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:background="@drawable/bg_drawing_check_color_bg"
                            android:padding="0.5dp"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:src="@drawable/bg_drawing_paper_color_white"
                            android:contentDescription="@string/creation_desc_paper_white_accessibility"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="20dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:background="@drawable/bg_drawing_check_color_bg"
                            android:padding="0.5dp"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:src="@drawable/bg_drawing_paper_color_yellow"
                            android:contentDescription="@string/creation_desc_paper_yellow_accessibility"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="20dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:background="@drawable/bg_drawing_check_color_bg"
                            android:padding="0.5dp"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:src="@drawable/bg_drawing_paper_color_black"
                            android:contentDescription="@string/creation_desc_paper_black_accessibility"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <include layout="@layout/layout_draw_papers"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/page_size_parent_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.5dp">
                <TextView
                    android:gravity="start"
                    android:id="@+id/creation_page_size_change_title_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/creation_page_size_spinner_item_width"
                    android:text="@string/creation_more_tool_change_size"
                    android:textDirection="locale"
                    style="@style/creation_more_action_item_exact_height"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/creation_page_select_view_normal"
                    android:background="@drawable/creation_page_size_selected_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/creation_page_size_margin_end"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="@dimen/creation_page_size_padding">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/blank_view_text_color"
                        android:ellipsize="end"
                        android:id="@+id/creation_page_size_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="130dp"
                        android:text="@string/creation_page_size_default_v"
                        android:textDirection="locale"
                        android:paddingHorizontal="0dp"
                        style="@style/creation_more_action_item_exact_height"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/creation_paper_size"
                        android:layout_marginStart="@dimen/creation_page_size_image_margin_start"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/page_size_parent"
                android:background="@drawable/creation_tool_selected_bg"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">
                <TextView
                    android:gravity="start"
                    android:id="@+id/creation_page_size_change_title"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/creation_page_size_spinner_item_width"
                    android:text="@string/creation_more_tool_change_size"
                    android:textDirection="locale"
                    style="@style/creation_more_action_item_limit"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/creation_page_select_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/creation_page_size_change_title"
                    android:paddingHorizontal="28dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/blank_view_text_color"
                        android:ellipsize="end"
                        android:id="@+id/creation_page_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="130dp"
                        android:text="@string/creation_page_size_default_v"
                        android:textDirection="locale"
                        android:paddingHorizontal="0dp"
                        style="@style/creation_more_action_item"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/img_page_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/creation_paper_size"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/creation_page_size_margin_end"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/creation_rectangle"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="16.5dp">
                <View
                    android:layout_gravity="center"
                    android:background="@color/creation_more_popwindow_line"
                    android:layout_width="match_parent"
                    android:layout_height="0.74dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginHorizontal="28dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/creation_more_action_share"
                    android:visibility="gone"
                    android:text="@string/creation_tool_export"
                    style="@style/creation_more_action_item"/>
                <TextView
                    android:id="@+id/creation_more_action_insert_pic"
                    android:text="@string/creation_more_tool_insert_pic"
                    style="@style/creation_more_action_item"/>
                <TextView
                    android:id="@+id/creation_more_action_add_text"
                    android:text="@string/creation_more_tool_add_text"
                    style="@style/creation_more_action_item"/>
                <TextView
                    android:id="@+id/creation_more_action_insert_shape"
                    android:text="@string/creation_more_tool_insert_shape"
                    style="@style/creation_more_action_item"/>
                <RelativeLayout
                    android:id="@+id/rl_clear_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/creation_more_action_clear_content"
                        android:layout_width="wrap_content"
                        android:text="@string/creation_more_tool_clear_content"
                        style="@style/creation_more_action_item"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/creation_more_action_delete_page"
                    android:background="@drawable/creation_tool_selected_bg"
                    android:text="@string/creation_more_tool_delete_page"
                    style="@style/creation_more_action_item"/>
                <RelativeLayout
                    android:id="@+id/creation_more_action_switch_finger_item"
                    style="@style/creation_more_action_item">
                    <TextView
                        android:id="@+id/creation_more_action_switch_finger"
                        android:layout_height="match_parent"
                        android:maxWidth="350dp"
                        android:text="@string/creation_more_tool_finger_write"
                        android:layout_centerVertical="true"
                        android:paddingStart="0dp"
                        style="@style/creation_more_action_item_limit"/>
                    <miuix.slidingwidget.widget.SlidingButton
                        android:id="@+id/creation_more_action_switch_finger_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <RelativeLayout style="@style/creation_more_action_item">
                    <TextView
                        android:id="@+id/creation_more_action_switch_undo"
                        android:layout_height="match_parent"
                        android:maxWidth="260dp"
                        android:text="@string/creation_more_tool_finger_undo"
                        android:layout_centerVertical="true"
                        android:paddingStart="0dp"
                        style="@style/creation_more_action_item_limit"/>
                    <miuix.slidingwidget.widget.SlidingButton
                        android:id="@+id/creation_more_action_switch_undo_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/creation_more_action_mi_pencil_tips"
                    android:text="@string/creation_more_tool_pencil_hotkey"
                    style="@style/creation_more_action_item"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

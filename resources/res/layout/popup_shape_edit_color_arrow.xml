<?xml version="1.0" encoding="utf-8"?>
<com.miui.handwriting.common.view.ArrowCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:arrow_height="@dimen/shape_edit_color_popup_arrow_height"
    app:arrow_width="@dimen/shape_edit_color_popup_arrow_width"
    app:background_color="@color/creation_shape_edit_popupwindow_background"
    app:radius="@dimen/shape_edit_color_popup_radius"
    app:shadow_color="@color/shape_edit_color_popup_shadow_color"
    app:shadow_thickness="@dimen/shape_edit_color_popup_shadow_thickness">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shape_edit_color_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_1"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_2"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginStart="@dimen/shape_edit_color_popup_icon_margin_start"
                app:layout_constraintStart_toEndOf="@+id/shape_edit_color_1"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_3"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginStart="@dimen/shape_edit_color_popup_icon_margin_start"
                app:layout_constraintStart_toEndOf="@+id/shape_edit_color_2"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_4"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginStart="@dimen/shape_edit_color_popup_icon_margin_start"
                app:layout_constraintStart_toEndOf="@+id/shape_edit_color_3"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_5"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginStart="@dimen/shape_edit_color_popup_icon_margin_start"
                app:layout_constraintStart_toEndOf="@+id/shape_edit_color_4"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_6"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginTop="@dimen/shape_edit_color_popup_icon_margin_top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shape_edit_color_1"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_7"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginTop="@dimen/shape_edit_color_popup_icon_margin_top"
                android:layout_marginStart="@dimen/shape_edit_color_popup_icon_margin_start"
                app:layout_constraintStart_toEndOf="@+id/shape_edit_color_6"
                app:layout_constraintTop_toBottomOf="@+id/shape_edit_color_2"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_8"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginTop="@dimen/shape_edit_color_popup_icon_margin_top"
                android:layout_marginStart="@dimen/shape_edit_color_popup_icon_margin_start"
                app:layout_constraintStart_toEndOf="@+id/shape_edit_color_7"
                app:layout_constraintTop_toBottomOf="@+id/shape_edit_color_3"/>
            <com.miui.handwriting.common.view.popup.ShapeColorSelectView
                android:id="@+id/shape_edit_color_9"
                android:layout_width="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_height="@dimen/shape_edit_color_popup_icon_width_height"
                android:layout_marginTop="@dimen/shape_edit_color_popup_icon_margin_top"
                android:layout_marginStart="@dimen/shape_edit_color_popup_icon_margin_start"
                app:layout_constraintStart_toEndOf="@+id/shape_edit_color_8"
                app:layout_constraintTop_toBottomOf="@+id/shape_edit_color_4"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shape_edit_stroke_size_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shape_edit_color_container">
            <TextView
                android:id="@+id/shape_edit_stroke_size_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/creation_shape_edit_stroke_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/shape_edit_stroke_size_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/creation_pen_set"/>
            <com.miui.handwriting.common.view.popup.SelectPropertyView
                android:id="@+id/shape_edit_stroke_size_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/creation_pen_set_seekbar_top"
                android:thumb="@drawable/color_picker_thumb"
                android:contentDescription="@string/creation_shape_edit_stroke_size"
                android:splitTrack="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shape_edit_stroke_size_hint"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.miui.handwriting.common.view.ArrowCardView>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_content"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layerType="hardware">
        <View
            android:id="@+id/v_bg"
            android:background="@drawable/todo_child_item_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layerType="hardware"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <CheckBox
            android:id="@android:id/checkbox"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/checkbox_mask"
            app:layout_constraintEnd_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toTopOf="@+id/checkbox_mask"
            style="@style/Todo.Pad.CheckBox"/>
        <View
            android:id="@+id/checkbox_mask"
            android:layout_width="@dimen/pad_todo_list_item_content_margin_start_full"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/content_group"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/content_group"/>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="vertical"
            android:id="@+id/content_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="43dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/rl_subtodo"
            app:layout_constraintEnd_toStartOf="@+id/ll_expand_group"
            app:layout_constraintStart_toEndOf="@+id/checkbox_mask"
            app:layout_constraintTop_toTopOf="parent">
            <com.miui.common.view.StrikeTextView.StrikeTextView
                android:textAppearance="@style/Todo.Pad.TextAppearance.List.Secondary"
                android:textColor="@color/pad_todo_item_content_text_common_color"
                android:ellipsize="end"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/label"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textAppearance="@style/Todo.Pad.TextAppearance.List.Tertiary"
                    android:textSize="12sp"
                    android:textColor="@color/action_bg_border_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="mipro-regular"/>
                <ImageView
                    android:id="@+id/iv_clock"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pad_ic_todo_item_clock_n"
                    android:layout_marginStart="6dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_audio"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pad_ic_item_audio"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rl_subtodo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="@dimen/pad_todo_list_item_sub_content_margin_end_full"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/item_content"
            app:layout_constraintStart_toStartOf="@+id/content_group"
            app:layout_constraintTop_toBottomOf="@+id/content_group">
            <miuix.recyclerview.widget.RecyclerView
                android:id="@+id/rv_subtodo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:nestedScrollingEnabled="false"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_expand_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/content_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/content_group">
            <TextView
                android:textSize="@dimen/pad_subtodo_task_num_size"
                android:textColor="@color/pad_todo_item_list_process_text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="mipro-regular"
                android:layout_marginEnd="10dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_expand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/pad_todo_list_item_expand_margin_end_full"/>
        </LinearLayout>
        <CheckBox
            android:theme="@style/Note.MultiCheckBox"
            android:layout_gravity="center"
            android:id="@+id/multi_checkbox"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/content_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/content_group"/>
        <ImageView
            android:id="@+id/iv_drag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_todo_item_drag"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/todo_drag_margin_start"
            app:layout_constraintBottom_toBottomOf="@+id/content_group"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/content_group"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>

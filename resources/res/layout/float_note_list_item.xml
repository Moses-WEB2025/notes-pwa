<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/float_note_card_width"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/card_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/note_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/float_note_card_padding_horizontal"
            android:paddingEnd="@dimen/float_note_card_padding_horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/V12.TextAppearance.List.Primary"
                android:ellipsize="end"
                android:id="@+id/float_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/float_note_card_padding_top"
                android:maxLines="1"
                android:minLines="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/note_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/voice_image"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/ic_voice_image"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textAppearance="@style/V12.Float.TextAppearance.List.Secondary"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:id="@+id/float_note_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingMultiplier="1.2"/>
                <com.miui.notes.component.PreviewImageView
                    android:id="@+id/image_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:scaleType="centerCrop"/>
                <com.miui.notes.component.OverviewThumbnailView
                    android:orientation="vertical"
                    android:id="@+id/overview_thumbnail"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
                <com.miui.notes.component.MindThumbnailView
                    android:orientation="vertical"
                    android:id="@+id/mind_thumbnail"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:ellipsize="end"
                    android:id="@+id/voice_note_summary"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/time_info_region"
                android:paddingBottom="12dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="@style/V8.Float.TextAppearance.List.Tertiary"
                    android:ellipsize="end"
                    android:id="@+id/last_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:minLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/stick_icon"
                    android:visibility="gone"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_fw_item_stick"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/save_excerpt"
            android:background="@drawable/float_excerpt_save_background"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_single_excerpt"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="9dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/pc_note_pop_menu_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="200dp">
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/pick_from_pc"
                android:background="@drawable/pc_note_pop_menu_item_head_bg"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/pc_note_edit_insert_picture_from_pc"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <View
                android:background="#20000000"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0.4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:enabled="false"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_my_phone_name"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="我的手机"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/pick_from_phone"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pc_note_edit_insert_picture_from_phone"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/pick_from_camera"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pc_note_edit_take_photo_by_phone"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:enabled="true"
                android:textSize="16dp"
                android:textColor="@color/pc_note_popmenu_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/pick_from_doodle"
                android:background="@drawable/pc_note_pop_menu_item_foot_bg"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/pc_note_edit_insert_doodle_by_phone"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

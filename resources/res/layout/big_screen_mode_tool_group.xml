<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_mode_tool_group"
    android:visibility="gone"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0">
    <View
        android:id="@+id/big_placeholder"
        android:visibility="gone"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/mix_view"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/tool_inner_group"
        android:background="@color/pad_toolbar_mode_bg_color"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/toolbar_container"
            android:saveEnabled="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <RelativeLayout
                android:id="@+id/toolbar_relative_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/notes_edit_toolbar_margin_start_to_group">
                <com.miui.pad.feature.notes.commonedit.PadEditModeToolbar
                    android:orientation="horizontal"
                    android:id="@+id/toolbar"
                    android:focusable="true"
                    android:saveEnabled="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ai"
                        android:saveEnabled="false"
                        android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                        android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                        android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:src="@drawable/icon_ai"
                        android:layout_weight="1"
                        android:contentDescription="@string/ai_text_widget_title"/>
                    <ImageView
                        android:id="@+id/audio"
                        android:saveEnabled="false"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                        android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:src="@drawable/ic_tool_voice"
                        android:layout_weight="1"
                        android:contentDescription="@string/toolbar_voice_description"
                        android:layout_marginStart="@dimen/notes_edit_toolbar_icon_margin_start_big"/>
                    <ImageView
                        android:id="@+id/gallery"
                        android:saveEnabled="false"
                        android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                        android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                        android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:src="@drawable/ic_gallery_n"
                        android:scaleType="center"
                        android:layout_weight="1"
                        android:contentDescription="@string/toolbar_gallery_description"
                        android:layout_marginStart="@dimen/notes_edit_toolbar_icon_margin_start_big"/>
                    <ImageView
                        android:id="@+id/edit_image"
                        android:saveEnabled="false"
                        android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                        android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                        android:layout_marginTop="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:layout_marginBottom="@dimen/notes_edit_toolbar_icon_margin_vertical"
                        android:src="@drawable/ic_doodle_n"
                        android:scaleType="center"
                        android:layout_weight="1"
                        android:contentDescription="@string/doodle_feature"
                        android:layout_marginStart="@dimen/notes_edit_toolbar_icon_margin_start_big"
                        android:layout_marginEnd="@dimen/notes_edit_toolbar_icon_margin_start_big"/>
                </com.miui.pad.feature.notes.commonedit.PadEditModeToolbar>
            </RelativeLayout>
            <ImageView
                android:id="@+id/rich_text_divide"
                android:background="@drawable/ic_toolbar_divider"
                android:visibility="visible"
                android:saveEnabled="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"/>
            <miuix.springback.view.SpringBackLayout
                android:id="@+id/icon_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:scrollOrientation="horizontal"
                app:scrollableView="@+id/scroll_view">
                <HorizontalScrollView
                    android:id="@+id/scroll_view"
                    android:scrollbars="none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.miui.pad.feature.notes.commonedit.PadRichTextIconHorizontalView
                        android:id="@+id/icon_group"
                        android:focusable="true"
                        android:visibility="visible"
                        android:clickable="true"
                        android:saveEnabled="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/bg_highlight"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_hightlight_description"
                            app:iconSingle="@drawable/ic_tool_background_highlight"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/first_level"
                            android:focusable="true"
                            android:clickable="true"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_font_first_level_description"
                            app:iconSingle="@drawable/ic_tool_fontsize_level_first"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/second_level"
                            android:focusable="true"
                            android:clickable="true"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_font_second_level_description"
                            app:iconSingle="@drawable/ic_tool_fontsize_level_second"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/thrid_level"
                            android:focusable="true"
                            android:clickable="true"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_font_third_level_description"
                            app:iconSingle="@drawable/ic_tool_fontsize_level_thrid"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/bold"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_bold_description"
                            app:iconSingle="@drawable/ic_tool_bold"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/italic"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_italic_description"
                            app:iconSingle="@drawable/ic_tool_italic"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/underline"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_underline_description"
                            app:iconSingle="@drawable/ic_tool_underline"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/check"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_tasklist_description"
                            app:iconSingle="@drawable/ic_tool_checkbox"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/strikethrough"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_strikethrough_description"
                            app:iconSingle="@drawable/ic_tool_strikethrough"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/bullet"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_bulleted_list_description"
                            app:iconSingle="@drawable/ic_tool_bullet"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/listbullet"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_orderlist_description"
                            app:iconSingle="@drawable/ic_tool_listbullet"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/split_line"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_split_description"
                            app:iconSingle="@drawable/ic_tool_split_line"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/quote"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_quote_description"
                            app:iconSingle="@drawable/ic_tool_quote"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/left"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_left_description"
                            app:iconSingle="@drawable/ic_tool_left"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/center"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_center_description"
                            app:iconSingle="@drawable/ic_tool_center"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/right"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_right_description"
                            app:iconSingle="@drawable/ic_tool_right"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/indentright"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_indent_right_description"
                            app:iconSingle="@drawable/ic_tool_indent_right"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/indentleft"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_indent_left_description"
                            app:iconSingle="@drawable/ic_tool_indent_left"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/increase_font"
                            android:focusable="true"
                            android:clickable="true"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_font_increase_description"
                            app:iconSingle="@drawable/ic_tool_increase_size"/>
                        <com.miui.pad.feature.notes.commonedit.PadRichTextCheckedTextView
                            android:id="@+id/reduce_font"
                            android:saveEnabled="false"
                            android:layout_width="@dimen/notes_edit_toolbar_icon_size"
                            android:layout_height="@dimen/notes_edit_toolbar_icon_size"
                            android:contentDescription="@string/rich_text_font_decrease_description"
                            app:iconSingle="@drawable/ic_tool_decrease_size"/>
                    </com.miui.pad.feature.notes.commonedit.PadRichTextIconHorizontalView>
                </HorizontalScrollView>
            </miuix.springback.view.SpringBackLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/expand_container"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbar_container"/>
        <View
            android:id="@+id/navi_placeholder"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/expand_container"/>
    </RelativeLayout>
    <View
        android:id="@+id/panel_divide"
        android:background="@color/toolbar_divide_color"
        android:saveEnabled="false"
        android:layout_width="0dp"
        android:layout_height="0.44dp"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_item_group"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="112dp">
    <com.miui.todo.view.SparkFrameLayout
        android:id="@+id/item_content_root"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_content"
            android:background="@drawable/todo_child_item_bg_no_border"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layerType="hardware">
            <View
                android:id="@+id/v_bg"
                android:background="@drawable/todo_child_item_bg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/placeholder"
                android:layout_width="1dp"
                android:layout_height="104dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"/>
            <CheckBox
                android:gravity="start|top"
                android:id="@android:id/checkbox"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/content_group"
                style="@style/Todo.Pc.CheckBox"/>
            <View
                android:id="@+id/checkbox_mask"
                android:layout_width="62dp"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintEnd_toStartOf="@+id/content_group"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="26dp"
                app:layout_constraintBottom_toBottomOf="@+id/placeholder"
                app:layout_constraintEnd_toStartOf="@+id/ll_expand_group"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.miui.common.view.StrikeTextView.StrikeTextView
                    android:textAppearance="@style/Todo.Pc.TextAppearance.List.Secondary"
                    android:textColor="@color/pc_todo_item_content_text_common_color"
                    android:ellipsize="end"
                    android:id="@+id/content"
                    android:paddingTop="1px"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <ImageView
                        android:id="@+id/iv_clock"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/pc_ic_todo_item_clock_n"
                        android:layout_marginEnd="12dp"/>
                    <TextView
                        android:textAppearance="@style/Todo.Pc.TextAppearance.List.Tertiary"
                        android:gravity="start|center_vertical"
                        android:id="@+id/time"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_audio"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/pc_ic_item_audio"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_expand_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/content_group">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/pc_todo_item_list_process_text_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_expand"
                    android:layout_width="@dimen/ic_68px_size"
                    android:layout_height="@dimen/ic_68px_size"
                    android:layout_marginEnd="20dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.miui.todo.view.SparkFrameLayout>
</RelativeLayout>

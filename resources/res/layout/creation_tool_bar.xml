<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/creation_tool_parent"
        android:background="@color/creation_action_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/creation_tools_head_height">
        <ImageView
            android:gravity="start"
            android:id="@+id/creation_tool_iv_back"
            android:layout_width="@dimen/creation_tool_head_icon_size"
            android:layout_height="@dimen/creation_tool_head_icon_size"
            android:layout_marginTop="@dimen/creation_tool_bar_topmargin"
            android:src="@drawable/creation_action_back"
            android:contentDescription="@string/creation_tool_back"
            android:layout_marginStart="@dimen/creation_tool_bar_startendmargin"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <include
                android:id="@+id/creation_tool_panel_container"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/creation_tools_head_height"
                android:layout_marginTop="@dimen/creation_tool_bar_tooltopmargin"
                layout="@layout/creation_panel_container"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/creation_tool_iv_undo"
                android:layout_width="@dimen/creation_tool_head_icon_size"
                android:layout_height="@dimen/creation_tool_head_icon_size"
                android:layout_marginTop="@dimen/creation_tool_bar_topmargin"
                android:src="@drawable/creation_action_undo"
                android:contentDescription="@string/creation_tool_undo"
                android:layout_marginEnd="@dimen/creation_tool_separate_margin_mid"/>
            <ImageView
                android:id="@+id/creation_tool_iv_redo"
                android:layout_width="@dimen/creation_tool_head_icon_size"
                android:layout_height="@dimen/creation_tool_head_icon_size"
                android:layout_marginTop="@dimen/creation_tool_bar_topmargin"
                android:src="@drawable/creation_action_redo"
                android:contentDescription="@string/creation_tool_redo"
                android:layout_marginEnd="@dimen/creation_tool_separate_margin_mid"/>
            <TextView
                android:gravity="center"
                android:id="@+id/text_thumbnail"
                android:visibility="gone"
                android:layout_width="@dimen/creation_tool_head_icon_size"
                android:layout_height="@dimen/creation_tool_head_icon_size"
                android:layout_marginTop="@dimen/creation_tool_bar_topmargin"
                android:text="缩略图"
                android:layout_marginEnd="@dimen/creation_tool_separate_margin_mid"/>
            <ImageView
                android:id="@+id/creation_tool_iv_share"
                android:visibility="gone"
                android:layout_width="@dimen/creation_tool_head_icon_size"
                android:layout_height="@dimen/creation_tool_head_icon_size"
                android:layout_marginTop="@dimen/creation_tool_bar_topmargin"
                android:src="@drawable/creation_action_share"
                android:contentDescription="@string/creation_tool_export"
                android:layout_marginEnd="@dimen/creation_tool_separate_margin_mid"/>
            <ImageView
                android:id="@+id/creation_tool_iv_more"
                android:layout_width="@dimen/creation_tool_head_icon_size"
                android:layout_height="@dimen/creation_tool_head_icon_size"
                android:layout_marginTop="@dimen/creation_tool_bar_topmargin"
                android:src="@drawable/creation_action_more"
                android:contentDescription="@string/creation_tool_more"
                android:layout_marginEnd="@dimen/creation_tool_separate_margin_end"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

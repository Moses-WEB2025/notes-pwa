<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?android:attr/homeAsUpIndicator"
        android:layout_alignTop="@+id/search_container"
        android:layout_alignBottom="@+id/search_container"
        android:contentDescription="@string/miuix_search_back_button_description"
        android:layout_marginStart="@dimen/miuix_search_back_button_margin_start"
        android:layout_marginEnd="@dimen/miuix_search_back_button_margin_end"
        android:layout_alignParentStart="true"
        android:forceDarkAllowed="false"/>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/miuix_search_cancel_button_size"
        android:textColor="?attr/searchEndViewTextColor"
        android:gravity="center"
        android:id="@+id/endView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/miuix_search_end_view_text_search"
        android:layout_alignTop="@+id/search_container"
        android:layout_alignBottom="@+id/search_container"
        android:fontFamily="sans-serif-medium"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/miuix_search_cancel_button_margin_start"
        android:layout_marginEnd="@dimen/miuix_search_cancel_button_margin_end"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/miuix_search_cancel_button_padding_horizontal"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/search_container"
        android:background="?attr/searchInputBg"
        android:paddingTop="@dimen/miuix_search_edit_text_padding_vertical"
        android:paddingBottom="@dimen/miuix_search_edit_text_padding_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/miuix_search_cancel_padding_top"
        android:layout_marginBottom="@dimen/miuix_search_cancel_padding_bottom"
        android:paddingStart="@dimen/miuix_search_input_bg_padding_horizontal_start"
        android:paddingEnd="@dimen/miuix_search_input_bg_padding_horizontal_end"
        android:layout_marginEnd="@dimen/miuix_search_view_padding_horizontal"
        android:layout_toStartOf="@+id/endView"
        android:layout_toEndOf="@+id/back">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon"
            android:layout_width="@dimen/miuix_search_container_input_icon_layout"
            android:layout_height="@dimen/miuix_search_container_input_icon_layout"
            android:src="?attr/searchEditTextIcon"
            android:alpha="0.3"
            android:transitionName="transition_search_icon"/>
        <miuix.androidbasewidget.widget.ClearableEditText
            android:textSize="@dimen/miuix_search_edit_text_size"
            android:textColor="?attr/searchInputTextColor"
            android:textColorHint="?attr/searchInputHintColor"
            android:gravity="center_vertical"
            android:id="@android:id/input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="?attr/searchInputHint"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="?attr/searchEditTextCursorDrawable"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/miuix_search_input_margin_start"
            app:drawableEndCompat="?attr/clearableEditTextIcon"
            style="@style/MiuixSearch.EditText.Clearable"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/search_container"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_pad"
    android:background="@drawable/pc_note_blankview_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/blank_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/pc_note_edit_blank_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sv_note_edit"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <include
            android:id="@+id/header"
            layout="@layout/pc_note_edit_header"/>
        <include
            android:id="@+id/reminder"
            android:visibility="gone"
            layout="@layout/pc_note_edit_trash_reminder"/>
        <com.miui.pc.view.PadEditRootLayout
            android:id="@+id/editor_container"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">
            <miuix.nestedheader.widget.NestedHeaderLayout
                android:id="@+id/nested_header_layout"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scrollableView="@+id/sbl_editor"
                app:triggerView="@+id/trigger_view">
                <View
                    android:id="@+id/trigger_view"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"/>
                <miuix.springback.view.SpringBackLayout
                    android:id="@+id/sbl_editor"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scrollOrientation="vertical"
                    app:scrollableView="@+id/editor_scroll_view">
                    <view
                        android:scrollbarStyle="insideOverlay"
                        android:gravity="center_horizontal"
                        android:id="@+id/editor_scroll_view"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:isScrollContainer="true"
                        class="com.miui.richeditor.RichEditScrollView">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/edit_content"
                            android:paddingBottom="20dp"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/ll_note_edit"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/edit_head"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:minHeight="36dp">
                                    <EditText
                                        android:textSize="24dp"
                                        android:textStyle="bold"
                                        android:textColorHint="@color/note_title_hint_color_default"
                                        android:id="@+id/note_title"
                                        android:background="@null"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:inputType="textImeMultiLine"
                                        android:textAlignment="textStart"
                                        android:paddingStart="@dimen/pc_note_editor_padding"
                                        android:paddingEnd="@dimen/pc_note_editor_padding"/>
                                    <include
                                        android:visibility="gone"
                                        layout="@layout/pc_note_edit_title_action_bar"/>
                                </LinearLayout>
                                <view
                                    android:theme="@style/NoteTheme.Light.PcEdit"
                                    android:textAppearance="@style/TextAppearance.Editor"
                                    android:textSize="16dp"
                                    android:textColorLink="@color/link_text"
                                    android:gravity="start|top"
                                    android:autoLink="all"
                                    android:linksClickable="false"
                                    android:id="@+id/rich_editor"
                                    android:background="@null"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="@dimen/note_edit_content_min_height"
                                    android:singleLine="false"
                                    android:inputType="textImeMultiLine"
                                    android:imeOptions="flagNoFullscreen|actionDone"
                                    android:textAlignment="textStart"
                                    android:paddingStart="@dimen/pc_note_editor_padding"
                                    android:paddingEnd="@dimen/pc_note_editor_padding"
                                    class="com.miui.pc.richeditor.PcNoteRichEditor"/>
                            </LinearLayout>
                        </LinearLayout>
                    </view>
                </miuix.springback.view.SpringBackLayout>
            </miuix.nestedheader.widget.NestedHeaderLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/rich_editor_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/loading_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textColor="@color/edit_fragment_loading_color"
                    android:id="@+id/progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading_text"
                    android:layout_below="@+id/progress_bar"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </com.miui.pc.view.PadEditRootLayout>
    </LinearLayout>
</FrameLayout>

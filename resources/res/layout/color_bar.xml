<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/menu_popup_color_bar_padding_horizontal"
    android:paddingRight="@dimen/menu_popup_color_bar_padding_horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/menu_theme_color_bar_height">
    <FrameLayout
        android:id="@+id/pick_white"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/theme_white_description">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/ic_header_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/v8_ic_indicator_white"
            android:layout_width="@dimen/menu_popup_color_bar_radius"
            android:layout_height="@dimen/menu_popup_color_bar_radius"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/pick_yellow"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/theme_yellow_description">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/ic_header_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/v8_ic_indicator_yellow"
            android:layout_width="@dimen/menu_popup_color_bar_radius"
            android:layout_height="@dimen/menu_popup_color_bar_radius"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/pick_blue"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/theme_blue_description">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/ic_header_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/v8_ic_indicator_blue"
            android:layout_width="@dimen/menu_popup_color_bar_radius"
            android:layout_height="@dimen/menu_popup_color_bar_radius"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/pick_green"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/theme_green_description">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/ic_header_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/v8_ic_indicator_green"
            android:layout_width="@dimen/menu_popup_color_bar_radius"
            android:layout_height="@dimen/menu_popup_color_bar_radius"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/pick_red"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/theme_red_description">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/ic_header_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/v8_ic_indicator_red"
            android:layout_width="@dimen/menu_popup_color_bar_radius"
            android:layout_height="@dimen/menu_popup_color_bar_radius"/>
    </FrameLayout>
</LinearLayout>

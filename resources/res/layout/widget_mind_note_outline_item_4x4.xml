<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/widget_mind_note_item_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_mind_note_item_height_4x4">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_mind_note_outline_item_line_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/widget_mind_note_outline_item_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/widget_mind_note_item_icon_margin_end"/>
    <TextView
        android:textSize="@dimen/v13_widget4x_text_size"
        android:textColor="@color/widget_note_text_color"
        android:ellipsize="end"
        android:id="@+id/widget_mind_note_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/float_note_card_width"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/card_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/note_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/float_note_card_padding_horizontal"
            android:paddingEnd="@dimen/float_note_card_padding_horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                android:textAppearance="@style/V12.TextAppearance.List.Primary"
                android:id="@+id/float_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/float_note_card_padding_top"
                android:maxLines="1"
                android:minLines="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/note_content"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/float_note_title">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textAppearance="@style/V12.Float.TextAppearance.List.Secondary"
                    android:ellipsize="end"
                    android:id="@+id/float_note_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:minLines="3"
                    android:lineSpacingMultiplier="@dimen/float_text_preview_line_spacing_multiplier"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/time_info_region"
                android:paddingBottom="16dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/note_content"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textAppearance="@style/V8.Float.TextAppearance.List.Tertiary"
                    android:ellipsize="end"
                    android:id="@+id/last_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:minLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/stick_icon"
                    android:visibility="gone"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_data_item_stick"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/save_excerpt"
            android:background="@drawable/float_excerpt_save_background"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_single_excerpt"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>

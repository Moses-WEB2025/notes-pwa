<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:background="?attr/preferenceItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Preference.PreferenceScreen">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_1"
            android:layout_width="@dimen/setting_layout_demo_ic_width"
            android:layout_height="@dimen/setting_layout_demo_ic_height"
            android:layout_marginEnd="@dimen/setting_layout_demo_ic_space"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toStartOf="@+id/img_2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Secondary.Preference"
            android:gravity="center"
            android:id="@+id/img_info_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="10"
            android:layout_alignStart="@android:id/title"
            app:layout_constraintEnd_toEndOf="@+id/img_1"
            app:layout_constraintStart_toStartOf="@+id/img_1"
            app:layout_constraintTop_toBottomOf="@+id/img_1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_2"
            android:layout_width="@dimen/setting_layout_demo_ic_width"
            android:layout_height="@dimen/setting_layout_demo_ic_height"
            android:layout_marginStart="@dimen/setting_layout_demo_ic_space"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_1"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Secondary.Preference"
            android:gravity="center"
            android:id="@+id/img_info_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="10"
            android:layout_alignStart="@android:id/title"
            app:layout_constraintEnd_toEndOf="@+id/img_2"
            app:layout_constraintStart_toStartOf="@+id/img_2"
            app:layout_constraintTop_toBottomOf="@+id/img_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/global_ai_text_panel_popup_item_text_size"
        android:textColor="@color/global_ai_panel_style_text"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/global_panel_popup_text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/global_ai_text_panel_tag_popup_item_height"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/global_ai_text_panel_tag_popup_item_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

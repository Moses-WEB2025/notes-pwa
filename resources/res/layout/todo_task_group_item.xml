<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_item_group"
    android:paddingTop="@dimen/todo_item_group_padding_top"
    android:paddingBottom="@dimen/todo_item_group_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/miuix_theme_margin_horizontal_common"
    android:paddingStart="@dimen/todo_item_group_padding_start">
    <ImageView
        android:id="@+id/iv_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_todo_switch_for_group"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/list_section_title_size"
        android:textColor="@color/list_header_text"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/iv_switch"/>
</RelativeLayout>

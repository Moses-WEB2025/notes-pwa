<?xml version="1.0" encoding="utf-8"?>
<com.miui.support.cardview.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/folder"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="185dp"
    android:layout_marginStart="13dp"
    app:cardBackgroundColor="@color/dialog_chooser_item_bg"
    app:cardCornerRadius="@dimen/v12_grid_item_shape_radius"
    app:cardElevation="11dp">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/v12_choice_folder_margin_top_1"
            android:layout_marginStart="@dimen/v12_choice_folder_margin_start">
            <include
                android:layout_gravity="bottom"
                android:visibility="invisible"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                layout="@layout/folder_chooser_note_sample_group"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/folder_img"
                android:visibility="visible"
                android:layout_width="38.18dp"
                android:layout_height="44.72dp"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/folder_chooser_item_title_size"
            android:textColor="@color/v8_text_appearance_list_primary_text_color"
            android:ellipsize="end"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/v12_choice_folder_margin_top_2"
            android:singleLine="true"
            android:layout_marginStart="@dimen/v12_choice_folder_margin_start"
            android:layout_marginEnd="@dimen/v12_choice_folder_margin_start"/>
        <TextView
            android:textSize="@dimen/folder_chooser_item_count_size"
            android:textColor="@color/v8_text_appearance_list_secondary_text_color"
            android:ellipsize="end"
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/v12_choice_folder_margin_top_3"
            android:singleLine="true"
            android:layout_marginStart="@dimen/v12_choice_folder_margin_start"/>
    </LinearLayout>
</com.miui.support.cardview.CardView>

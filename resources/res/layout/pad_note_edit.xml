<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.miuixbasewidget.widget.EmptyStateView
        android:layout_gravity="center"
        android:id="@+id/pad_edit_blank_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="41dp"
        android:alpha="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sv_note_edit"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/editor_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <miuix.nestedheader.widget.NestedHeaderLayout
                android:id="@+id/nested_header_layout"
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scrollableView="@+id/sbl_editor"
                app:triggerView="@+id/note_folder_info">
                <include
                    android:id="@+id/note_folder_info"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/note_dir_indicator_bg_height"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="@dimen/notes_edit_header_margin_bottom"
                    android:layout_marginStart="@dimen/pad_note_edit_web_mind_content_horizontal_padding"
                    android:layout_marginEnd="@dimen/pad_note_edit_web_mind_content_horizontal_padding"
                    layout="@layout/note_edit_folder_layout"/>
                <miuix.springback.view.SpringBackLayout
                    android:id="@+id/sbl_editor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scrollOrientation="vertical"
                    app:scrollableView="@+id/editor_scroll_view">
                    <view
                        android:scrollbarStyle="insideOverlay"
                        android:gravity="center_horizontal"
                        android:id="@+id/editor_scroll_view"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:isScrollContainer="true"
                        class="com.miui.pad.richeditor.PadRichEditScrollView">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/edit_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:id="@+id/ll_note_edit"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <EditText
                                        android:textSize="@dimen/note_edit_title_font_size"
                                        android:textColor="@color/editor_text"
                                        android:textColorHint="@color/note_title_hint_color_default"
                                        android:gravity="start|center_vertical"
                                        android:id="@+id/note_title"
                                        android:background="@null"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:minHeight="@dimen/note_edit_title_height"
                                        android:inputType="textImeMultiLine"
                                        android:textAlignment="textStart"
                                        android:paddingStart="@dimen/pad_note_editor_padding"
                                        android:paddingEnd="@dimen/pad_note_editor_padding"/>
                                    <include
                                        android:id="@+id/note_extra_info"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:layout_marginBottom="28dp"
                                        android:paddingStart="@dimen/note_editor_padding"
                                        android:paddingEnd="@dimen/note_editor_padding"
                                        layout="@layout/note_extra_info_layout"/>
                                    <view
                                        android:textAppearance="@style/TextAppearance.Editor"
                                        android:gravity="start|top"
                                        android:autoLink="all"
                                        android:linksClickable="false"
                                        android:id="@+id/rich_editor"
                                        android:background="@null"
                                        android:paddingBottom="@dimen/pad_note_edit_content_padding_bottom"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:minHeight="@dimen/note_edit_content_min_height"
                                        android:singleLine="false"
                                        android:inputType="textImeMultiLine"
                                        android:imeOptions="flagNoFullscreen|actionDone"
                                        android:textAlignment="textStart"
                                        android:paddingStart="@dimen/pad_note_editor_padding"
                                        android:paddingEnd="@dimen/pad_note_editor_padding"
                                        class="com.miui.pad.richeditor.PadNoteRichEditor"/>
                                </LinearLayout>
                                <TextView
                                    android:id="@+id/guide_view_hover"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </FrameLayout>
                        </LinearLayout>
                    </view>
                </miuix.springback.view.SpringBackLayout>
            </miuix.nestedheader.widget.NestedHeaderLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/rich_editor_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/loading_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textColor="@color/edit_fragment_loading_color"
                    android:id="@+id/progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading_text"
                    android:layout_below="@+id/progress_bar"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </FrameLayout>
        <TextView
            android:textAppearance="@style/TextAppearance.Editor.Info"
            android:gravity="center"
            android:id="@+id/edit_info"
            android:background="@drawable/edit_info_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_unsupport_content"
            android:layout_marginStart="@dimen/note_edit_default_horizontal_padding"
            android:layout_marginEnd="@dimen/note_edit_default_horizontal_padding"/>
    </LinearLayout>
</FrameLayout>

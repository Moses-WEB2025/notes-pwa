<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:orientation="vertical"
    android:id="@+id/editor_container"
    android:addStatesFromChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <com.miui.todo.feature.todoedit.TodoEditTitleContainerView
        android:id="@+id/todo_editor_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/normal_todo_check_group"
            android:visibility="gone"
            android:layout_width="@dimen/pad_sub_todo_checkbox_group_size"
            android:layout_height="39dp"
            android:layout_alignTop="@+id/editor_scroll_view"
            android:layout_alignBottom="@+id/editor_scroll_view"
            android:importantForAccessibility="no"
            android:layout_alignParentStart="true">
            <CheckBox
                android:theme="@style/NoteTheme.List"
                android:id="@+id/cb_subtodo"
                android:clickable="false"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                style="@style/Todo.Pad.EditCheckBox"/>
        </RelativeLayout>
        <view
            android:theme="@style/NoteTheme.TodoEdit"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/editor_scroll_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@+id/normal_todo_check_group"
            class="com.miui.richeditor.RichEditScrollView">
            <view
                android:textSize="@dimen/pad_todo_edit_text_size"
                android:textColor="@color/todo_item_content_text_common_color"
                android:textColorHint="@color/hint_todo_edit_text_color"
                android:gravity="top"
                android:autoLink="all"
                android:linksClickable="false"
                android:id="@+id/rich_editor"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:inputType="textImeMultiLine"
                android:imeOptions="flagNoFullscreen|actionDone"
                android:textCursorDrawable="@drawable/todo_editor_cursor"
                class="com.miui.todo.feature.todoedit.TodoRichEditor"/>
        </view>
    </com.miui.todo.feature.todoedit.TodoEditTitleContainerView>
    <com.miui.pad.feature.todo.edit.TodoEditSpringLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/pad_todo_edit_subtodo_panel_margin_top"
        android:layout_weight="1"
        app:scrollOrientation="vertical"
        app:scrollableView="@+id/rv_subtodo">
        <com.miui.pad.feature.todo.edit.PadSubTodoEditRecyclerView
            android:id="@+id/rv_subtodo"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.miui.pad.feature.todo.edit.TodoEditSpringLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miui.support.cardview.CardView
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="9dp"
        app:cardElevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/pc_note_pop_menu_bg"
            android:layout_width="120dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15.6sp"
                android:textColor="@color/pc_note_edit_textsize_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/set_alarm"
                android:background="@drawable/pc_note_pop_menu_item_head_bg"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="@string/alarm_bar_title"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <TextView
                android:textSize="15.6sp"
                android:textColor="@color/pc_note_edit_textsize_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/move_to"
                android:background="@drawable/pc_note_pop_menu_item_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/menu_move_to"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <TextView
                android:textSize="15.6sp"
                android:textColor="@color/pc_note_edit_textsize_item_text_color"
                android:gravity="start|center_vertical"
                android:id="@+id/delete"
                android:background="@drawable/pc_note_pop_menu_item_foot_bg"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="@string/menu_delete"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </com.miui.support.cardview.CardView>
</FrameLayout>

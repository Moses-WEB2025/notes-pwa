<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@color/widget_note_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/content_add"
        android:background="@drawable/ic_content_add_background"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_widget_content_add"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:contentDescription="@string/app_widget_name_create_note"
        android:layout_marginStart="8dp"/>
    <ImageView
        android:id="@+id/open_note_home"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_widget_note_home"
        android:layout_centerInParent="true"
        android:contentDescription="@string/widget_all_notes_name"/>
    <ImageView
        android:id="@+id/open_todo_home"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_widget_todo_home"
        android:layout_centerVertical="true"
        android:contentDescription="@string/widget_all_todo_name"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/normal_item_group"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:paddingStart="@dimen/miuix_theme_margin_horizontal_common"
    android:paddingEnd="@dimen/miuix_theme_margin_horizontal_common">
    <com.miui.common.view.RoundClipLayout
        android:id="@+id/clip_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:radius="@dimen/pad_common_radius">
        <com.miui.todo.view.swipemenulayout.SwipeMenuLayout
            android:id="@+id/sl_item_group"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentViewId="@+id/item_content_root"
            app:defaultRadius="@dimen/pad_common_radius"
            app:rightViewId="@+id/right_view">
            <LinearLayout
                android:id="@+id/left_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/pad_todo_right_list_item_margin_start"
                android:layout_marginEnd="@dimen/pad_todo_right_list_item_margin_end">
                <TextView
                    android:textColor="#ffffff"
                    android:gravity="end|center_vertical"
                    android:id="@+id/left_menu"
                    android:background="@color/todo_item_menu_unfinish_color"
                    android:visibility="gone"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:text="@string/todo_item_status_unfinished"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/right_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/todo_item_right_menu_padding"
                android:layout_marginStart="@dimen/todo_item_margin_start">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/right_menu"
                    android:background="@drawable/v12_todo_item_menu_delete_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/miuix_action_icon_delete_dark"
                    android:scaleType="center"
                    android:contentDescription="@string/menu_delete"/>
            </LinearLayout>
            <com.miui.todo.view.SparkFrameLayout
                android:id="@+id/item_content_root"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/pad_todo_item_normal_content_layout"/>
            </com.miui.todo.view.SparkFrameLayout>
        </com.miui.todo.view.swipemenulayout.SwipeMenuLayout>
    </com.miui.common.view.RoundClipLayout>
</RelativeLayout>

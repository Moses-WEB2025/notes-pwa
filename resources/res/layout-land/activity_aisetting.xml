<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollOrientation="angle|vertical"
    app:scrollableView="@+id/settings_nested_scroll_view">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/settings_nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/creation_ai_art_setting"
            android:background="@color/page_bg"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/upload_item"
                android:background="@drawable/upload_item_background"
                android:paddingTop="@dimen/ai_text_settings_item_padding_top"
                android:paddingBottom="@dimen/ai_text_settings_item_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ai_text_settings_item_margin_bottom"
                android:paddingStart="@dimen/ai_text_settings_item_padding_start"
                android:paddingEnd="@dimen/ai_text_settings_item_padding_end"
                android:layout_marginStart="@dimen/ai_text_settings_item_margin_start_land"
                android:layout_marginEnd="@dimen/ai_text_settings_item_margin_start_land">
                <TextView
                    android:textSize="@dimen/ai_text_settings_title_textsize"
                    android:textColor="@color/item_title"
                    android:id="@+id/upload_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_title"/>
                <TextView
                    android:textSize="@dimen/ai_text_settings_summary_textsize"
                    android:textColor="@color/item_text"
                    android:id="@+id/upload_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_writing_local_message"
                    android:layout_below="@+id/upload_title"/>
                <miuix.slidingwidget.widget.SlidingButton
                    android:id="@+id/upload_onoff"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/content_item"
                android:background="@drawable/upload_item_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ai_text_settings_item_padding_start"
                android:paddingEnd="@dimen/ai_text_settings_item_padding_end"
                android:layout_marginStart="@dimen/ai_text_settings_item_margin_start_land"
                android:layout_marginEnd="@dimen/ai_text_settings_item_margin_start_land">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/icon"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ai_text_settings_imageview_heigth_land"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/pad_land_settings_icon"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/line"
                            android:background="@color/ai_enhanced_setting_line"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ai_text_settings_line_height"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/ai_text_settings_item_padding_bottom">
                        <TextView
                            android:textSize="@dimen/ai_text_settings_subtitle_textsize"
                            android:textStyle="bold"
                            android:textColor="@color/item_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_text_widget_title"
                            android:fontFamily="@string/miuix_font_style_misans_medium_font_family"/>
                        <TextView
                            android:textSize="@dimen/ai_text_settings_summary_textsize"
                            android:textColor="@color/item_text"
                            android:id="@+id/content_introduction_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textDirection="locale"
                            android:lineHeight="@dimen/ai_text_settings_summary_line_height"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/ai_text_settings_item_padding_bottom">
                        <TextView
                            android:textSize="@dimen/ai_text_settings_subtitle_textsize"
                            android:textStyle="bold"
                            android:textColor="@color/item_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_usage_text_title"
                            android:fontFamily="@string/miuix_font_style_misans_medium_font_family"/>
                        <TextView
                            android:textSize="@dimen/ai_text_settings_summary_textsize"
                            android:textColor="@color/item_text"
                            android:id="@+id/ai_usage_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/miuix_font_style_misans_regular_font_family"
                            android:textDirection="locale"
                            android:lineHeight="@dimen/ai_text_settings_summary_line_height"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <miuix.appcompat.widget.Button
                android:layout_gravity="center_horizontal"
                android:id="@+id/ai_experience"
                android:layout_width="@dimen/ai_experience_button_width"
                android:layout_height="wrap_content"
                android:text="@string/ai_experience_text"
                style="@style/Widget.Button.Primary"/>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
